// kernel/kalloc.fd — Kernel memory management
// Page-frame allocator with bitmap + heap allocator with free list.

module kalloc;

pub const HEAP_START: i64 = 0x300000;
pub const HEAP_END:   i64 = 0x400000;  // 1MB heap
pub const HEAP_BITMAP: i64 = 0x310000;
pub const HEAP_MAX_PAGES: i64 = 256;  // 256 pages × 4KB = 1MB heap
pub const PAGE_SIZE: i64 = 4096;

pub var heap_next: i64 = 0x300000;
pub var heap_free_list: i64 = 0;  // head of free list (0 = empty)

// Initialize the heap
pub fn heap_init() {
    heap_next = HEAP_START;
    heap_free_list = 0;
}

// Allocate a 4KB-aligned page. Returns physical address or 0 if out of memory.
pub fn page_alloc() -> i64 {
    var i: i64 = 0;
    while i < HEAP_MAX_PAGES {
        if p_mem_read8(HEAP_BITMAP + i) == 0 {
            p_mem_write8(HEAP_BITMAP + i, 1);  // mark allocated
            return HEAP_START + i * PAGE_SIZE;
        }
        i = i + 1;
    }
    return 0;  // out of memory
}

// Free a previously allocated page.
pub fn page_free(addr: i64) -> void {
    if addr < HEAP_START { return; }
    var idx: i64 = (addr - HEAP_START) / PAGE_SIZE;
    if idx >= HEAP_MAX_PAGES { return; }
    p_mem_write8(HEAP_BITMAP + idx, 0);  // mark free
}

// Allocate `size` bytes, rounded up to a page. Returns address or 0.
pub fn kmalloc(size: i64) -> i64 {
    if size <= 0 { return 0; }
    return page_alloc();  // simple: one page per allocation
}

// Free a previously allocated block.
pub fn kfree(addr: i64) -> void {
    page_free(addr);
}

// ─── Heap with Free List ────────────────────────────────────────────────
// Each allocation: [size:8][data...]
// Free list: singly linked, address stored in first 8 bytes of freed block.

pub fn heap_alloc(size: i64) -> i64 {
    // Try free list first (first-fit)
    var prev: i64 = 0;
    var cur: i64 = heap_free_list;
    while cur != 0 {
        var block_size: i64 = p_mem_read64(cur);  // size includes header
        if block_size >= size + 8 {
            // Found a fit — remove from free list
            var next_free: i64 = p_mem_read64(cur + 8);
            if prev == 0 {
                heap_free_list = next_free;
            } else {
                p_mem_write64(prev + 8, next_free);
            }
            return cur + 8;  // return data pointer (past size header)
        }
        prev = cur;
        cur = p_mem_read64(cur + 8);
    }
    // Bump allocate
    if heap_next + size + 8 > HEAP_END { return 0; }
    p_mem_write64(heap_next, size + 8);  // store block size
    var ptr: i64 = heap_next + 8;
    heap_next = heap_next + size + 8;
    // Align to 8 bytes
    while heap_next % 8 != 0 { heap_next = heap_next + 1; }
    return ptr;
}

pub fn heap_free(ptr: i64) {
    if ptr == 0 { return; }
    var block_start: i64 = ptr - 8;
    // Add to free list head
    p_mem_write64(block_start + 8, heap_free_list);
    heap_free_list = block_start;
}

// ─── Buddy Page-Frame Allocator ──────────────────────────────────────────
// Manages a contiguous physical region with power-of-two block sizes.
// Free lists per order: order 0 = 1 page (4KB), order 1 = 2 pages, ... order 10 = 1024 pages.
// Bitmap at 0x1F0000 tracks allocated state; free-list heads at 0x1F2000.
// Managed region: 0x400000 .. 0x800000 (4MB = 1024 pages), max order 10.
//
// This is distinct from the simple bitmap page_alloc above: the buddy
// allocator splits/coalesces blocks to reduce external fragmentation and
// tracks free pages by order for O(1) allocation of large regions.

pub const BUDDY_BITMAP: i64 = 0x1F0000;       // 1024 bits = 128 bytes
pub const BUDDY_FREE_LISTS: i64 = 0x1F2000;   // 11 orders × 8 bytes (head index, -1 = empty)
pub const BUDDY_NEXT: i64 = 0x1F2100;        // 1024 × 4 bytes: next index in free list
pub const BUDDY_BASE: i64 = 0x400000;        // managed physical base
pub const BUDDY_PAGES: i64 = 1024;           // 1024 pages = 4MB
pub const BUDDY_MAX_ORDER: i64 = 10;         // 2^10 = 1024 pages
pub var buddy_initialized: i64 = 0;

// Initialize the buddy allocator: mark all pages free, put the whole region
// as one max-order block in the top free list.
pub fn buddy_init() -> void {
    var i: i64 = 0;
    while i < 128 {
        p_mem_write8(BUDDY_BITMAP + i, 0);
        i = i + 1;
    }
    i = 0;
    while i <= BUDDY_MAX_ORDER {
        p_mem_write64(BUDDY_FREE_LISTS + i * 8, -1);
        i = i + 1;
    }
    i = 0;
    while i < BUDDY_PAGES {
        p_mem_write32(BUDDY_NEXT + i * 4, -1);
        i = i + 1;
    }
    // Whole region is one free block of order MAX_ORDER at index 0
    p_mem_write64(BUDDY_FREE_LISTS + BUDDY_MAX_ORDER * 8, 0);
    p_mem_write32(BUDDY_NEXT, -1);
    buddy_initialized = 1;
}

// Mark a page index as allocated in the bitmap
fn buddy_set_alloc(index: i64) -> void {
    var byte: i64 = index / 8;
    var bit: i64 = index % 8;
    var v: i64 = p_mem_read8(BUDDY_BITMAP + byte);
    p_mem_write8(BUDDY_BITMAP + byte, v | (1 << bit));
}

// Mark a page index as free in the bitmap
fn buddy_set_free(index: i64) -> void {
    var byte: i64 = index / 8;
    var bit: i64 = index % 8;
    var v: i64 = p_mem_read8(BUDDY_BITMAP + byte);
    p_mem_write8(BUDDY_BITMAP + byte, v & (~(1 << bit)));
}

fn buddy_is_alloc(index: i64) -> i64 {
    var byte: i64 = index / 8;
    var bit: i64 = index % 8;
    var v: i64 = p_mem_read8(BUDDY_BITMAP + byte);
    return (v >> bit) & 1;
}

// Remove a block index from a given order's free list
fn buddy_list_remove(order: i64, index: i64) -> void {
    var head: i64 = p_mem_read64(BUDDY_FREE_LISTS + order * 8);
    if head == index {
        p_mem_write64(BUDDY_FREE_LISTS + order * 8, p_mem_read32(BUDDY_NEXT + index * 4));
        return;
    }
    var cur: i64 = head;
    while cur != -1 {
        var nxt: i64 = p_mem_read32(BUDDY_NEXT + cur * 4);
        if nxt == index {
            p_mem_write32(BUDDY_NEXT + cur * 4, p_mem_read32(BUDDY_NEXT + index * 4));
            return;
        }
        cur = nxt;
    }
}

// Push a block index onto a given order's free list
fn buddy_list_push(order: i64, index: i64) -> void {
    var head: i64 = p_mem_read64(BUDDY_FREE_LISTS + order * 8);
    p_mem_write32(BUDDY_NEXT + index * 4, head);
    p_mem_write64(BUDDY_FREE_LISTS + order * 8, index);
}

// Find the smallest order that fits `pages` pages
fn buddy_order_for(pages: i64) -> i64 {
    var order: i64 = 0;
    var sz: i64 = 1;
    while sz < pages && order < BUDDY_MAX_ORDER {
        sz = sz * 2;
        order = order + 1;
    }
    return order;
}

// Allocate `pages` contiguous pages. Returns physical address or 0 on failure.
pub fn buddy_alloc(pages: i64) -> i64 {
    if buddy_initialized == 0 { buddy_init(); }
    if pages <= 0 || pages > BUDDY_PAGES { return 0; }
    var order: i64 = buddy_order_for(pages);
    // Find first non-empty free list at >= order
    var o: i64 = order;
    while o <= BUDDY_MAX_ORDER {
        if p_mem_read64(BUDDY_FREE_LISTS + o * 8) != -1 { break; }
        o = o + 1;
    }
    if o > BUDDY_MAX_ORDER { return 0; }  // no block large enough
    // Pop the head block from order o
    var index: i64 = p_mem_read64(BUDDY_FREE_LISTS + o * 8);
    buddy_list_remove(o, index);
    // Split down to the requested order
    while o > order {
        o = o - 1;
        var buddy_index: i64 = index + (1 << o);
        buddy_list_push(o, buddy_index);
    }
    // Mark all pages in the allocated block
    var count: i64 = 1 << order;
    var k: i64 = 0;
    while k < count {
        buddy_set_alloc(index + k);
        k = k + 1;
    }
    return BUDDY_BASE + index * PAGE_SIZE;
}

// Free a block previously allocated with buddy_alloc, given the starting
// physical address and the number of pages it spans.
pub fn buddy_free(addr: i64, pages: i64) -> void {
    if buddy_initialized == 0 { return; }
    if addr < BUDDY_BASE { return; }
    var index: i64 = (addr - BUDDY_BASE) / PAGE_SIZE;
    if index < 0 || index >= BUDDY_PAGES { return; }
    var order: i64 = buddy_order_for(pages);
    var count: i64 = 1 << order;
    var k: i64 = 0;
    while k < count {
        buddy_set_free(index + k);
        k = k + 1;
    }
    // Coalesce with buddies while possible
    var o: i64 = order;
    while o < BUDDY_MAX_ORDER {
        var buddy: i64 = index ^ (1 << o);
        // Check buddy is within range, free, and same order (not already merged)
        if buddy < 0 || buddy >= BUDDY_PAGES { break; }
        var buddy_free: i64 = 1;
        var b: i64 = 0;
        while b < (1 << o) {
            if buddy_is_alloc(buddy + b) != 0 { buddy_free = 0; b = 1 << o; }
            b = b + 1;
        }
        if buddy_free == 0 { break; }
        // Remove buddy from its free list, merge
        buddy_list_remove(o, buddy);
        if buddy < index { index = buddy; }
        o = o + 1;
    }
    buddy_list_push(o, index);
}

// Count free pages across all orders
pub fn buddy_free_pages() -> i64 {
    var total: i64 = 0;
    var o: i64 = 0;
    while o <= BUDDY_MAX_ORDER {
        var cur: i64 = p_mem_read64(BUDDY_FREE_LISTS + o * 8);
        while cur != -1 {
            total = total + (1 << o);
            cur = p_mem_read32(BUDDY_NEXT + cur * 4);
        }
        o = o + 1;
    }
    return total;
}

// ─── Slab Allocator ─────────────────────────────────────────────────────
// For small kernel objects (16/32/64/128 bytes). Each size class has a free
// list of pre-allocated slots. Metadata at 0x1E0000, slots carved from the
// buddy-managed region on demand.
//
// Slab cache layout (per size class, 16 bytes of metadata):
//   [slot_size:8][free_head:8]
// Free slots form a singly-linked list; the first 8 bytes of a free slot hold
// the next free slot's address (0 = end).

pub const SLAB_META: i64 = 0x1E0000;       // 4 classes × 16 bytes
pub const SLAB_ARENA: i64 = 0x1E0100;      // 64KB arena for slab slots
pub const SLAB_ARENA_END: i64 = 0x1EFFFF;
pub const SLAB_CLASSES: i64 = 4;
pub var slab_arena_next: i64 = 0x1E0100;

pub fn slab_init() -> void {
    var i: i64 = 0;
    var sz: i64 = 16;
    while i < SLAB_CLASSES {
        p_mem_write64(SLAB_META + i * 16, sz);
        p_mem_write64(SLAB_META + i * 16 + 8, 0);  // free head = 0
        sz = sz * 2;
        i = i + 1;
    }
    slab_arena_next = SLAB_ARENA;
}

// Pick the smallest slab class >= size. Returns class index or -1.
fn slab_class_for(size: i64) -> i64 {
    var i: i64 = 0;
    while i < SLAB_CLASSES {
        if p_mem_read64(SLAB_META + i * 16) >= size { return i; }
        i = i + 1;
    }
    return -1;
}

// Allocate a small object of `size` bytes. Returns address or 0.
pub fn slab_alloc(size: i64) -> i64 {
    if size <= 0 { return 0; }
    var cls: i64 = slab_class_for(size);
    if cls < 0 { return 0; }  // too large for slab
    var slot_size: i64 = p_mem_read64(SLAB_META + cls * 16);
    var head: i64 = p_mem_read64(SLAB_META + cls * 16 + 8);
    if head != 0 {
        // Pop from free list
        var next: i64 = p_mem_read64(head);
        p_mem_write64(SLAB_META + cls * 16 + 8, next);
        return head;
    }
    // Carve a new slot from the arena
    if slab_arena_next + slot_size > SLAB_ARENA_END { return 0; }
    var slot: i64 = slab_arena_next;
    slab_arena_next = slab_arena_next + slot_size;
    return slot;
}

// Free a slab-allocated object. `size` is the original requested size.
pub fn slab_free(ptr: i64, size: i64) -> void {
    if ptr == 0 { return; }
    var cls: i64 = slab_class_for(size);
    if cls < 0 { return; }
    // Push onto the free list for this class
    var head: i64 = p_mem_read64(SLAB_META + cls * 16 + 8);
    p_mem_write64(ptr, head);
    p_mem_write64(SLAB_META + cls * 16 + 8, ptr);
}

// Count free slots in a given slab class
pub fn slab_free_count(cls: i64) -> i64 {
    if cls < 0 || cls >= SLAB_CLASSES { return 0; }
    var count: i64 = 0;
    var cur: i64 = p_mem_read64(SLAB_META + cls * 16 + 8);
    while cur != 0 {
        count = count + 1;
        cur = p_mem_read64(cur);
    }
    return count;
}
