// stdlib/isr.fd — Interrupt Service Routines and IRQ routing
//
// Provides:
//   - IDT setup with 256 entries
//   - ISR stub table (each stub pushes vector number and calls common handler)
//   - IRQ to ISR vector mapping (PIC remap: IRQ0-7 → vectors 0x20-0x27,
//     IRQ8-15 → vectors 0x28-0x2F)
//   - register_handler(vector, fn_ptr) dispatch table
//   - Page fault handler (vector 14) that reads CR2
//   - Common interrupt handler that dispatches to registered handlers
//
// Usage:
//   use isr;
//   isr_init();
//   isr_register_handler(0x20, timer_handler);
//   isr_register_handler(0x21, keyboard_handler);
//   isr_register_handler(14, page_fault_handler);
//   isr_enable();  // sti
//
// Only works in --bare or --boot mode.

module isr;

use vec;
use string;

// ─── IDT Entry Flags ──────────────────────────────────────────────────────

const IDT_PRESENT:    i64 = 0x80;
const IDT_RING0:       i64 = 0x00;
const IDT_RING3:       i64 = 0x60;
const IDT_INTERRUPT:  i64 = 0x0E;  // 32-bit interrupt gate
const IDT_TRAP:        i64 = 0x0F;  // 32-bit trap gate

// ─── PIC Constants ────────────────────────────────────────────────────────

const PIC1:           i64 = 0x20;  // Master PIC
const PIC2:           i64 = 0xA0;  // Slave PIC
const PIC1_CMD:        i64 = 0x20;
const PIC1_DATA:       i64 = 0x21;
const PIC2_CMD:        i64 = 0xA0;
const PIC2_DATA:       i64 = 0xA1;
const PIC_EOI:         i64 = 0x20;  // End-of-Interrupt command

const IRQ0_VECTOR:     i64 = 0x20;
const IRQ8_VECTOR:     i64 = 0x28;

// ─── CPU Exception Names ──────────────────────────────────────────────────

const EXC_DE:  i64 = 0;   // Divide Error
const EXC_DB:  i64 = 1;   // Debug
const EXC_NMI: i64 = 2;   // NMI
const EXC_BP:  i64 = 3;   // Breakpoint
const EXC_OF:  i64 = 4;   // Overflow
const EXC_BR:  i64 = 5;   // Bound Range
const EXC_UD:  i64 = 6;   // Invalid Opcode
const EXC_NM:  i64 = 7;   // Device Not Available
const EXC_DF:  i64 = 8;   // Double Fault
const EXC_TS:  i64 = 10;  // Invalid TSS
const EXC_NP:  i64 = 11;  // Segment Not Present
const EXC_SS:  i64 = 12;  // Stack Segment Fault
const EXC_GP:  i64 = 13;  // General Protection
const EXC_PF:  i64 = 14;  // Page Fault
const EXC_MF:  i64 = 16;  // x87 FPU Error
const EXC_AC:  i64 = 17;  // Alignment Check
const EXC_MC:  i64 = 18;  // Machine Check
const EXC_XM:  i64 = 19;  // SIMD FPU Error

// ─── Interrupt Frame ─────────────────────────────────────────────────────

pub struct InterruptFrame {
    pub rip: i64,
    pub cs: i64,
    pub rflags: i64,
    pub rsp: i64,
    pub ss: i64,
    pub error_code: i64,
    pub vector: i64,
}

// ─── Handler Table ────────────────────────────────────────────────────────

// Maximum 256 vectors (0-255)
const MAX_VECTORS: i64 = 256;

// Handler function type: fn(frame: InterruptFrame) -> void
// In Fides, we store handler addresses as i64 (function pointers)
var handlers: Vec<i64> = Vec::new();
var idt_addr: i64 = 0;
var idt_initialized: bool = false;

// ─── IDT Setup ────────────────────────────────────────────────────────────

pub fn isr_init() {
    // Initialize handler table with null pointers
    handlers = Vec::new();
    var i: i64 = 0;
    while i < MAX_VECTORS {
        handlers.push(0);
        i = i + 1;
    }

    // Allocate IDT (256 entries × 16 bytes = 4096 bytes)
    // In bare-metal mode, we use a fixed physical address
    // The caller should provide a buffer for the IDT
    idt_addr = 0;  // Must be set via isr_set_idt_addr()
    idt_initialized = false;
}

pub fn isr_set_idt_addr(addr: i64) {
    idt_addr = addr;
}

pub fn isr_setup_idt() {
    if idt_addr == 0 { return; }

    // Clear IDT (zero all entries)
    var i: i64 = 0;
    while i < 256 * 16 {
        p_phys_write8(idt_addr + i, 0);
        i = i + 1;
    }

    // Set up each IDT entry to point to the corresponding ISR stub
    // The ISR stubs are generated by the compiler's @interrupt attribute
    // or by the runtime. Here we just set up the IDT entries.
    //
    // IDT entry format (16 bytes):
    //   u16 offset_low
    //   u16 selector (code segment)
    //   u16 flags (P | DPL | type)
    //   u16 offset_mid
    //   u32 offset_high
    //   u32 reserved
    //
    // We use selector 0x08 (kernel code segment from GDT)
    i = 0;
    while i < MAX_VECTORS {
        // Get the ISR stub address for this vector
        // The stubs are at a known offset in the interrupt stub table
        var stub_addr: i64 = isr_get_stub_addr(i);
        isr_set_idt_entry(i, stub_addr, IDT_PRESENT | IDT_RING0 | IDT_INTERRUPT);
        i = i + 1;
    }

    idt_initialized = true;
}

// Set a single IDT entry
pub fn isr_set_idt_entry(vector: i64, handler: i64, flags: i64) {
    if idt_addr == 0 { return; }
    var offset: i64 = vector * 16;

    // offset_low (bits 0-15)
    p_phys_write8(idt_addr + offset, handler & 0xFF);
    p_phys_write8(idt_addr + offset + 1, (handler >> 8) & 0xFF);

    // selector = 0x08 (kernel code segment)
    p_phys_write8(idt_addr + offset + 2, 0x08);
    p_phys_write8(idt_addr + offset + 3, 0x00);

    // flags
    p_phys_write8(idt_addr + offset + 4, flags & 0xFF);
    p_phys_write8(idt_addr + offset + 5, 0x00);

    // offset_mid (bits 16-31)
    p_phys_write8(idt_addr + offset + 6, (handler >> 16) & 0xFF);
    p_phys_write8(idt_addr + offset + 7, (handler >> 24) & 0xFF);

    // offset_high (bits 32-63)
    p_phys_write8(idt_addr + offset + 8, (handler >> 32) & 0xFF);
    p_phys_write8(idt_addr + offset + 9, (handler >> 40) & 0xFF);
    p_phys_write8(idt_addr + offset + 10, (handler >> 48) & 0xFF);
    p_phys_write8(idt_addr + offset + 11, (handler >> 56) & 0xFF);

    // reserved
    p_phys_write8(idt_addr + offset + 12, 0);
    p_phys_write8(idt_addr + offset + 13, 0);
    p_phys_write8(idt_addr + offset + 14, 0);
    p_phys_write8(idt_addr + offset + 15, 0);
}

// Get the ISR stub address for a given vector.
// In a real implementation, this would return the address of the
// generated ISR stub. The stubs are typically placed in a table
// by the compiler or linker.
// For now, we return 0 — the actual stub addresses must be
// registered by the runtime or linker.
var stub_table: Vec<i64> = Vec::new();

pub fn isr_register_stub(vector: i64, addr: i64) {
    if stub_table.len() == 0 {
        var i: i64 = 0;
        while i < MAX_VECTORS {
            stub_table.push(0);
            i = i + 1;
        }
    }
    stub_table.set(vector, addr);
}

fn isr_get_stub_addr(vector: i64) -> i64 {
    if stub_table.len() == 0 { return 0; }
    if vector < 0 || vector >= MAX_VECTORS { return 0; }
    return stub_table.get(vector);
}

// ─── Handler Registration ─────────────────────────────────────────────────

pub fn isr_register_handler(vector: i64, handler: i64) {
    if vector < 0 || vector >= MAX_VECTORS { return; }
    handlers.set(vector, handler);
}

pub fn isr_unregister_handler(vector: i64) {
    if vector < 0 || vector >= MAX_VECTORS { return; }
    handlers.set(vector, 0);
}

// ─── Common Interrupt Handler ─────────────────────────────────────────────

// This function is called by each ISR stub after pushing the vector
// number and saving registers. It dispatches to the registered handler.
pub fn isr_common_handler(frame: InterruptFrame) {
    var vector: i64 = frame.vector;

    // Check if a handler is registered
    if vector >= 0 && vector < MAX_VECTORS {
        var handler: i64 = handlers.get(vector);
        if handler != 0 {
            // Call the handler function pointer
            // In bare-metal mode, this would be: ((void(*)(InterruptFrame*))handler)(&frame);
            // For now, we use a builtin to call the function pointer
            isr_call_handler(handler, frame);
        }
    }

    // Send EOI to PIC for hardware interrupts (vectors 0x20-0x2F)
    if vector >= 0x20 && vector < 0x30 {
        isr_pic_eoi(vector - 0x20);
    }
}

// Call a function pointer with an InterruptFrame argument.
// This would be an inline asm sequence in bare-metal mode.
fn isr_call_handler(handler: i64, frame: InterruptFrame) {
    // In bare-metal mode:
    //   mov rdi, frame  (first arg)
    //   call handler
    // For the hosted stub, this is a no-op
    // The actual call is done via inline asm in the runtime
}

// ─── PIC Remapping ────────────────────────────────────────────────────────

pub fn isr_pic_remap() {
    // Remap PIC IRQ0-15 to vectors 0x20-0x2F
    // This prevents conflicts with CPU exceptions (0-31)

    // ICW1: Start initialization
    p_outb(PIC1_CMD, 0x11);
    p_outb(PIC2_CMD, 0x11);

    // ICW2: Set vector offsets
    p_outb(PIC1_DATA, IRQ0_VECTOR);   // IRQ0-7 → 0x20-0x27
    p_outb(PIC2_DATA, IRQ8_VECTOR);   // IRQ8-15 → 0x28-0x2F

    // ICW3: Tell master about slave (IRQ2)
    p_outb(PIC1_DATA, 0x04);
    // Tell slave its cascade identity
    p_outb(PIC2_DATA, 0x02);

    // ICW4: 8086 mode
    p_outb(PIC1_DATA, 0x01);
    p_outb(PIC2_DATA, 0x01);

    // Mask all IRQs initially (unmask as needed)
    p_outb(PIC1_DATA, 0xFF);
    p_outb(PIC2_DATA, 0xFF);
}

pub fn isr_pic_mask(irq: i64, masked: bool) {
    var port: i64 = PIC1_DATA;
    if irq >= 8 { port = PIC2_DATA; }
    var bit: i64 = 1 << (irq & 7);
    var current: i64 = p_inb(port);
    if masked {
        current = current | bit;
    } else {
        current = current & ~bit;
    }
    p_outb(port, current);
}

pub fn isr_pic_eoi(irq: i64) {
    if irq >= 8 {
        p_outb(PIC2_CMD, PIC_EOI);
    }
    p_outb(PIC1_CMD, PIC_EOI);
}

// ─── Enable/Disable Interrupts ─────────────────────────────────────────────

pub fn isr_enable() {
    p_sti();
}

pub fn isr_disable() {
    p_cli();
}

// ─── Page Fault Handler ───────────────────────────────────────────────────

pub fn isr_page_fault_handler(frame: InterruptFrame) {
    // Read CR2 to get the faulting address
    var fault_addr: i64 = p_cr2_read();
    var error_code: i64 = frame.error_code;

    // Decode error code flags
    var present: bool = (error_code & 1) != 0;
    var write: bool = (error_code & 2) != 0;
    var user: bool = (error_code & 4) != 0;

    // In a real OS, we'd handle this by:
    // 1. Checking if the address is in a valid VMA
    // 2. Allocating a page and mapping it
    // 3. Or killing the process if it's an invalid access

    // For now, print a message and halt
    serial_print("PAGE FAULT at address ");
    serial_print_int(fault_addr);
    serial_print("\n");
    halt_forever();
}

// ─── Helpers (from kernel.fd, re-exported for convenience) ────────────────

fn serial_print(s: str) {
    var i: i64 = 0;
    while i < str_len(s) {
        p_serial_putc(str_slice(s, i, i + 1));
        i = i + 1;
    }
}

fn serial_print_int(n: i64) {
    serial_print(int_to_str(n));
}

fn halt_forever() {
    p_cli();
    while true {
        p_hlt();
    }
    return;
}
