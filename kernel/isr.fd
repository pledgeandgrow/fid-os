// kernel/isr.fd — Interrupt service routines + exception handlers
// CPU exception handlers prevent triple faults by catching errors
// and printing a diagnostic message instead of silently resetting.

module isr;

use console;
use sched;

// Scheduler scratch addresses (for timer handler — no local variables allowed)
pub const SCHED_SCRATCH0: i64 = 0x320200;  // quantum temp
pub const SCHED_SCRATCH1: i64 = 0x320208;  // current thread
pub const SCHED_SCRATCH2: i64 = 0x320210;  // next thread
pub const SCHED_SCRATCH3: i64 = 0x320218;  // loop counter
pub const SCHED_SCRATCH4: i64 = 0x320220;  // cur_rbp
pub const SCHED_SCRATCH5: i64 = 0x320228;  // new_rbp

// Timer tick counter at 0x690 (8 bytes)
pub const TIMER_TICKS: i64 = 0x690;

// Error code saved by PE backend prologue at 0x510
pub const EXC_ERRCODE: i64 = 0x510;

// Scheduler constants (must match sched.fd — duplicated to avoid circular import)
pub const SCHED_QUANTUM_ADDR: i64 = 0x320080;
pub const SCHED_CURRENT_ADDR: i64 = 0x320084;
pub const KTHREAD_TABLE: i64 = 0x330000;
pub const KTHREAD_MAX: i64 = 16;
pub const KTHREAD_ENTRY_SIZE: i64 = 128;
pub const KTHREAD_READY: i64 = 1;
pub const KTHREAD_RUNNING: i64 = 2;

// Print a crash message and halt. Used by all exception handlers.
pub fn panic_print(msg0: i64, msg1: i64, msg2: i64, msg3: i64, msg4: i64, msg5: i64, msg6: i64, msg7: i64) -> void {
    con_putc(10);
    con_putc(91); con_putc(67); con_putc(82); con_putc(65); con_putc(83); con_putc(72); con_putc(93); // [CRASH]
    con_putc(32);
    con_putc(msg0); con_putc(msg1); con_putc(msg2); con_putc(msg3);
    con_putc(msg4); con_putc(msg5); con_putc(msg6); con_putc(msg7);
    con_putc(10);
}

// Dump registers and stack trace, then halt
pub fn panic_halt() -> void {
    panic_dump_regs();
    panic_stack_trace();
    p_cli();
    while true { p_hlt(); }
}

// Dump registers on panic: CR2, RBP, RSP, error code
pub fn panic_dump_regs() -> void {
    var cr2: i64 = p_cr2_read();
    var rbp: i64 = p_get_rbp();
    var rsp: i64 = p_get_rsp();
    // "CR2: "
    con_putc(67); con_putc(82); con_putc(50); con_putc(58); con_putc(32);
    print_hex(cr2);
    con_putc(10);
    // "RBP: "
    con_putc(82); con_putc(66); con_putc(80); con_putc(58); con_putc(32);
    print_hex(rbp);
    con_putc(10);
    // "RSP: "
    con_putc(82); con_putc(83); con_putc(80); con_putc(58); con_putc(32);
    print_hex(rsp);
    con_putc(10);
}

// Walk the stack frame chain and print return addresses (up to 8 frames)
pub fn panic_stack_trace() -> void {
    // "Stack:"
    con_putc(83); con_putc(116); con_putc(97); con_putc(99); con_putc(107); con_putc(58);
    con_putc(10);
    var rbp: i64 = p_get_rbp();
    var i: i64 = 0;
    while i < 8 {
        if rbp == 0 { break; }
        if rbp < 0x1000 { break; }
        if rbp > 0x100000 { break; }
        // Return address is at [rbp + 8]
        var ret_addr: i64 = p_mem_read32(rbp + 8) | (p_mem_read32(rbp + 12) << 32);
        // Print "  #N: 0xADDR"
        con_putc(32); con_putc(32);
        con_putc(35); print_dec(i); con_putc(58); con_putc(32);
        print_hex(ret_addr);
        con_putc(10);
        // Follow chain: next RBP is at [rbp]
        rbp = p_mem_read32(rbp) | (p_mem_read32(rbp + 4) << 32);
        i = i + 1;
    }
}

// #DE Divide Error (vector 0x00)
@interrupt(0) fn exc_divide_error() -> void {
    panic_print(68, 105, 118, 105, 100, 101, 32, 98); // "Divide b"
    panic_halt();
}

// #UD Invalid Opcode (vector 0x06)
@interrupt(6) fn exc_invalid_opcode() -> void {
    panic_print(73, 110, 118, 97, 108, 105, 100, 32); // "Invalid "
    panic_halt();
}

// #DF Double Fault (vector 0x08)
@interrupt(8) fn exc_double_fault() -> void {
    panic_print(68, 111, 117, 98, 108, 101, 32, 70); // "Double F"
    panic_halt();
}

// #GP General Protection Fault (vector 0x0D)
@interrupt(13) fn exc_gpf() -> void {
    var errcode: i64 = p_mem_read8(0x510);
    panic_print(71, 80, 70, 32, 70, 97, 117, 108); // "GPF Faul"
    con_putc(32); con_putc(69); con_putc(58); con_putc(32); // " E: "
    print_hex(errcode);
    con_putc(10);
    panic_halt();
}

// #PF Page Fault (vector 0x0E)
@interrupt(14) fn exc_page_fault() -> void {
    var cr2: i64 = p_cr2_read();
    var errcode: i64 = p_mem_read8(0x510);
    con_putc(10);
    con_putc(91); con_putc(67); con_putc(82); con_putc(65); con_putc(83); con_putc(72); con_putc(93); // [CRASH]
    con_putc(32);
    con_putc(80); con_putc(97); con_putc(103); con_putc(101); con_putc(32); con_putc(70); con_putc(97); // "Page Fa"
    con_putc(117); con_putc(108); con_putc(116); con_putc(32); con_putc(97); con_putc(116); con_putc(32); // "ult at "
    print_hex(cr2);
    con_putc(32); con_putc(69); con_putc(58); con_putc(32); // " E: "
    print_hex(errcode);
    con_putc(10);
    panic_halt();
}

// ─── Timer Interrupt (IRQ0) ─────────────────────────────────────────────
// IRQ0 timer interrupt handler (vector 0x20 after PIC remap).
// Increments tick counter, runs preemptive scheduler, sends EOI.
// Context switch: saves current RBP, loads next thread's RBP.
// The epilogue's `mov rsp, rbp; pop rbp; pop regs; iretq` switches stacks.
@interrupt(0x20) fn irq0_handler() -> void {
    // Increment tick counter
    p_mem_write8(TIMER_TICKS, p_mem_read8(TIMER_TICKS) + 1);
    // Send EOI to master PIC
    p_outb(0x20, 0x20);
    // Increment quantum counter for scheduler
    p_mem_write8(SCHED_QUANTUM_ADDR, p_mem_read8(SCHED_QUANTUM_ADDR) + 1);
}

// Get the current tick count.
pub fn timer_get_ticks() -> i64 {
    return p_mem_read8(TIMER_TICKS);
}
