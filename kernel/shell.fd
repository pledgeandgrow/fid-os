// kernel/shell.fd — Fides OS with VGA framebuffer, keyboard, and shell
//
// Boots via GRUB/Multiboot2, writes to VGA text mode (0xB8000),
// reads keyboard input via polling (port 0x60/0x64), and runs a
// basic shell with commands: help, clear, echo, reboot, halt.

module shell;

// ─── VGA Text Mode ───────────────────────────────────────────────────────
// VGA text buffer at 0xB8000. 80 columns x 25 rows.
// Each cell: 2 bytes — [ASCII char][attribute byte]

const VGA_ADDR:  i64 = 0xB8000;
const VGA_COLS:  i64 = 80;
const VGA_ROWS:  i64 = 25;
const VGA_ATTR:  i64 = 0x07;

var vga_col: i64 = 0;
var vga_row: i64 = 0;

fn vga_putc_at(col: i64, row: i64, c: i64) -> void {
    var offset: i64 = (row * VGA_COLS + col) * 2;
    p_mem_write8(VGA_ADDR + offset, c);
    p_mem_write8(VGA_ADDR + offset + 1, VGA_ATTR);
}

fn vga_scroll() -> void {
    var row: i64 = 0;
    while row < VGA_ROWS - 1 {
        var col: i64 = 0;
        while col < VGA_COLS {
            var src: i64 = VGA_ADDR + ((row + 1) * VGA_COLS + col) * 2;
            var dst: i64 = VGA_ADDR + (row * VGA_COLS + col) * 2;
            p_mem_write8(dst, p_mem_read8(src));
            p_mem_write8(dst + 1, p_mem_read8(src + 1));
            col = col + 1;
        }
        row = row + 1;
    }
    var col2: i64 = 0;
    while col2 < VGA_COLS {
        vga_putc_at(col2, VGA_ROWS - 1, 32);
        col2 = col2 + 1;
    }
}

fn vga_putc(c: i64) -> void {
    if c == 10 {
        vga_col = 0;
        vga_row = vga_row + 1;
        if vga_row >= VGA_ROWS { vga_scroll(); vga_row = VGA_ROWS - 1; }
        return;
    }
    if c == 8 {
        if vga_col > 0 {
            vga_col = vga_col - 1;
            vga_putc_at(vga_col, vga_row, 32);
        }
        return;
    }
    vga_putc_at(vga_col, vga_row, c);
    vga_col = vga_col + 1;
    if vga_col >= VGA_COLS {
        vga_col = 0;
        vga_row = vga_row + 1;
        if vga_row >= VGA_ROWS { vga_scroll(); vga_row = VGA_ROWS - 1; }
    }
}

fn vga_clear() -> void {
    var row: i64 = 0;
    while row < VGA_ROWS {
        var col: i64 = 0;
        while col < VGA_COLS {
            vga_putc_at(col, row, 32);
            col = col + 1;
        }
        row = row + 1;
    }
    vga_col = 0;
    vga_row = 0;
}

// ─── Serial Output (COM1) ───────────────────────────────────────────────

fn serial_putc(c: i64) -> void {
    var ready: i64 = 0;
    while ready == 0 {
        ready = p_inb(0x3FD) & 0x20;
    }
    p_outb(0x3F8, c);
}

fn con_putc(c: i64) -> void {
    vga_putc(c);
    serial_putc(c);
}

// ─── Exception Handlers ─────────────────────────────────────────────────
// CPU exception handlers. These prevent triple faults by catching errors
// and printing a diagnostic message instead of silently resetting.

// Print a crash message and halt. Used by all exception handlers.
fn panic_print(msg0: i64, msg1: i64, msg2: i64, msg3: i64, msg4: i64, msg5: i64, msg6: i64, msg7: i64) -> void {
    con_putc(10);
    con_putc(91); con_putc(67); con_putc(82); con_putc(65); con_putc(83); con_putc(72); con_putc(93); // [CRASH]
    con_putc(32);
    con_putc(msg0); con_putc(msg1); con_putc(msg2); con_putc(msg3);
    con_putc(msg4); con_putc(msg5); con_putc(msg6); con_putc(msg7);
    con_putc(10);
    // Print CR2 (page fault address) if available
    p_cli();
    while true { p_hlt(); }
}

// #DE Divide Error (vector 0x00)
@interrupt(0) fn exc_divide_error() -> void {
    panic_print(68, 105, 118, 105, 100, 101, 32, 98); // "Divide b"
}

// #DF Double Fault (vector 0x08)
@interrupt(8) fn exc_double_fault() -> void {
    panic_print(68, 111, 117, 98, 108, 101, 32, 70); // "Double F"
}

// #GP General Protection Fault (vector 0x0D)
@interrupt(13) fn exc_gpf() -> void {
    var errcode: i64 = p_mem_read8(0x510);
    panic_print(71, 80, 70, 32, 70, 97, 117, 108); // "GPF Faul"
    con_putc(32); con_putc(69); con_putc(58); con_putc(32); // " E: "
    print_hex(errcode);
    con_putc(10);
}

// #PF Page Fault (vector 0x0E)
@interrupt(14) fn exc_page_fault() -> void {
    var cr2: i64 = p_cr2_read();
    var errcode: i64 = p_mem_read8(0x510);
    con_putc(10);
    con_putc(91); con_putc(67); con_putc(82); con_putc(65); con_putc(83); con_putc(72); con_putc(93); // [CRASH]
    con_putc(32);
    con_putc(80); con_putc(97); con_putc(103); con_putc(101); con_putc(32); con_putc(70); con_putc(97); // "Page Fa"
    con_putc(117); con_putc(108); con_putc(116); con_putc(32); con_putc(97); con_putc(116); con_putc(32); // "ult at "
    print_hex(cr2);
    con_putc(32); con_putc(69); con_putc(58); con_putc(32); // " E: "
    print_hex(errcode);
    con_putc(10);
    p_cli();
    while true { p_hlt(); }
}

// ─── Timer Interrupt (IRQ0) ─────────────────────────────────────────────
// Timer tick counter at 0x690 (8 bytes)
const TIMER_TICKS: i64 = 0x690;

// IRQ0 timer interrupt handler (vector 0x20 after PIC remap).
// Increments a tick counter, calls scheduler, and sends EOI.
@interrupt(0x20) fn irq0_handler() -> void {
    // Increment tick counter
    p_mem_write8(TIMER_TICKS, p_mem_read8(TIMER_TICKS) + 1);
    // Send EOI to master PIC
    p_outb(0x20, 0x20);
}

// ─── Exception Handlers ──────────────────────────────────────────────────

// Error code saved by PE backend prologue at 0x510
const EXC_ERRCODE: i64 = 0x510;

// (Existing exception handlers in shell.fd already handle #PF, #GP, #DF, #DE)
// The PE backend prologue saves the CPU-pushed error code at 0x510 for
// vectors that push one (0x08, 0x0A-0x0E, 0x11, 0x1E).

// Get the current tick count.
fn timer_get_ticks() -> i64 {
    return p_mem_read8(TIMER_TICKS);
}

// ─── Keyboard Input (Interrupt-Driven) ──────────────────────────────────

// Scancode circular buffer at 0x600 (64 entries × 8 bytes = 512 bytes)
// Head/tail pointers at 0x680/0x688
// Shift state at 0x689 (0=none, 1=left or right shift)
// CapsLock state at 0x68A (0=off, 1=on)
const SCANCODE_BUF: i64 = 0x600;
const SCANCODE_HEAD: i64 = 0x680;
const SCANCODE_TAIL: i64 = 0x688;
const KBD_SHIFT: i64 = 0x689;
const KBD_CAPS: i64 = 0x68A;
const SCANCODE_SIZE: i64 = 64;

// IRQ1 keyboard interrupt handler.
// The boot trampoline automatically wires this to IDT vector 0x21.
// This function is called by the CPU when a key is pressed/released.
// It reads the scancode, stores it in the buffer, and sends EOI to the PIC.
interrupt fn irq1_handler() -> void {
    // Read scancode from keyboard data port
    var sc: i64 = p_inb(0x60);

    // Track Shift state (0x2A=left shift down, 0xAA=left shift up,
    //                     0x36=right shift down, 0xB6=right shift up)
    if sc == 0x2A || sc == 0x36 {
        p_mem_write8(KBD_SHIFT, 1);
        p_outb(0x20, 0x20);
        return;
    }
    if sc == 0xAA || sc == 0xB6 {
        p_mem_write8(KBD_SHIFT, 0);
        p_outb(0x20, 0x20);
        return;
    }
    // Toggle CapsLock on 0x3A (make code only)
    if sc == 0x3A {
        var caps: i64 = p_mem_read8(KBD_CAPS);
        if caps == 0 { p_mem_write8(KBD_CAPS, 1); }
        else { p_mem_write8(KBD_CAPS, 0); }
        p_outb(0x20, 0x20);
        return;
    }

    // Store in circular buffer
    var head: i64 = p_mem_read8(SCANCODE_HEAD);
    var next: i64 = head + 1;
    if next >= SCANCODE_SIZE { next = 0; }
    // Only write if buffer not full (tail != next)
    var tail: i64 = p_mem_read8(SCANCODE_TAIL);
    if next != tail {
        // Store scancode at buffer[head]
        p_mem_write8(SCANCODE_BUF + head, sc);
        p_mem_write8(SCANCODE_HEAD, next);
    }

    // Send EOI (End of Interrupt) to master PIC
    p_outb(0x20, 0x20);
}

// Read a scancode from the buffer. Returns -1 if no scancode available.
// Uses hlt to wait for interrupts (CPU sleeps until a key is pressed).
fn kbd_read_scancode() -> i64 {
    while true {
        var head: i64 = p_mem_read8(SCANCODE_HEAD);
        var tail: i64 = p_mem_read8(SCANCODE_TAIL);
        if head != tail {
            // Buffer has data
            var sc: i64 = p_mem_read8(SCANCODE_BUF + tail);
            var next: i64 = tail + 1;
            if next >= SCANCODE_SIZE { next = 0; }
            p_mem_write8(SCANCODE_TAIL, next);
            return sc;
        }
        // No data — sleep until next interrupt
        p_hlt();
    }
    return -1;
}

// Convert scancode to ASCII, respecting Shift and CapsLock state.
fn scancode_to_ascii(sc: i64) -> i64 {
    // Release codes (bit 7 set) are not characters
    if (sc & 0x80) != 0 { return -1; }

    var shift: i64 = p_mem_read8(KBD_SHIFT);
    var caps: i64 = p_mem_read8(KBD_CAPS);

    // Special keys
    if sc == 0x1C { return 10; }  // Enter
    if sc == 0x39 { return 32; }  // Space
    if sc == 0x0E { return 8;  }  // Backspace

    // Letters (a-z): apply Shift or CapsLock for uppercase
    var letter: i64 = -1;
    if sc == 0x1E { letter = 97; }  if sc == 0x30 { letter = 98; }
    if sc == 0x2E { letter = 99; }  if sc == 0x20 { letter = 100; }
    if sc == 0x12 { letter = 101; } if sc == 0x21 { letter = 102; }
    if sc == 0x22 { letter = 103; } if sc == 0x23 { letter = 104; }
    if sc == 0x17 { letter = 105; } if sc == 0x24 { letter = 106; }
    if sc == 0x25 { letter = 107; } if sc == 0x26 { letter = 108; }
    if sc == 0x32 { letter = 109; } if sc == 0x31 { letter = 110; }
    if sc == 0x18 { letter = 111; } if sc == 0x19 { letter = 112; }
    if sc == 0x10 { letter = 113; } if sc == 0x13 { letter = 114; }
    if sc == 0x1F { letter = 115; } if sc == 0x14 { letter = 116; }
    if sc == 0x16 { letter = 117; } if sc == 0x2F { letter = 118; }
    if sc == 0x11 { letter = 119; } if sc == 0x2D { letter = 120; }
    if sc == 0x15 { letter = 121; } if sc == 0x2C { letter = 122; }
    if letter != -1 {
        // Uppercase if (shift XOR caps) for letters
        if (shift != 0) != (caps != 0) {
            return letter - 32; // to uppercase
        }
        return letter;
    }

    // Number row: shifted gives symbols
    if sc == 0x02 { if shift != 0 { return 33; }  return 49; }  // 1 or !
    if sc == 0x03 { if shift != 0 { return 64; }  return 50; }  // 2 or @
    if sc == 0x04 { if shift != 0 { return 35; }  return 51; }  // 3 or #
    if sc == 0x05 { if shift != 0 { return 36; }  return 52; }  // 4 or $
    if sc == 0x06 { if shift != 0 { return 37; }  return 53; }  // 5 or %
    if sc == 0x07 { if shift != 0 { return 94; }  return 54; }  // 6 or ^
    if sc == 0x08 { if shift != 0 { return 38; }  return 55; }  // 7 or &
    if sc == 0x09 { if shift != 0 { return 42; }  return 56; }  // 8 or *
    if sc == 0x0A { if shift != 0 { return 40; }  return 57; }  // 9 or (
    if sc == 0x0B { if shift != 0 { return 41; }  return 48; }  // 0 or )

    // Punctuation (unshifted)
    if sc == 0x0C { if shift != 0 { return 95; }  return 45; }  // - or _
    if sc == 0x0D { if shift != 0 { return 43; }  return 61; }  // = or +
    if sc == 0x33 { if shift != 0 { return 60; }  return 44; }  // , or <
    if sc == 0x34 { if shift != 0 { return 62; }  return 46; }  // . or >
    if sc == 0x35 { if shift != 0 { return 63; }  return 47; }  // / or ?

    // Additional keys
    if sc == 0x27 { if shift != 0 { return 123; } return 59; }  // ; or {
    if sc == 0x28 { if shift != 0 { return 125; } return 39; }  // ' or }
    if sc == 0x29 { if shift != 0 { return 126; } return 96; }  // ` or ~
    if sc == 0x2B { if shift != 0 { return 124; } return 92; }  // \ or |
    if sc == 0x1A { if shift != 0 { return 123; } return 91; }  // [ or {
    if sc == 0x1B { if shift != 0 { return 125; } return 93; }  // ] or }

    return -1;
}

// ─── Input Buffer ────────────────────────────────────────────────────────
// Use a fixed memory region for the input buffer (below VGA at 0x80000)
const INPUT_BUF_ADDR: i64 = 0x80000;
const INPUT_MAX: i64 = 256;

fn input_clear() -> void {
    var i: i64 = 0;
    while i < INPUT_MAX {
        p_mem_write8(INPUT_BUF_ADDR + i, 0);
        i = i + 1;
    }
}

fn input_write(idx: i64, c: i64) -> void {
    p_mem_write8(INPUT_BUF_ADDR + idx, c);
}

fn input_get(idx: i64) -> i64 {
    return p_mem_read8(INPUT_BUF_ADDR + idx);
}

// Check if input matches a string (char codes passed as args)
fn input_matches(s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, len: i64, actual_len: i64) -> i64 {
    if actual_len != len { return 0; }
    if len > 0 { if input_get(0) != s0 { return 0; } }
    if len > 1 { if input_get(1) != s1 { return 0; } }
    if len > 2 { if input_get(2) != s2 { return 0; } }
    if len > 3 { if input_get(3) != s3 { return 0; } }
    if len > 4 { if input_get(4) != s4 { return 0; } }
    return 1;
}

// Check if input matches a string up to 8 chars
fn input_matches8(s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64, len: i64, actual_len: i64) -> i64 {
    if actual_len != len { return 0; }
    if len > 0 { if input_get(0) != s0 { return 0; } }
    if len > 1 { if input_get(1) != s1 { return 0; } }
    if len > 2 { if input_get(2) != s2 { return 0; } }
    if len > 3 { if input_get(3) != s3 { return 0; } }
    if len > 4 { if input_get(4) != s4 { return 0; } }
    if len > 5 { if input_get(5) != s5 { return 0; } }
    if len > 6 { if input_get(6) != s6 { return 0; } }
    if len > 7 { if input_get(7) != s7 { return 0; } }
    return 1;
}

// Print a decimal integer
fn print_dec(n: i64) -> void {
    var m: i64 = n;
    if m == 0 { con_putc(48); return; }
    // Handle negative
    if m < 0 {
        con_putc(45);
        m = 0 - m;
    }
    // Extract digits into a buffer at 0x50000
    var buf: i64 = 0x50000;
    var i: i64 = 0;
    while m > 0 {
        p_mem_write8(buf + i, 48 + (m % 10));
        m = m / 10;
        i = i + 1;
    }
    // Print in reverse
    while i > 0 {
        i = i - 1;
        con_putc(p_mem_read8(buf + i));
    }
}

// Print a hex integer (64-bit, with 0x prefix)
fn print_hex(n: i64) -> void {
    con_putc(48); con_putc(120);
    var buf: i64 = 0x50000;
    var i: i64 = 0;
    var tmp: i64 = n;
    while i < 16 {
        var nibble: i64 = tmp & 0xF;
        if nibble < 10 {
            p_mem_write8(buf + i, 48 + nibble);
        } else {
            p_mem_write8(buf + i, 97 + nibble - 10);
        }
        tmp = tmp >> 4;
        i = i + 1;
    }
    // Skip leading zeros
    i = 15;
    while i > 0 {
        if p_mem_read8(buf + i) != 48 { break; }
        i = i - 1;
    }
    while i >= 0 {
        con_putc(p_mem_read8(buf + i));
        i = i - 1;
    }
}

// Print a fixed string from char codes (up to 16)
fn print_str(s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64, len: i64) -> void {
    if len > 0 { con_putc(s0); }
    if len > 1 { con_putc(s1); }
    if len > 2 { con_putc(s2); }
    if len > 3 { con_putc(s3); }
    if len > 4 { con_putc(s4); }
    if len > 5 { con_putc(s5); }
    if len > 6 { con_putc(s6); }
    if len > 7 { con_putc(s7); }
}

// ─── Shell Commands ─────────────────────────────────────────────────────

fn cmd_help() -> void {
    con_putc(10);
    // "Commands:"
    con_putc(67); con_putc(111); con_putc(109); con_putc(109); con_putc(97); con_putc(110); con_putc(100); con_putc(115); con_putc(58);
    con_putc(10);
    // "  help    - show this help"
    con_putc(32); con_putc(32);
    con_putc(104); con_putc(101); con_putc(108); con_putc(112);
    con_putc(32); con_putc(32); con_putc(32); con_putc(32);
    con_putc(45); con_putc(32);
    con_putc(115); con_putc(104); con_putc(111); con_putc(119); con_putc(32); con_putc(116); con_putc(104); con_putc(105); con_putc(115);
    con_putc(32); con_putc(104); con_putc(101); con_putc(108); con_putc(112);
    con_putc(10);
    // "  clear   - clear screen"
    con_putc(32); con_putc(32);
    con_putc(99); con_putc(108); con_putc(101); con_putc(97); con_putc(114);
    con_putc(32); con_putc(32); con_putc(32); con_putc(32);
    con_putc(45); con_putc(32);
    con_putc(99); con_putc(108); con_putc(101); con_putc(97); con_putc(114); con_putc(32); con_putc(115); con_putc(99); con_putc(114); con_putc(101); con_putc(101); con_putc(110);
    con_putc(10);
    // "  echo    - print text"
    con_putc(32); con_putc(32);
    con_putc(101); con_putc(99); con_putc(104); con_putc(111);
    con_putc(32); con_putc(32); con_putc(32); con_putc(32);
    con_putc(45); con_putc(32);
    con_putc(112); con_putc(114); con_putc(105); con_putc(110); con_putc(116); con_putc(32); con_putc(116); con_putc(101); con_putc(120); con_putc(116);
    con_putc(10);
    // "  mem     - show memory map"
    con_putc(32); con_putc(32);
    con_putc(109); con_putc(101); con_putc(109);
    con_putc(32); con_putc(32); con_putc(32); con_putc(32); con_putc(32);
    con_putc(45); con_putc(32);
    con_putc(115); con_putc(104); con_putc(111); con_putc(119); con_putc(32); con_putc(109); con_putc(101); con_putc(109); con_putc(111); con_putc(114); con_putc(121);
    con_putc(10);
    // "  info    - system info"
    con_putc(32); con_putc(32);
    con_putc(105); con_putc(110); con_putc(102); con_putc(111);
    con_putc(32); con_putc(32); con_putc(32); con_putc(32);
    con_putc(45); con_putc(32);
    con_putc(115); con_putc(121); con_putc(115); con_putc(116); con_putc(101); con_putc(109); con_putc(32); con_putc(105); con_putc(110); con_putc(102); con_putc(111);
    con_putc(10);
    // "  time    - show RTC time"
    con_putc(32); con_putc(32);
    con_putc(116); con_putc(105); con_putc(109); con_putc(101);
    con_putc(32); con_putc(32); con_putc(32); con_putc(32);
    con_putc(45); con_putc(32);
    con_putc(115); con_putc(104); con_putc(111); con_putc(119); con_putc(32); con_putc(82); con_putc(84); con_putc(67); con_putc(32); con_putc(116); con_putc(105); con_putc(109); con_putc(101);
    con_putc(10);
    // "  date    - show RTC date"
    con_putc(32); con_putc(32);
    con_putc(100); con_putc(97); con_putc(116); con_putc(101);
    con_putc(32); con_putc(32); con_putc(32); con_putc(32);
    con_putc(45); con_putc(32);
    con_putc(115); con_putc(104); con_putc(111); con_putc(119); con_putc(32); con_putc(82); con_putc(84); con_putc(67); con_putc(32); con_putc(100); con_putc(97); con_putc(116); con_putc(101);
    con_putc(10);
    // "  reboot  - restart system"
    con_putc(32); con_putc(32);
    con_putc(114); con_putc(101); con_putc(98); con_putc(111); con_putc(111); con_putc(116);
    con_putc(32); con_putc(32);
    con_putc(45); con_putc(32);
    con_putc(114); con_putc(101); con_putc(115); con_putc(116); con_putc(97); con_putc(114); con_putc(116); con_putc(32); con_putc(115); con_putc(121); con_putc(115); con_putc(116); con_putc(101); con_putc(109);
    con_putc(10);
    // "  poweroff- turn off (ACPI)"
    con_putc(32); con_putc(32);
    con_putc(112); con_putc(111); con_putc(119); con_putc(101); con_putc(114); con_putc(111); con_putc(102); con_putc(102);
    con_putc(32); con_putc(45);
    con_putc(32); con_putc(116); con_putc(117); con_putc(114); con_putc(110); con_putc(32); con_putc(111); con_putc(102); con_putc(102);
    con_putc(10);
    // "  malloc  - test heap alloc"
