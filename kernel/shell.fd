fn cmd_time() -> void {
    con_putc(10);
    // Read CMOS RTC registers
    // "Time: "
    con_putc(84); con_putc(105); con_putc(109); con_putc(101); con_putc(58); con_putc(32);
    // Read hours (CMOS reg 0x04) — disable NMI by setting bit 7
    p_outb(0x70, 0x84);
    var hours: i64 = p_inb(0x71);
    // Read minutes (CMOS reg 0x02)
    p_outb(0x70, 0x82);
    var minutes: i64 = p_inb(0x71);
    // Read seconds (CMOS reg 0x00)
    p_outb(0x70, 0x80);
    var seconds: i64 = p_inb(0x71);
    // Convert BCD to binary
    hours = (hours >> 4) * 10 + (hours & 0x0F);
    minutes = (minutes >> 4) * 10 + (minutes & 0x0F);
    seconds = (seconds >> 4) * 10 + (seconds & 0x0F);
    // Print HH:MM:SS
    if hours < 10 { con_putc(48); }
    print_dec(hours);
    con_putc(58);
    if minutes < 10 { con_putc(48); }
    print_dec(minutes);
    con_putc(58);
    if seconds < 10 { con_putc(48); }
    print_dec(seconds);
    con_putc(10);
}

fn cmd_date() -> void {
    con_putc(10);
    // "Date: "
    con_putc(68); con_putc(97); con_putc(116); con_putc(101); con_putc(58); con_putc(32);
    // Read year (CMOS reg 0x09)
    p_outb(0x70, 0x89);
    var year: i64 = p_inb(0x71);
    // Read month (CMOS reg 0x08)
    p_outb(0x70, 0x88);
    var month: i64 = p_inb(0x71);
    // Read day (CMOS reg 0x07)
    p_outb(0x70, 0x87);
    var day: i64 = p_inb(0x71);
    // Convert BCD to binary
    year = (year >> 4) * 10 + (year & 0x0F);
    month = (month >> 4) * 10 + (month & 0x0F);
    day = (day >> 4) * 10 + (day & 0x0F);
    // Print YYYY-MM-DD
    con_putc(50); con_putc(48); // "20"
    if year < 10 { con_putc(48); }
    print_dec(year);
    con_putc(45);
    if month < 10 { con_putc(48); }
    print_dec(month);
    con_putc(45);
    if day < 10 { con_putc(48); }
    print_dec(day);
    con_putc(10);
}

fn cmd_poweroff() -> void {
    con_putc(10);
    // "Powering off..."
    con_putc(80); con_putc(111); con_putc(119); con_putc(101); con_putc(114); con_putc(105); con_putc(110); con_putc(103);
    con_putc(32); con_putc(111); con_putc(102); con_putc(102); con_putc(46); con_putc(46); con_putc(46);
    con_putc(10);
    // QEMU ACPI shutdown: write 0x2000 to port 0x604
    p_outw(0x604, 0x2000);
    // Also try the older QEMU shutdown port
    p_outw(0xB004, 0x2000);
    // If that didn't work, halt
    p_cli();
    while true { p_hlt(); }
}

fn cmd_malloc() -> void {
    con_putc(10);
    // "Heap test: allocating 64 bytes..."
    con_putc(72); con_putc(101); con_putc(97); con_putc(112); con_putc(32);
    con_putc(116); con_putc(101); con_putc(115); con_putc(116); con_putc(58);
    con_putc(32); con_putc(97); con_putc(108); con_putc(108); con_putc(111); con_putc(99);
    con_putc(32); con_putc(54); con_putc(52); con_putc(32); con_putc(98); con_putc(121); con_putc(116); con_putc(101); con_putc(115);
    con_putc(10);
    // Allocate 64 bytes using p_malloc
    var ptr: i64 = p_malloc(64);
    // "ptr = "
    con_putc(112); con_putc(116); con_putc(114); con_putc(32); con_putc(61); con_putc(32);
    print_hex(ptr);
    con_putc(10);
    // Write test pattern: 0x41 at first byte
    p_mem_write8(ptr, 65);
    // Read it back
    var val: i64 = p_mem_read8(ptr);
    // "val = "
    con_putc(118); con_putc(97); con_putc(108); con_putc(32); con_putc(61); con_putc(32);
    con_putc(val);
    con_putc(10);
    // Allocate another 128 bytes
    var ptr2: i64 = p_malloc(128);
    con_putc(112); con_putc(116); con_putc(114); con_putc(50); con_putc(32); con_putc(61); con_putc(32);
    print_hex(ptr2);
    con_putc(10);
    // "OK"
    con_putc(79); con_putc(75);
    con_putc(10);
}

// ─── ATA/PIO Disk I/O ────────────────────────────────────────────────────
// Read one 512-byte sector from the primary ATA disk via PIO.
// buf must be at least 512 bytes. Returns 0 on success, -1 on error.
fn ata_read_sector(lba: i64, buf: i64) -> i64 {
    // Wait for BSY to clear
    var timeout: i64 = 100000;
    while timeout > 0 {
        var status: i64 = p_inb(0x1F7);
        if (status & 0x80) == 0 { break; }
        timeout = timeout - 1;
    }
    if timeout == 0 { return -1; }

    // Select drive (LBA mode, drive 0)
    p_outb(0x1F6, 0xE0 | ((lba >> 24) & 0x0F));
    // Set sector count = 1
    p_outb(0x1F2, 1);
    // Set LBA low/mid/high
    p_outb(0x1F3, lba & 0xFF);
    p_outb(0x1F4, (lba >> 8) & 0xFF);
    p_outb(0x1F5, (lba >> 16) & 0xFF);
    // Send READ SECTORS command (0x20)
    p_outb(0x1F7, 0x20);

    // Wait for DRQ (data ready)
    timeout = 100000;
    while timeout > 0 {
        var status: i64 = p_inb(0x1F7);
        if (status & 0x08) != 0 { break; }
        if (status & 0x01) != 0 { return -1; }  // error
        timeout = timeout - 1;
    }
    if timeout == 0 { return -1; }

    // Read 256 16-bit words (512 bytes)
    var i: i64 = 0;
    while i < 256 {
        var word: i64 = p_inw(0x1F0);
        p_mem_write8(buf + i * 2, word & 0xFF);
        p_mem_write8(buf + i * 2 + 1, (word >> 8) & 0xFF);
        i = i + 1;
    }
    return 0;
}

// Write one 512-byte sector to the primary ATA disk via PIO.
fn ata_write_sector(lba: i64, buf: i64) -> i64 {
    var timeout: i64 = 100000;
    while timeout > 0 {
        var status: i64 = p_inb(0x1F7);
        if (status & 0x80) == 0 { break; }
        timeout = timeout - 1;
    }
    if timeout == 0 { return -1; }

    p_outb(0x1F6, 0xE0 | ((lba >> 24) & 0x0F));
    p_outb(0x1F2, 1);
    p_outb(0x1F3, lba & 0xFF);
    p_outb(0x1F4, (lba >> 8) & 0xFF);
    p_outb(0x1F5, (lba >> 16) & 0xFF);
    p_outb(0x1F7, 0x30);  // WRITE SECTORS

    timeout = 100000;
    while timeout > 0 {
        var status: i64 = p_inb(0x1F7);
        if (status & 0x08) != 0 { break; }
        if (status & 0x01) != 0 { return -1; }
        timeout = timeout - 1;
    }
    if timeout == 0 { return -1; }

    var i: i64 = 0;
    while i < 256 {
        var lo: i64 = p_mem_read8(buf + i * 2);
        var hi: i64 = p_mem_read8(buf + i * 2 + 1);
        p_outw(0x1F0, lo | (hi << 8));
        i = i + 1;
    }
    // Flush cache
    p_outb(0x1F7, 0xE7);
    return 0;
}

// ─── FAT32 Filesystem ──────────────────────────────────────────────────
// Simplified FAT32 reader/writer.
// Assumes: disk starts at sector 0, partition 0 is FAT32.
// BPB (BIOS Parameter Block) at sector 0, offset 0x0B.
// FAT starts at reserved_sectors. Data starts after FAT.

const FAT32_BUF: i64 = 0x40000;     // sector buffer for FS operations
const FAT_ROOT_CLUSTER: i64 = 2;    // FAT32 root dir starts at cluster 2

// FAT32 state (stored at 0x41000, each field is 4 bytes)
const FAT_STATE_ADDR: i64 = 0x41000;
const FAT_BYTES_PER_SECTOR: i64 = 0x41000;  // offset 0 (4 bytes)
const FAT_SECTORS_PER_CLUSTER: i64 = 0x41004; // offset 4 (4 bytes)
const FAT_RESERVED_SECTORS: i64 = 0x41008;  // offset 8 (4 bytes)
const FAT_NUM_FATS: i64 = 0x4100C;          // offset 12 (4 bytes)
const FAT_SECTORS_PER_FAT: i64 = 0x41010;   // offset 16 (4 bytes)
const FAT_FIRST_DATA_SECTOR: i64 = 0x41014; // offset 20 (4 bytes)
const FAT_INITIALIZED: i64 = 0x41018;       // offset 24 (1 byte)

// Initialize FAT32 by reading BPB from sector 0
fn fat32_init() -> i64 {
    var result: i64 = ata_read_sector(0, FAT32_BUF);
    if result != 0 { return -1; }

    // Read BPB fields (little-endian)
    var bps: i64 = p_mem_read8(FAT32_BUF + 11) | (p_mem_read8(FAT32_BUF + 12) << 8);
    var spc: i64 = p_mem_read8(FAT32_BUF + 13);
    var reserved: i64 = p_mem_read8(FAT32_BUF + 14) | (p_mem_read8(FAT32_BUF + 15) << 8);
    var num_fats: i64 = p_mem_read8(FAT32_BUF + 16);
    // sectors_per_fat32 at offset 36 (4 bytes)
    var spf: i64 = p_mem_read8(FAT32_BUF + 36) | (p_mem_read8(FAT32_BUF + 37) << 8) |
                    (p_mem_read8(FAT32_BUF + 38) << 16) | (p_mem_read8(FAT32_BUF + 39) << 24);

    p_mem_write32(FAT_BYTES_PER_SECTOR, bps);
    p_mem_write32(FAT_SECTORS_PER_CLUSTER, spc);
    p_mem_write32(FAT_RESERVED_SECTORS, reserved);
    p_mem_write32(FAT_NUM_FATS, num_fats);
    p_mem_write32(FAT_SECTORS_PER_FAT, spf);

    // first_data_sector = reserved + num_fats * sectors_per_fat
    var first_data: i64 = reserved + num_fats * spf;
    p_mem_write32(FAT_FIRST_DATA_SECTOR, first_data);
    p_mem_write8(FAT_INITIALIZED, 1);

    return 0;
}

// Convert cluster number to starting sector
fn fat32_cluster_to_sector(cluster: i64) -> i64 {
    var first_data: i64 = p_mem_read32(FAT_FIRST_DATA_SECTOR);
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    return (cluster - 2) * spc + first_data;
}

// Read FAT entry for a cluster (returns next cluster or 0xFFFFFFFF for end)
fn fat32_read_fat(cluster: i64) -> i64 {
    var bps: i64 = p_mem_read32(FAT_BYTES_PER_SECTOR);
    var reserved: i64 = p_mem_read32(FAT_RESERVED_SECTORS);
    // FAT entry offset = cluster * 4 bytes
    var fat_offset: i64 = cluster * 4;
    var fat_sector: i64 = reserved + (fat_offset / bps);
    var entry_offset: i64 = fat_offset % bps;

    var result: i64 = ata_read_sector(fat_sector, FAT32_BUF);
    if result != 0 { return 0xFFFFFFFF; }

    var entry: i64 = p_mem_read8(FAT32_BUF + entry_offset) |
                     (p_mem_read8(FAT32_BUF + entry_offset + 1) << 8) |
                     (p_mem_read8(FAT32_BUF + entry_offset + 2) << 16) |
                     (p_mem_read8(FAT32_BUF + entry_offset + 3) << 24);
    return entry & 0x0FFFFFFF;
}

// Read a cluster into a buffer
fn fat32_read_cluster(cluster: i64, buf: i64) -> i64 {
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    var sector: i64 = fat32_cluster_to_sector(cluster);
    var i: i64 = 0;
    while i < spc {
        var result: i64 = ata_read_sector(sector + i, buf + i * 512);
        if result != 0 { return -1; }
        i = i + 1;
    }
    return 0;
}

// Directory entry structure (32 bytes):
// [0-10] name (8.3, space-padded)
// [11]   attributes
// [12]   reserved
// [20-21] cluster high
// [26-27] cluster low
// [28-31] file size

// List files in root directory
fn cmd_ls() -> void {
    con_putc(10);
    if p_mem_read8(FAT_INITIALIZED) != 1 {
        con_putc(70); con_putc(83); con_putc(32); con_putc(110); con_putc(111); con_putc(116); con_putc(32); con_putc(105); con_putc(110); con_putc(105); con_putc(116); // "FS not init"
        con_putc(10);
        return;
    }

    var cluster: i64 = FAT_ROOT_CLUSTER;
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    var cluster_size: i64 = spc * 512;

    while cluster < 0x0FFFFFF8 {
        var result: i64 = fat32_read_cluster(cluster, FAT32_BUF);
        if result != 0 {
            con_putc(82); con_putc(101); con_putc(97); con_putc(100); con_putc(32); con_putc(101); con_putc(114); con_putc(114); // "Read err"
            con_putc(10);
            return;
        }

        var offset: i64 = 0;
        while offset < cluster_size {
            var first_byte: i64 = p_mem_read8(FAT32_BUF + offset);
            if first_byte == 0 { break; }  // end of directory
            if first_byte != 0xE5 {  // not deleted
                var attr: i64 = p_mem_read8(FAT32_BUF + offset + 11);
                if (attr & 0x0F) != 0x0F {  // not LFN entry
                    // Print name (8.3)
                    var i: i64 = 0;
                    while i < 11 {
                        var c: i64 = p_mem_read8(FAT32_BUF + offset + i);
                        if c != 32 { con_putc(c); }
                        if i == 7 && p_mem_read8(FAT32_BUF + offset + 8) != 32 {
                            con_putc(46);  // '.'
                        }
                        i = i + 1;
                    }
                    con_putc(32);
                    // Print size (simple, no division)
                    var size: i64 = p_mem_read8(FAT32_BUF + offset + 28) +
                                    (p_mem_read8(FAT32_BUF + offset + 29) * 256);
                    if size >= 100 {
                        con_putc(48 + size / 100);
                        con_putc(48 + (size / 10) % 10);
                        con_putc(48 + size % 10);
                    } else if size >= 10 {
                        con_putc(48 + size / 10);
                        con_putc(48 + size % 10);
                    } else {
                        con_putc(48 + size);
                    }
                    con_putc(32); con_putc(66);  // " B"
                    if (attr & 0x10) != 0 {
                        con_putc(32); con_putc(60); con_putc(68); con_putc(73); con_putc(82); con_putc(62);  // " <DIR>"
                    }
                    con_putc(10);
                }
            }
            offset = offset + 32;
        }

        cluster = fat32_read_fat(cluster);
    }
}

// Find a file in root directory by 8.3 name.
// Returns cluster number if found, 0 if not found.
// Sets file_size_out to the file size.
fn fat32_find_file(name_addr: i64, name_len: i64, file_size_out: i64) -> i64 {
    if p_mem_read8(FAT_INITIALIZED) != 1 { return 0; }

    var cluster: i64 = FAT_ROOT_CLUSTER;
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    var cluster_size: i64 = spc * 512;

    while cluster < 0x0FFFFFF8 {
        var result: i64 = fat32_read_cluster(cluster, FAT32_BUF);
        if result != 0 { return 0; }

        var offset: i64 = 0;
        while offset < cluster_size {
            var first_byte: i64 = p_mem_read8(FAT32_BUF + offset);
            if first_byte == 0 { return 0; }  // end of directory
            if first_byte != 0xE5 {
                var attr: i64 = p_mem_read8(FAT32_BUF + offset + 11);
                if (attr & 0x0F) != 0x0F {
                    // Convert input filename to 8.3 format at 0x41040
                    // First, fill with spaces
                    var k: i64 = 0;
                    while k < 11 {
                        p_mem_write8(0x41040 + k, 32);
                        k = k + 1;
                    }
                    // Copy name part (before '.') to positions 0-7
                    var in_idx: i64 = 0;
                    var out_idx: i64 = 0;
                    var saw_dot: i64 = 0;
                    while in_idx < name_len {
                        var c: i64 = p_mem_read8(name_addr + in_idx);
                        // Uppercase
                        if c >= 97 && c <= 122 { c = c - 32; }
                        if c == 46 {  // '.'
                            saw_dot = 1;
                            out_idx = 8;  // extension starts at position 8
                        } else {
                            if saw_dot == 0 && out_idx < 8 {
                                p_mem_write8(0x41040 + out_idx, c);
                                out_idx = out_idx + 1;
                            } else if saw_dot == 1 && out_idx < 11 {
                                p_mem_write8(0x41040 + out_idx, c);
                                out_idx = out_idx + 1;
                            }
                        }
                        in_idx = in_idx + 1;
                    }
                    // Compare 11 bytes
                    var is_match: i64 = 1;
                    var i: i64 = 0;
                    while i < 11 {
                        var disk_c: i64 = p_mem_read8(FAT32_BUF + offset + i);
                        var input_c: i64 = p_mem_read8(0x41040 + i);
                        if disk_c != input_c {
                            is_match = 0;
                            i = 11;
                        }
                        i = i + 1;
                    }
                    if is_match == 1 {
                        var clus: i64 = p_mem_read8(FAT32_BUF + offset + 26) +
                                       (p_mem_read8(FAT32_BUF + offset + 27) * 256);
                        var sz: i64 = p_mem_read8(FAT32_BUF + offset + 28) +
                                     (p_mem_read8(FAT32_BUF + offset + 29) * 256);
                        p_mem_write8(file_size_out, sz);
                        return clus;
                    }
                }
            }
            offset = offset + 32;
        }
        cluster = fat32_read_fat(cluster);
    }
    return 0;
}

// Read file contents by cluster chain into a buffer
fn fat32_read_file(cluster: i64, buf: i64, max_size: i64) -> i64 {
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    var cluster_size: i64 = spc * 512;
    var total: i64 = 0;

    while cluster < 0x0FFFFFF8 && total < max_size {
        var result: i64 = fat32_read_cluster(cluster, buf + total);
        if result != 0 { return total; }
        total = total + cluster_size;
        if total > max_size { total = max_size; }
        cluster = fat32_read_fat(cluster);
    }
    return total;
}

// ─── Initrd Ramdisk (VFS) ────────────────────────────────────────────────
// Simple ramdisk loaded from disk sector 10.
// Format: u32 num_entries, then per-entry: u32 name_len, name, u32 type, u64 size, u64 offset
// File data follows the header.
const INITRD_SECTOR: i64 = 10;
const INITRD_BUF: i64 = 0x140000;   // 1.25MB: ramdisk loaded here (above kernel)
const INITRD_LOADED: i64 = 0x695;   // 1 byte flag
const INITRD_NUM_ENTRIES: i64 = 0x696; // 4 bytes

fn initrd_load() -> i64 {
    var result: i64 = ata_read_sector(INITRD_SECTOR, INITRD_BUF);
    if result != 0 { return -1; }
    var num: i64 = p_mem_read32(INITRD_BUF);
    p_mem_write8(INITRD_LOADED, 1);
    p_mem_write32(INITRD_NUM_ENTRIES, num);
    return num;
}

fn initrd_num_entries() -> i64 {
    if p_mem_read8(INITRD_LOADED) != 1 { return 0; }
    return p_mem_read32(INITRD_NUM_ENTRIES);
}

// Get entry header offset by index
fn initrd_entry_offset(index: i64) -> i64 {
    // Skip u32 num_entries (4 bytes), then iterate to find the index-th entry
    var offset: i64 = 4;
    var i: i64 = 0;
    while i < index {
        var name_len: i64 = p_mem_read32(INITRD_BUF + offset);
        offset = offset + 4 + name_len + 4 + 8 + 8; // name_len + name + type + size + data_offset
        i = i + 1;
    }
    return offset;
}

// Get entry name by index (writes to a buffer, returns length)
fn initrd_get_name(index: i64, buf: i64) -> i64 {
    var off: i64 = initrd_entry_offset(index);
    var name_len: i64 = p_mem_read32(INITRD_BUF + off);
    var i: i64 = 0;
    while i < name_len {
        p_mem_write8(buf + i, p_mem_read8(INITRD_BUF + off + 4 + i));
        i = i + 1;
    }
    return name_len;
}

// Get entry size by index
fn initrd_get_size(index: i64) -> i64 {
    var off: i64 = initrd_entry_offset(index);
    var name_len: i64 = p_mem_read32(INITRD_BUF + off);
    // size is at off + 4 + name_len + 4
    var size_off: i64 = off + 4 + name_len + 4;
    return p_mem_read64(INITRD_BUF + size_off);
}

// Get entry data offset by index
fn initrd_get_data_offset(index: i64) -> i64 {
    var off: i64 = initrd_entry_offset(index);
    var name_len: i64 = p_mem_read32(INITRD_BUF + off);
    // data_offset is at off + 4 + name_len + 4 + 8
    var doff: i64 = off + 4 + name_len + 4 + 8;
    return p_mem_read64(INITRD_BUF + doff);
}

// Find file by name (returns index or -1)
fn initrd_find(name_addr: i64, name_len: i64) -> i64 {
    var num: i64 = initrd_num_entries();
    var i: i64 = 0;
    while i < num {
        var entry_name_len: i64 = initrd_get_name(i, INPUT_BUF_ADDR + 256);
        if entry_name_len == name_len {
            var is_match: i64 = 1;
            var j: i64 = 0;
            while j < name_len {
                if p_mem_read8(INPUT_BUF_ADDR + 256 + j) != p_mem_read8(name_addr + j) {
                    is_match = 0;
                }
                j = j + 1;
            }
            if is_match == 1 { return i; }
        }
        i = i + 1;
    }
    return -1;
}

// List initrd files
fn cmd_initrd_ls() -> void {
    con_putc(10);
    if p_mem_read8(INITRD_LOADED) != 1 {
        con_putc(78); con_putc(111); con_putc(32); con_putc(105); con_putc(110); con_putc(105); con_putc(116); con_putc(114); con_putc(100); // "No initrd"
        con_putc(10);
        return;
    }
    var num: i64 = initrd_num_entries();
    var i: i64 = 0;
    while i < num {
        var name_len: i64 = initrd_get_name(i, INPUT_BUF_ADDR + 256);
        var j: i64 = 0;
        while j < name_len {
            con_putc(p_mem_read8(INPUT_BUF_ADDR + 256 + j));
            j = j + 1;
        }
        con_putc(32);
        var size: i64 = initrd_get_size(i);
        print_dec(size);
        con_putc(32); con_putc(66); // " B"
        con_putc(10);
        i = i + 1;
    }
}

// Cat a file from initrd
fn cmd_initrd_cat(name_addr: i64, name_len: i64) -> void {
    con_putc(10);
    if p_mem_read8(INITRD_LOADED) != 1 {
        con_putc(78); con_putc(111); con_putc(32); con_putc(105); con_putc(110); con_putc(105); con_putc(116); con_putc(114); con_putc(100); // "No initrd"
        con_putc(10);
        return;
    }
    var idx: i64 = initrd_find(name_addr, name_len);
    if idx < 0 {
        con_putc(78); con_putc(111); con_putc(116); con_putc(32); con_putc(102); con_putc(111); con_putc(117); con_putc(110); con_putc(100); // "Not found"
        con_putc(10);
        return;
    }
    var size: i64 = initrd_get_size(idx);
    var doff: i64 = initrd_get_data_offset(idx);
    var i: i64 = 0;
    while i < size {
        con_putc(p_mem_read8(INITRD_BUF + doff + i));
        i = i + 1;
    }
    con_putc(10);
}

// ─── PCI Bus Enumeration (G10) ────────────────────────────────────────────
// PCI config space access via ports 0xCF8 (address) and 0xCFC (data)
const PCI_ADDR: i64 = 0xCF8;
const PCI_DATA: i64 = 0xCFC;

fn pci_config_read(bus: i64, dev: i64, func: i64, offset: i64) -> i64 {
    // Enable bit 31, bus 23-16, dev 15-11, func 10-8, offset 7-2
    var addr: i64 = (1 << 31) | (bus << 16) | (dev << 11) | (func << 8) | (offset & 0xFC);
    p_outl(PCI_ADDR, addr);
    return p_inl(PCI_DATA);
}

fn pci_config_write(bus: i64, dev: i64, func: i64, offset: i64, val: i64) {
    var addr: i64 = (1 << 31) | (bus << 16) | (dev << 11) | (func << 8) | (offset & 0xFC);
    p_outl(PCI_ADDR, addr);
    p_outl(PCI_DATA, val);
}

fn pci_get_vendor(bus: i64, dev: i64, func: i64) -> i64 {
    return pci_config_read(bus, dev, func, 0) & 0xFFFF;
}

fn pci_get_device(bus: i64, dev: i64, func: i64) -> i64 {
    return (pci_config_read(bus, dev, func, 0) >> 16) & 0xFFFF;
}

fn pci_get_class(bus: i64, dev: i64, func: i64) -> i64 {
    return (pci_config_read(bus, dev, func, 8) >> 24) & 0xFF;
}

fn pci_get_subclass(bus: i64, dev: i64, func: i64) -> i64 {
    return (pci_config_read(bus, dev, func, 8) >> 16) & 0xFF;
}

// PCI device table at 0x150000 (up to 256 entries × 16 bytes)
const PCI_TABLE: i64 = 0x150000;
var pci_device_count: i64 = 0;

fn pci_scan() -> i64 {
    pci_device_count = 0;
    var bus: i64 = 0;
    while bus < 256 {
        var dev: i64 = 0;
        while dev < 32 {
            var func: i64 = 0;
            while func < 8 {
                var vendor: i64 = pci_get_vendor(bus, dev, func);
                if vendor != 0xFFFF {
                    var device: i64 = pci_get_device(bus, dev, func);
                    var class_code: i64 = pci_get_class(bus, dev, func);
                    var subclass: i64 = pci_get_subclass(bus, dev, func);
                    // Store in table: vendor, device, class, subclass
                    var idx: i64 = pci_device_count * 16;
                    p_mem_write64(PCI_TABLE + idx, vendor);
                    p_mem_write64(PCI_TABLE + idx + 8, (device << 48) | (class_code << 40) | (subclass << 32) | (bus << 16) | (dev << 8) | func);
                    pci_device_count = pci_device_count + 1;
                    if pci_device_count >= 256 { return pci_device_count; }
                }
                func = func + 1;
            }
            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return pci_device_count;
}

fn cmd_pci() -> void {
    con_putc(10);
    // "PCI Devices:"
    con_putc(80); con_putc(67); con_putc(73); con_putc(32); con_putc(68); con_putc(101); con_putc(118); con_putc(105); con_putc(99); con_putc(101); con_putc(115); con_putc(58);
    con_putc(10);
    var i: i64 = 0;
    while i < pci_device_count {
        var idx: i64 = i * 16;
        var vendor: i64 = p_mem_read64(PCI_TABLE + idx);
        var packed_val: i64 = p_mem_read64(PCI_TABLE + idx + 8);
        var device: i64 = (packed_val >> 48) & 0xFFFF;
        var class_code: i64 = (packed_val >> 40) & 0xFF;
        var bus: i64 = (packed_val >> 16) & 0xFF;
        var dev: i64 = (packed_val >> 8) & 0xFF;
        var func: i64 = packed_val & 0xFF;
        // Print bus:dev.func vendor:device class
        print_dec(bus); con_putc(58); print_dec(dev); con_putc(46); print_dec(func);
        con_putc(32);
        con_putc(118); con_putc(101); con_putc(110); con_putc(100); con_putc(111); con_putc(114); con_putc(58); // "vendor:"
        con_putc(32);
        print_hex(vendor);
        con_putc(32);
        con_putc(100); con_putc(101); con_putc(118); con_putc(58); // "dev:"
        con_putc(32);
        print_hex(device);
        con_putc(32);
        con_putc(99); con_putc(108); con_putc(115); con_putc(58); // "cls:"
        con_putc(32);
        print_hex(class_code);
        con_putc(10);
        i = i + 1;
    }
    if pci_device_count == 0 {
        con_putc(78); con_putc(111); con_putc(110); con_putc(101); // "None"
        con_putc(10);
    }
}

// ─── ACPI Power Management (G15) ──────────────────────────────────────────
// QEMU ACPI shutdown port is already used by cmd_poweroff.
// Add ACPI reset and PM status.

fn acpi_init() -> void {
    // In a real OS, we'd parse ACPI tables via RSDP.
    // For QEMU, the PM ports are fixed:
    //   PM1a_CNT = 0x604 (QEMU)
    //   PM1b_CNT = 0xB004 (older QEMU)
    //   Reset    = 0x604 with bit 6 set
    // Just verify ports are accessible — nothing to init for QEMU.
}

fn cmd_acpi() -> void {
    con_putc(10);
    // "ACPI: QEMU PM ports"
    con_putc(65); con_putc(67); con_putc(80); con_putc(73); con_putc(58); con_putc(32);
    con_putc(81); con_putc(69); con_putc(77); con_putc(85); con_putc(32); con_putc(80); con_putc(77);
    con_putc(10);
    // "  poweroff - S5 (ACPI shutdown)"
    con_putc(32); con_putc(32);
    con_putc(112); con_putc(111); con_putc(119); con_putc(101); con_putc(114); con_putc(111); con_putc(102); con_putc(102);
    con_putc(32); con_putc(45); con_putc(32); con_putc(83); con_putc(53);
    con_putc(10);
    // "  reset    - ACPI reset (port 0x604)"
    con_putc(32); con_putc(32);
    con_putc(114); con_putc(101); con_putc(115); con_putc(101); con_putc(116);
    con_putc(32); con_putc(45); con_putc(32); con_putc(65); con_putc(67); con_putc(80); con_putc(73);
    con_putc(10);
}

fn cmd_acpi_reset() -> void {
    con_putc(10);
    // "ACPI reset..."
    con_putc(65); con_putc(67); con_putc(80); con_putc(73); con_putc(32); con_putc(114); con_putc(101); con_putc(115); con_putc(101); con_putc(116);
    con_putc(10);
    // ACPI reset: write 0x06 to PM1 control register (bit 6 = reset)
    p_outw(0x604, 0x06);
    // Fallback: keyboard controller reset
    p_outb(0x64, 0xFE);
    p_cli();
    while true { p_hlt(); }
}

// ─── Kernel Heap with Free (G18) ──────────────────────────────────────────
// Heap starts at 0x300000. Free list stored in freed blocks.
// Each allocation: [size:8][data...]
// Free list: singly linked, address stored in first 8 bytes of freed block.

const HEAP_START: i64 = 0x300000;
const HEAP_END:   i64 = 0x400000;  // 1MB heap
var heap_next: i64 = 0x300000;
var heap_free_list: i64 = 0;  // head of free list (0 = empty)

fn heap_init() {
    heap_next = HEAP_START;
    heap_free_list = 0;
}

fn heap_alloc(size: i64) -> i64 {
    // Try free list first (first-fit)
    var prev: i64 = 0;
    var cur: i64 = heap_free_list;
    while cur != 0 {
        var block_size: i64 = p_mem_read64(cur);  // size includes header
        if block_size >= size + 8 {
            // Found a fit — remove from free list
            var next_free: i64 = p_mem_read64(cur + 8);
            if prev == 0 {
                heap_free_list = next_free;
            } else {
                p_mem_write64(prev + 8, next_free);
            }
            return cur + 8;  // return data pointer (past size header)
        }
        prev = cur;
        cur = p_mem_read64(cur + 8);
    }
    // Bump allocate
    if heap_next + size + 8 > HEAP_END { return 0; }
    p_mem_write64(heap_next, size + 8);  // store block size
    var ptr: i64 = heap_next + 8;
    heap_next = heap_next + size + 8;
    // Align to 8 bytes
    while heap_next % 8 != 0 { heap_next = heap_next + 1; }
    return ptr;
}

fn heap_free(ptr: i64) {
    if ptr == 0 { return; }
    var block_start: i64 = ptr - 8;
    // Add to free list head
    p_mem_write64(block_start + 8, heap_free_list);
    heap_free_list = block_start;
}

// ─── Virtual Memory Mapping API (G19) ─────────────────────────────────────
// Kernel PML4 at 0x70000, PDPT at 0x71000
// vm_map maps a virtual address to a physical address in kernel page tables.

fn vm_map(vaddr: i64, paddr: i64, flags: i64) -> i64 {
    // PML4 index = bits 39-47
    var pml4_idx: i64 = (vaddr >> 39) & 0x1FF;
    // PDPT index = bits 30-38
    var pdpt_idx: i64 = (vaddr >> 30) & 0x1FF;
    // PD index = bits 21-29
    var pd_idx: i64 = (vaddr >> 21) & 0x1FF;

    // Get PML4 entry
    var pml4_entry: i64 = p_mem_read64(0x70000 + pml4_idx * 8);
    var pdpt_addr: i64 = pml4_entry & 0xFFFFFFFFFFFFF000;  // mask flags
    if pdpt_addr == 0 {
        // Allocate a new PDPT
        pdpt_addr = 0x74000;  // Use fixed address for new PDPT
        var i: i64 = 0;
        while i < 4096 {
            p_mem_write8(pdpt_addr + i, 0);
            i = i + 1;
        }
        p_mem_write64(0x70000 + pml4_idx * 8, pdpt_addr | 0x3);
    }

    // Get PDPT entry — check if it's a 1GB huge page (PS bit = 0x80)
    var pdpt_entry: i64 = p_mem_read64(pdpt_addr + pdpt_idx * 8);
    if (pdpt_entry & 0x80) != 0 {
        // It's a 1GB huge page — need to split into a PD with 512 2MB entries
        // Use a fixed address in the heap area for the new PD
        var pd_addr: i64 = 0x310000 + pdpt_idx * 0x1000;
        var phys_base: i64 = pdpt_entry & 0xFFFFFFFFFFE00000;  // 1GB aligned physical
        var i: i64 = 0;
        while i < 512 {
            // Each 2MB entry: present | writable | huge | (user if original had it)
            var entry_flags: i64 = 0x83;
            if (pdpt_entry & 0x04) != 0 { entry_flags = entry_flags | 0x04; }  // user bit
            p_mem_write64(pd_addr + i * 8, (phys_base + i * 0x200000) | entry_flags);
            i = i + 1;
        }
        // Replace PDPT entry: clear PS bit, point to new PD
        var pdpt_flags: i64 = pdpt_entry & 0x7;  // keep present/writable/user
        p_mem_write64(pdpt_addr + pdpt_idx * 8, pd_addr | pdpt_flags);
        pdpt_entry = p_mem_read64(pdpt_addr + pdpt_idx * 8);
    }

    var pd_addr: i64 = pdpt_entry & 0xFFFFFFFFFFFFF000;
    if pd_addr == 0 {
        pd_addr = 0x310000 + pdpt_idx * 0x1000;
        var i: i64 = 0;
        while i < 4096 {
            p_mem_write8(pd_addr + i, 0);
            i = i + 1;
        }
        p_mem_write64(pdpt_addr + pdpt_idx * 8, pd_addr | 0x3);
    }

    // Set PD entry as 2MB page (PS bit = 0x80)
    // Present | Writable | PS | flags
    var pd_flags: i64 = 0x83 | (flags & 0x7F);
    p_mem_write64(pd_addr + pd_idx * 8, (paddr & 0xFFFFFFFFFFE00000) | pd_flags);

    // Flush TLB for this address
    p_invlpg(vaddr);
    return 0;
}

fn vm_unmap(vaddr: i64) -> i64 {
    var pml4_idx: i64 = (vaddr >> 39) & 0x1FF;
    var pdpt_idx: i64 = (vaddr >> 30) & 0x1FF;
    var pd_idx: i64 = (vaddr >> 21) & 0x1FF;

    var pml4_entry: i64 = p_mem_read64(0x70000 + pml4_idx * 8);
    var pdpt_addr: i64 = pml4_entry & 0xFFFFFFFFFFFFF000;
    if pdpt_addr == 0 { return -1; }

    var pdpt_entry: i64 = p_mem_read64(pdpt_addr + pdpt_idx * 8);
    var pd_addr: i64 = pdpt_entry & 0xFFFFFFFFFFFFF000;
    if pd_addr == 0 { return -1; }

    // Clear the PD entry
    p_mem_write64(pd_addr + pd_idx * 8, 0);
    p_invlpg(vaddr);
    return 0;
}

fn cmd_vm() -> void {
    con_putc(10);
    // "VM: verify mapping 0x800000"
    con_putc(86); con_putc(77); con_putc(58); con_putc(32);
    con_putc(118); con_putc(101); con_putc(114); con_putc(105); con_putc(102); con_putc(121);
    con_putc(10);
    // Test read/write to an already-mapped address (first 1GB is identity-mapped)
    p_mem_write64(0x800000, 0xDEADBEEF);
    var val: i64 = p_mem_read64(0x800000);
    con_putc(79); con_putc(75); con_putc(32); // "OK "
    print_hex(val);
    con_putc(10);
    // Show CR3 (page table base)
    con_putc(67); con_putc(82); con_putc(51); con_putc(58); con_putc(32); // "CR3: "
    print_hex(p_cr3_read());
    con_putc(10);
}

// ─── PS/2 Mouse Input (G13) ───────────────────────────────────────────────
// Mouse uses IRQ12 (vector 0x2C after PIC remap), port 0x60 data, 0x64 status.
// Mouse state at 0x6A0: [x:1, y:1, buttons:1, cycle:1, dx:1, dy:1]
const MOUSE_STATE: i64 = 0x6A0;

fn mouse_init() -> i64 {
    // Enable auxiliary device (mouse) on PS/2 controller
    // outb(0x64, 0xA8) — enable second port
    p_outb(0x64, 0xA8);

    // Read current controller config
    p_outb(0x64, 0x20);
    var config: i64 = p_inb(0x60);
    // Set bit 1 (enable IRQ12) and bit 5 (enable auxiliary clock)
    config = config | 0x02 | 0x20;
    p_outb(0x64, 0x60);
    p_outb(0x60, config);

    // Set defaults on mouse
    p_outb(0x64, 0xD4);  // send to mouse
    p_outb(0x60, 0xF6);  // set defaults
    var ack: i64 = p_inb(0x60);  // read ACK (0xFA)

    // Enable data reporting
    p_outb(0x64, 0xD4);
    p_outb(0x60, 0xF4);  // enable reporting
    ack = p_inb(0x60);  // read ACK

    // Initialize state
    p_mem_write8(MOUSE_STATE, 0);      // x
    p_mem_write8(MOUSE_STATE + 1, 0);  // y
    p_mem_write8(MOUSE_STATE + 2, 0);  // buttons
    p_mem_write8(MOUSE_STATE + 3, 0);  // cycle

    return 0;
}

// IRQ12 mouse handler (vector 0x2C)
@interrupt(0x2C) fn irq12_mouse_handler() -> void {
    var data: i64 = p_inb(0x60);
    var cycle: i64 = p_mem_read8(MOUSE_STATE + 3);

    if cycle == 0 {
        // Byte 1: buttons and sign bits
        p_mem_write8(MOUSE_STATE + 2, data & 0x07);  // buttons
        p_mem_write8(MOUSE_STATE + 4, (data >> 4) & 0x01);  // x sign
        p_mem_write8(MOUSE_STATE + 5, (data >> 5) & 0x01);  // y sign
        cycle = 1;
    } else if cycle == 1 {
        // Byte 2: x movement
        p_mem_write8(MOUSE_STATE, data);
        cycle = 2;
    } else {
        // Byte 3: y movement
        p_mem_write8(MOUSE_STATE + 1, data);
        cycle = 0;
    }
    p_mem_write8(MOUSE_STATE + 3, cycle);

    // Send EOI to both PICs (IRQ12 is on slave)
    p_outb(0xA0, 0x20);  // EOI to slave
    p_outb(0x20, 0x20);  // EOI to master
}

fn cmd_mouse() -> void {
    con_putc(10);
    // "Mouse: "
    con_putc(77); con_putc(111); con_putc(117); con_putc(115); con_putc(101); con_putc(58); con_putc(32);
    var buttons: i64 = p_mem_read8(MOUSE_STATE + 2);
    var dx: i64 = p_mem_read8(MOUSE_STATE);
    var dy: i64 = p_mem_read8(MOUSE_STATE + 1);
    con_putc(98); con_putc(58); con_putc(32); // "b: "
    print_dec(buttons);
    con_putc(32);
    con_putc(120); con_putc(58); con_putc(32); // "x: "
    print_dec(dx);
    con_putc(32);
    con_putc(121); con_putc(58); con_putc(32); // "y: "
    print_dec(dy);
    con_putc(10);
}

// ─── APIC Timer (G9) ──────────────────────────────────────────────────────
// LAPIC registers are MMIO at 0xFEE00000.
// For QEMU, the LAPIC is at the default address.
const LAPIC_BASE: i64 = 0xFEE00000;
const LAPIC_EOI:  i64 = 0xFEE000B0;
const LAPIC_TPR:  i64 = 0xFEE00080;
const LAPIC_LVT_TIMER: i64 = 0xFEE00320;
const LAPIC_TIMER_INIT: i64 = 0xFEE00380;
const LAPIC_TIMER_CURRENT: i64 = 0xFEE00390;
const LAPIC_TIMER_DIV: i64 = 0xFEE003E0;

fn apic_write(reg: i64, val: i64) {
    p_mem_write32(reg, val);
}

fn apic_read(reg: i64) -> i64 {
    return p_mem_read32(reg);
}

fn apic_init() -> i64 {
    // Enable LAPIC by setting bit 8 of the Spurious Interrupt Vector Register
    // SIVR is at 0xFEE000F0
    apic_write(0xFEE000F0, 0x100 | 0xFF);  // Enable + vector 0xFF

    // Mask LVT timer for now
    apic_write(LAPIC_LVT_TIMER, 0x10000);  // masked

    // Set timer divide to 16 (0x3 = divide by 16)
    apic_write(LAPIC_TIMER_DIV, 0x3);

    // Set initial count
    apic_write(LAPIC_TIMER_INIT, 0x100000);

    return 0;
}

fn cmd_apic() -> void {
    con_putc(10);
    // "APIC: "
    con_putc(65); con_putc(80); con_putc(73); con_putc(67); con_putc(58); con_putc(32);
    var result: i64 = apic_init();
    if result == 0 {
        con_putc(105); con_putc(110); con_putc(105); con_putc(116); // "init"
        con_putc(32);
        con_putc(79); con_putc(75); // "OK"
    } else {
        con_putc(102); con_putc(97); con_putc(105); con_putc(108); // "fail"
    }
    con_putc(10);
    // Print timer current count
    var current: i64 = apic_read(LAPIC_TIMER_CURRENT);
    con_putc(99); con_putc(110); con_putc(116); con_putc(58); con_putc(32); // "cnt: "
    print_hex(current);
    con_putc(10);
}

fn cmd_cat(name_addr: i64, name_len: i64) -> void {
    con_putc(10);
    if p_mem_read8(FAT_INITIALIZED) != 1 {
        con_putc(70); con_putc(83); con_putc(32); con_putc(110); con_putc(111); con_putc(116); con_putc(32); con_putc(105); con_putc(110); con_putc(105); con_putc(116);
        con_putc(10);
        return;
    }

    var file_size: i64 = 0;
    var size_addr: i64 = 0x41020;  // temp storage for file size
    var cluster: i64 = fat32_find_file(name_addr, name_len, size_addr);
    if cluster == 0 {
        con_putc(78); con_putc(111); con_putc(116); con_putc(32); con_putc(102); con_putc(111); con_putc(117); con_putc(110); con_putc(100); // "Not found"
        con_putc(10);
        return;
    }

    file_size = p_mem_read8(size_addr);
    // Direct read: bypass fat32_read_file, read sector directly
    var sector: i64 = fat32_cluster_to_sector(cluster);
    var result: i64 = ata_read_sector(sector, FAT32_BUF);
    if result != 0 {
        con_putc(82); con_putc(101); con_putc(97); con_putc(100); con_putc(32); con_putc(101); con_putc(114); con_putc(114);
        con_putc(10);
        return;
    }

    // Print file contents
    var i: i64 = 0;
    while i < file_size {
        con_putc(p_mem_read8(FAT32_BUF + i));
        i = i + 1;
    }
    con_putc(10);
}

fn cmd_disk() -> void {
    con_putc(10);
    // "Disk: reading sector 0..."
    con_putc(68); con_putc(105); con_putc(115); con_putc(107); con_putc(58);
    con_putc(32); con_putc(114); con_putc(101); con_putc(97); con_putc(100);
    con_putc(105); con_putc(110); con_putc(103); con_putc(32);
    con_putc(115); con_putc(101); con_putc(99); con_putc(116); con_putc(111);
    con_putc(114); con_putc(32); con_putc(48); con_putc(46); con_putc(46); con_putc(46);
    con_putc(10);

    // Allocate 512 bytes for the sector
    var buf: i64 = p_malloc(512);
    if buf == 0 {
        // " alloc failed"
        con_putc(97); con_putc(108); con_putc(108); con_putc(111); con_putc(99);
        con_putc(32); con_putc(102); con_putc(97); con_putc(105); con_putc(108);
        con_putc(101); con_putc(100);
        con_putc(10);
        return;
    }

    var result: i64 = ata_read_sector(0, buf);
    if result != 0 {
        // " read failed"
        con_putc(114); con_putc(101); con_putc(97); con_putc(100);
        con_putc(32); con_putc(102); con_putc(97); con_putc(105); con_putc(108);
        con_putc(101); con_putc(100);
        con_putc(10);
        return;
    }

    // Show first 16 bytes in hex
    // "First 16 bytes: "
    con_putc(70); con_putc(105); con_putc(114); con_putc(115); con_putc(116);
    con_putc(32); con_putc(49); con_putc(54); con_putc(32);
    con_putc(98); con_putc(121); con_putc(116); con_putc(101); con_putc(115); con_putc(58);
    con_putc(10);
    var i: i64 = 0;
    while i < 16 {
        var b: i64 = p_mem_read8(buf + i);
        print_hex(b);
        con_putc(32);
        i = i + 1;
    }
    con_putc(10);

    // Check MBR signature (0x55AA at offset 510)
    var sig1: i64 = p_mem_read8(buf + 510);
    var sig2: i64 = p_mem_read8(buf + 511);
    // "MBR sig: "
    con_putc(77); con_putc(66); con_putc(82); con_putc(32);
    con_putc(115); con_putc(105); con_putc(103); con_putc(58); con_putc(32);
    print_hex(sig2);
    print_hex(sig1);
    con_putc(10);
    if sig1 == 0x55 && sig2 == 0xAA {
        // "Valid MBR"
        con_putc(86); con_putc(97); con_putc(108); con_putc(105); con_putc(100);
        con_putc(32); con_putc(77); con_putc(66); con_putc(82);
    } else {
        // "No MBR"
        con_putc(78); con_putc(111); con_putc(32); con_putc(77); con_putc(66); con_putc(82);
    }
    con_putc(10);
}

// ─── User-Mode Program Loading ──────────────────────────────────────────

// Syscall numbers
const SYS_EXIT: i64 = 0;
const SYS_WRITE: i64 = 1;
const SYS_READ: i64 = 2;
const SYS_GETPID: i64 = 3;
const SYS_YIELD: i64 = 4;

// Syscall dispatch — called by the assembly syscall handler.
// Args: syscall_num (RCX), arg1 (RDX), arg2 (R8), arg3 (R9)
// Returns 0 to continue user mode, non-zero to exit to kernel.
pub fn syscall_dispatch(syscall_num: i64, arg1: i64, arg2: i64, arg3: i64) -> i64 {
    // Syscall numbers:
    //   0 = sys_exit(exit_code)  — returns to kernel
    //   1 = sys_write(buf_ptr, len) — writes to VGA/serial, returns bytes written
    //   2 = sys_read(buf_ptr, len) — reads from keyboard (stub, returns 0)
    //   3 = sys_getpid() — returns PID
    //   4 = sys_yield() — yields CPU (stub, returns 0)

    if syscall_num == 0 {
        // sys_exit: print exit code, return to kernel
        con_putc(10);
        con_putc(69); con_putc(120); con_putc(105); con_putc(116); con_putc(40); // "Exit("
        print_hex(arg1);
        con_putc(41); con_putc(10); // ")"
        return 0; // return value doesn't matter; handler checks syscall_num==0
    }

    if syscall_num == 1 {
        // sys_write(buf_ptr, len): write string to VGA/serial
        var i: i64 = 0;
        while i < arg2 {
            con_putc(p_mem_read8(arg1 + i));
            i = i + 1;
        }
        return arg2; // return bytes written
    }

    if syscall_num == 2 {
        // sys_read(buf_ptr, len): read from keyboard buffer into user buffer
        // Reads one character at a time (blocking until a key is available)
        // Returns the number of bytes actually read (1 if a key was read, 0 on error)
        if arg2 <= 0 { return 0; }
        // Read one scancode from the keyboard buffer (blocks until key pressed)
        var sc: i64 = kbd_read_scancode();
        var ch: i64 = scancode_to_ascii(sc);
        if ch < 0 { return 0; }
        // Write the character to the user buffer
        p_mem_write8(arg1, ch);
        return 1;
    }

    if syscall_num == 3 {
        // sys_getpid: return PID (always 1 for now)
        return 1;
    }

    if syscall_num == 4 {
        // sys_yield: stub — no scheduler yet
        return 0;
    }

    if syscall_num == 9 {
        // sys_mmap(addr, length, prot, flags, fd, offset)
        return sys_mmap(arg1, arg2, arg3, 0, 0, 0);
    }

    if syscall_num == 12 {
        // sys_brk(new_brk)
        return sys_brk(arg1);
    }

    if syscall_num == 39 {
        // sys_getpid
        return current_pid;
    }

    if syscall_num == 57 {
        // sys_fork
        return sys_fork();
    }

    if syscall_num == 59 {
        // sys_exec(path, path_len)
        return sys_exec(arg1, arg2);
    }

    if syscall_num == 61 {
        // sys_wait(pid)
        return sys_wait(arg1);
    }

    if syscall_num == 62 {
        // sys_kill(pid, sig)
        return sys_kill(arg1, arg2);
    }

    if syscall_num == 134 {
        // sys_sigaction(sig, handler)
        return sys_sigaction(arg1, arg2);
    }

    if syscall_num == 200 {
        // sys_pipe
        return sys_pipe();
    }

    if syscall_num == 201 {
        // sys_shmget(key, size, flags)
        return sys_shmget(arg1, arg2, arg3);
    }

    // Unknown syscall — print debug and continue
    con_putc(10);
    con_putc(83); con_putc(58); // "S:"
    print_hex(syscall_num);
    con_putc(32);
    con_putc(82); con_putc(58); // "R:"
    print_hex(arg1);
    con_putc(32);
    con_putc(80); con_putc(58); // "P:"
    print_hex(arg2);
    con_putc(32);
    con_putc(65); con_putc(58); // "A:"
    print_hex(arg3);
    con_putc(10);
    return 0;
}

// ─── Extended Syscalls (G2, G5, G6, G7, G8, G21) ──────────────────────────

// User heap state at 0x6B0: [brk_current:8]
const USER_BRK: i64 = 0x6B0;
const USER_HEAP_START: i64 = 0x13000;  // user heap starts above user stack

// Process table at 0x160000 (up to 64 processes × 32 bytes)
const PROC_TABLE: i64 = 0x160000;
const MAX_PROCS: i64 = 64;
var current_pid: i64 = 1;
var next_pid: i64 = 2;

// Signal handler table at 0x170000 (64 signals × 8 bytes per process)
const SIGNAL_TABLE: i64 = 0x170000;

// Pipe buffer at 0x180000 (up to 16 pipes × 4096 bytes)
const PIPE_TABLE: i64 = 0x180000;
const MAX_PIPES: i64 = 16;
const PIPE_SIZE: i64 = 4096;

fn proc_init() {
    current_pid = 1;
    next_pid = 2;
    // Initialize process 1 (kernel shell)
    p_mem_write64(PROC_TABLE, 1);        // pid
    p_mem_write64(PROC_TABLE + 8, 1);    // state = running
    p_mem_write64(PROC_TABLE + 16, 0x10000); // entry
    p_mem_write64(PROC_TABLE + 24, 0x72000); // pml4
    // Initialize user brk
    p_mem_write64(USER_BRK, USER_HEAP_START);
}

fn sys_brk(new_brk: i64) -> i64 {
    // G7: Set program break (user heap)
    var current_brk: i64 = p_mem_read64(USER_BRK);
    if new_brk == 0 {
        // Query current brk
        return current_brk;
    }
    if new_brk < USER_HEAP_START || new_brk > 0x1F000 {
        return current_brk;  // invalid range, return current
    }
    p_mem_write64(USER_BRK, new_brk);
    return new_brk;
}

fn sys_mmap(addr: i64, length: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64 {
    // G7: Simple mmap — allocate anonymous pages in user space
    // For now, just extend the user break
    var current_brk: i64 = p_mem_read64(USER_BRK);
    if length <= 0 { return 0; }
    // Align to page boundary
    var aligned_len: i64 = (length + 0xFFF) & 0xFFFFFFFFFFFFF000;
    var result: i64 = current_brk;
    p_mem_write64(USER_BRK, current_brk + aligned_len);
    return result;
}

fn sys_fork() -> i64 {
    // G2: Fork — create a copy of the current process
    // In a real OS, this would copy page tables (COW) and create a new process.
    // For now, return -1 (not implemented in single-process mode)
    return -1;
}

fn sys_exec(path: i64, path_len: i64) -> i64 {
    // G2: Exec — replace current process with a new program
    // For now, load from initrd and jump to it
    var idx: i64 = initrd_find(path, path_len);
    if idx < 0 { return -1; }
    var size: i64 = initrd_get_size(idx);
    var doff: i64 = initrd_get_data_offset(idx);
    // Copy to 0x10000
    var i: i64 = 0;
    while i < size {
        p_mem_write8(0x10000 + i, p_mem_read8(INITRD_BUF + doff + i));
        i = i + 1;
    }
    // Enter user mode
    p_enter_user_mode(0x10000, 0x12000);
    return 0;  // never reached
}

fn sys_wait(pid: i64) -> i64 {
    // G2: Wait — block until child exits
    // For now, return 0 (no children to wait for)
    return 0;
}

fn sys_kill(pid: i64, sig: i64) -> i64 {
    // G8: Send signal to process
    // For now, just return 0
    return 0;
}

fn sys_sigaction(sig: i64, handler: i64) -> i64 {
    // G8: Set signal handler
    if sig < 0 || sig >= 64 { return -1; }
    p_mem_write64(SIGNAL_TABLE + sig * 8, handler);
    return 0;
}

fn sys_pipe() -> i64 {
    // G21: Create a pipe — returns pipe id
    // Find a free pipe slot
    var i: i64 = 0;
    while i < MAX_PIPES {
        var in_use: i64 = p_mem_read8(PIPE_TABLE + i * (PIPE_SIZE + 16));
        if in_use == 0 {
            p_mem_write8(PIPE_TABLE + i * (PIPE_SIZE + 16), 1);
            // Initialize read/write offsets
            p_mem_write64(PIPE_TABLE + i * (PIPE_SIZE + 16) + 8, 0);  // read offset
            p_mem_write64(PIPE_TABLE + i * (PIPE_SIZE + 16) + 16, 0); // write offset
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn sys_shmget(key: i64, size: i64, flags: i64) -> i64 {
    // G21: Allocate shared memory — return virtual address
    // Use a fixed shared memory region at 0x200000
    var current: i64 = p_mem_read64(0x6C0);
    if current == 0 { current = 0x200000; }
    var aligned: i64 = (size + 0xFFF) & 0xFFFFFFFFFFFFF000;
    var result: i64 = current;
    p_mem_write64(0x6C0, current + aligned);
    return result;
}

// ─── E1000 Network Driver (G22) ───────────────────────────────────────────
// QEMU E1000 NIC is at PCI 0:3.0 (vendor 0x8086, device 0x100e)
// I/O BAR is at PCI config offset 0x10 (BAR0)
// MMIO BAR is at offset 0x14 (BAR1)

const E1000_REG_CTRL:   i64 = 0x0000;
const E1000_REG_STATUS: i64 = 0x0008;
const E1000_REG_RCTRL:  i64 = 0x0100;
const E1000_REG_TCTRL:  i64 = 0x0400;
var e1000_io_base: i64 = 0;

fn e1000_find() -> i64 {
    // Search PCI table for E1000 (vendor 0x8086, device 0x100e)
    var i: i64 = 0;
    while i < pci_device_count {
        var idx: i64 = i * 16;
        var vendor: i64 = p_mem_read64(PCI_TABLE + idx);
        var packed_val: i64 = p_mem_read64(PCI_TABLE + idx + 8);
        var device: i64 = (packed_val >> 48) & 0xFFFF;
        if vendor == 0x8086 && device == 0x100E {
            var bus: i64 = (packed_val >> 16) & 0xFF;
            var dev: i64 = (packed_val >> 8) & 0xFF;
            var func: i64 = packed_val & 0xFF;
            // Read BAR0 (I/O space) at config offset 0x10
            var bar0: i64 = pci_config_read(bus, dev, func, 0x10);
            e1000_io_base = bar0 & 0xFFFFFFFC;  // mask I/O bit and type
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

fn e1000_init() -> i64 {
    if e1000_find() != 0 { return -1; }
    if e1000_io_base == 0 { return -1; }

    // Read status register to verify NIC is present
    var status: i64 = e1000_read_reg(E1000_REG_STATUS);
    if status == 0 { return -1; }

    // Reset the device: write CTRL.FRCSPD | CTRL.RST (bit 6 | bit 26)
    // Actually just set link up: CTRL.SLU (bit 6)
    e1000_write_reg(E1000_REG_CTRL, 0x40);

    // Disable interrupts
    e1000_write_reg(0x00D0, 0);

    return 0;
}

fn e1000_read_reg(offset: i64) -> i64 {
    return p_inl(e1000_io_base + offset);
}

fn e1000_write_reg(offset: i64, val: i64) {
    p_outl(e1000_io_base + offset, val);
}

fn cmd_net() -> void {
    con_putc(10);
    // "NET: "
    con_putc(78); con_putc(69); con_putc(84); con_putc(58); con_putc(32);
    var result: i64 = e1000_init();
    if result == 0 {
        con_putc(69); con_putc(49); con_putc(48); con_putc(48); con_putc(48); // "E1000"
        con_putc(32);
        con_putc(105); con_putc(111); con_putc(58); // "io:"
        con_putc(32);
        print_hex(e1000_io_base);
        con_putc(32);
        var status: i64 = e1000_read_reg(E1000_REG_STATUS);
        con_putc(115); con_putc(116); con_putc(58); // "st:"
        con_putc(32);
        print_hex(status);
    } else {
        con_putc(78); con_putc(111); con_putc(110); con_putc(101); // "None"
    }
    con_putc(10);
}

// ─── Minimal TCP/IP Stack (G23) ───────────────────────────────────────────
// ARP cache, ICMP echo (ping), UDP, and minimal TCP.
// This is a scaffold — actual packet TX/RX requires the E1000 driver
// to be fully functional with ring buffers.

// ARP cache at 0x190000 (16 entries × 16 bytes: 4 IP + 6 MAC + 6 pad)
const ARP_CACHE: i64 = 0x190000;

// Our IP: 10.0.2.15 (QEMU default)
// Gateway: 10.0.2.2
// Our MAC: 52:54:00:12:34:56 (QEMU default)

fn net_init() {
    // Zero ARP cache
    var i: i64 = 0;
    while i < 256 {
        p_mem_write8(ARP_CACHE + i, 0);
        i = i + 1;
    }
}

fn cmd_ping(ip_addr: i64) -> void {
    con_putc(10);
    // "PING: "
    con_putc(80); con_putc(73); con_putc(78); con_putc(71); con_putc(58); con_putc(32);
    // Print IP as dotted decimal
    print_dec((ip_addr >> 24) & 0xFF);
    con_putc(46);
    print_dec((ip_addr >> 16) & 0xFF);
    con_putc(46);
    print_dec((ip_addr >> 8) & 0xFF);
    con_putc(46);
    print_dec(ip_addr & 0xFF);
    con_putc(10);
    // In a full implementation, we'd send an ICMP echo request via E1000
    // For now, just print a message
    con_putc(83); con_putc(101); con_putc(110); con_putc(100); con_putc(105); con_putc(110); con_putc(103); // "Sending"
    con_putc(32);
    con_putc(73); con_putc(67); con_putc(77); con_putc(80); // "ICMP"
    con_putc(32);
    con_putc(101); con_putc(99); con_putc(104); con_putc(111); // "echo"
    con_putc(10);
}

// ─── Framebuffer Console (G12) ────────────────────────────────────────────
// VBE framebuffer info from GRUB multiboot2 (if available).
// For now, we detect VBE mode info and provide a simple pixel plotter.
// The framebuffer address, width, height, and bpp are stored at 0x1A0000.

const FB_ADDR: i64 = 0x1A0000;    // framebuffer physical address
const FB_WIDTH: i64 = 0x1A0008;   // width in pixels
const FB_HEIGHT: i64 = 0x1A0010;  // height in pixels
const FB_BPP: i64 = 0x1A0018;     // bits per pixel
const FB_PITCH: i64 = 0x1A0020;   // bytes per scanline

fn fb_init() -> i64 {
    // In a real implementation, we'd parse multiboot2 info for VBE data.
    // For QEMU with -display none, there's no framebuffer.
    // Set defaults to 0 (no framebuffer)
    p_mem_write64(FB_ADDR, 0);
    p_mem_write64(FB_WIDTH, 0);
    p_mem_write64(FB_HEIGHT, 0);
    p_mem_write64(FB_BPP, 0);
    p_mem_write64(FB_PITCH, 0);
    return 0;
}

fn fb_putpixel(x: i64, y: i64, color: i64) {
    var addr: i64 = p_mem_read64(FB_ADDR);
    var pitch: i64 = p_mem_read64(FB_PITCH);
    var bpp: i64 = p_mem_read64(FB_BPP);
    if addr == 0 || bpp == 0 { return; }
    var offset: i64 = y * pitch + x * (bpp / 8);
    p_mem_write32(addr + offset, color);
}

fn cmd_fb() -> void {
    con_putc(10);
    // "FB: "
    con_putc(70); con_putc(66); con_putc(58); con_putc(32);
    var addr: i64 = p_mem_read64(FB_ADDR);
    if addr == 0 {
        con_putc(78); con_putc(111); con_putc(110); con_putc(101); // "None"
    } else {
        con_putc(97); con_putc(100); con_putc(100); con_putc(114); con_putc(58); // "addr:"
        con_putc(32);
        print_hex(addr);
        con_putc(32);
        con_putc(119); con_putc(120); con_putc(104); // "wxh"
        con_putc(58);
        con_putc(32);
        print_dec(p_mem_read64(FB_WIDTH));
        con_putc(120);
        print_dec(p_mem_read64(FB_HEIGHT));
    }
    con_putc(10);
}

// ─── SMP Boot (G20) ───────────────────────────────────────────────────────
// Boot Application Processor (AP) via SIPI.
// APIC ID is at LAPIC + 0x20 (local APIC ID register).

fn smp_boot_ap(apic_id: i64) -> i64 {
    // Send INIT IPI to the AP
    // ICR low at 0xFEE00300, ICR high at 0xFEE00310
    // ICR high: [dest][...][dest shorthand] — bits 24-31 = destination
    apic_write(0xFEE00310, apic_id << 24);
    // ICR low: [vector][delivery][dest mode][level][trigger][dest shorthand]
    // INIT IPI: delivery mode = 5 (INIT), level = 1 (assert), trigger = 1 (level)
    // Vector = 0 (doesn't matter for INIT)
    apic_write(0xFEE00300, 0x4500);

    // Wait 10ms (approximately — just do a busy loop)
    var i: i64 = 0;
    while i < 1000000 { i = i + 1; }

    // Send SIPI (Startup IPI) with vector pointing to 0x8000 (real mode)
    // SIPI vector = page number (0x08 = physical address 0x8000)
    apic_write(0xFEE00310, apic_id << 24);
    apic_write(0xFEE00300, 0x4608);

    // Wait for AP to boot
    i = 0;
    while i < 1000000 { i = i + 1; }

    return 0;
}

fn cmd_smp() -> void {
    con_putc(10);
    // "SMP: "
    con_putc(83); con_putc(77); con_putc(80); con_putc(58); con_putc(32);
    // Get APIC ID from LAPIC
    var apic_id: i64 = (apic_read(0xFEE00020) >> 24) & 0xFF;
    con_putc(66); con_putc(83); con_putc(80); // "BSP"
    con_putc(32);
    con_putc(105); con_putc(100); con_putc(58); // "id:"
    con_putc(32);
    print_hex(apic_id);
    con_putc(10);
    // Try to boot AP 1
    con_putc(66); con_putc(111); con_putc(111); con_putc(116); // "Boot"
    con_putc(32);
    con_putc(65); con_putc(80); con_putc(49); // "AP1"
    con_putc(32);
    var result: i64 = smp_boot_ap(1);
    if result == 0 {
        con_putc(79); con_putc(75); // "OK"
    } else {
        con_putc(70); con_putc(97); con_putc(105); con_putc(108); // "Fail"
    }
    con_putc(10);
}

// ─── ATA DMA (G11) ────────────────────────────────────────────────────────
// Bus-master DMA for ATA/IDE.
// PCI device 0:1.1 is the PIIX3 IDE controller.
// BAR4 (offset 0x20) is the Bus Master IDE I/O base.

var ata_dma_base: i64 = 0;

fn ata_dma_init() -> i64 {
    // Find PIIX3 IDE controller (vendor 0x8086, device 0x7010)
    var i: i64 = 0;
    while i < pci_device_count {
        var idx: i64 = i * 16;
        var vendor: i64 = p_mem_read64(PCI_TABLE + idx);
        var packed_val: i64 = p_mem_read64(PCI_TABLE + idx + 8);
        var device: i64 = (packed_val >> 48) & 0xFFFF;
        if vendor == 0x8086 && device == 0x7010 {
            var bus: i64 = (packed_val >> 16) & 0xFF;
            var dev: i64 = (packed_val >> 8) & 0xFF;
            var func: i64 = packed_val & 0xFF;
            // Read BAR4 (bus master base)
            var bar4: i64 = pci_config_read(bus, dev, func, 0x20);
            ata_dma_base = bar4 & 0xFFFC;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

fn cmd_dma() -> void {
    con_putc(10);
    // "DMA: "
    con_putc(68); con_putc(77); con_putc(65); con_putc(58); con_putc(32);
    var result: i64 = ata_dma_init();
    if result == 0 {
        con_putc(98); con_putc(97); con_putc(115); con_putc(101); con_putc(58); // "base:"
        con_putc(32);
        print_hex(ata_dma_base);
    } else {
        con_putc(78); con_putc(111); con_putc(110); con_putc(101); // "None"
    }
    con_putc(10);
}

// Called by the boot trampoline when a user program exits via int 0x80.
// The syscall handler modifies the iret frame to return here at ring 0.
pub fn user_program_done() -> void {
    con_putc(10);
    // "User program returned to kernel."
    con_putc(85); con_putc(115); con_putc(101); con_putc(114); con_putc(32);
    con_putc(112); con_putc(114); con_putc(111); con_putc(103); con_putc(114);
    con_putc(97); con_putc(109); con_putc(32); con_putc(114); con_putc(101);
    con_putc(116); con_putc(117); con_putc(114); con_putc(110); con_putc(101);
    con_putc(100); con_putc(32); con_putc(116); con_putc(111); con_putc(32);
    con_putc(107); con_putc(101); con_putc(114); con_putc(110); con_putc(101);
    con_putc(108); con_putc(46);
    con_putc(10);

    // ─── Auto-test: verify all OS features ───
    con_putc(10);
    con_putc(45); con_putc(45); con_putc(45); con_putc(32);
    con_putc(65); con_putc(85); con_putc(84); con_putc(79); // "--- AUTO"
    con_putc(32); con_putc(84); con_putc(69); con_putc(83); con_putc(84); // " TEST"
    con_putc(32); con_putc(45); con_putc(45); con_putc(45); // " ---"
    con_putc(10);

    // Test mem command
    con_putc(91); con_putc(109); con_putc(101); con_putc(109); con_putc(93); // "[mem]"
    con_putc(10);
    cmd_mem();

    // Test time command
    con_putc(91); con_putc(116); con_putc(105); con_putc(109); con_putc(101); con_putc(93); // "[time]"
    con_putc(10);
    cmd_time();

    // Test date command
    con_putc(91); con_putc(100); con_putc(97); con_putc(116); con_putc(101); con_putc(93); // "[date]"
    con_putc(10);
    cmd_date();

    // Test info command
    con_putc(91); con_putc(105); con_putc(110); con_putc(102); con_putc(111); con_putc(93); // "[info]"
    con_putc(10);
    cmd_info();

    // Test ps command
    con_putc(91); con_putc(112); con_putc(115); con_putc(93); // "[ps]"
    con_putc(10);
    cmd_ps();

    // Test ticks
    con_putc(91); con_putc(116); con_putc(105); con_putc(99); con_putc(107); con_putc(115); con_putc(93); // "[ticks]"
    con_putc(10);
    con_putc(84); con_putc(58); // "T:"
    print_hex(timer_get_ticks());
    con_putc(10);

    // Test disk command
    con_putc(91); con_putc(100); con_putc(105); con_putc(115); con_putc(107); con_putc(93); // "[disk]"
    con_putc(10);
    cmd_disk();

    // Test malloc command
    con_putc(91); con_putc(109); con_putc(97); con_putc(108); con_putc(108); con_putc(111); con_putc(99); con_putc(93); // "[malloc]"
    con_putc(10);
    cmd_malloc();

    // Test page allocator
    con_putc(91); con_putc(112); con_putc(97); con_putc(103); con_putc(101); con_putc(93); // "[page]"
    con_putc(10);
    var p1: i64 = page_alloc();
    var p2: i64 = page_alloc();
    con_putc(112); con_putc(49); con_putc(58); // "p1:"
    print_hex(p1);
    con_putc(32);
    con_putc(112); con_putc(50); con_putc(58); // "p2:"
    print_hex(p2);
    con_putc(10);
    page_free(p1);
    page_free(p2);
    var p3: i64 = page_alloc();
    con_putc(112); con_putc(51); con_putc(58); // "p3:"
    print_hex(p3);
    con_putc(32);
    if p3 == p1 {
        con_putc(79); con_putc(75); // "OK"
    } else {
        con_putc(70); con_putc(65); con_putc(73); con_putc(76); // "FAIL"
    }
    con_putc(10);
    page_free(p3);

    // Test initrd
    con_putc(91); con_putc(105); con_putc(110); con_putc(105); con_putc(116); con_putc(114); con_putc(100); con_putc(93); // "[initrd]"
    con_putc(10);
    cmd_initrd_ls();

    // Test PCI
    con_putc(91); con_putc(112); con_putc(99); con_putc(105); con_putc(93); // "[pci]"
    con_putc(10);
    cmd_pci();

    // Test VM mapping
    con_putc(91); con_putc(118); con_putc(109); con_putc(93); // "[vm]"
    con_putc(10);
    cmd_vm();

    // Test heap with free
    con_putc(91); con_putc(104); con_putc(101); con_putc(97); con_putc(112); con_putc(93); // "[heap]"
    con_putc(10);
    var hp1: i64 = heap_alloc(64);
    var hp2: i64 = heap_alloc(128);
    heap_free(hp1);
    heap_free(hp2);
    var hp3: i64 = heap_alloc(64);
    con_putc(112); con_putc(49); con_putc(58); // "p1:"
    print_hex(hp1);
    con_putc(32);
    con_putc(112); con_putc(51); con_putc(58); // "p3:"
    print_hex(hp3);
    con_putc(10);
    heap_free(hp3);

    // Test ELF loading
    con_putc(91); con_putc(101); con_putc(108); con_putc(102); con_putc(93); // "[elf]"
    con_putc(10);
    cmd_elf();

    con_putc(45); con_putc(45); con_putc(45); con_putc(32);
    con_putc(69); con_putc(78); con_putc(68); con_putc(32); con_putc(65); con_putc(85); con_putc(84); con_putc(79); // "--- END AUTO"
    con_putc(32); con_putc(84); con_putc(69); con_putc(83); con_putc(84); // " TEST"
    con_putc(32); con_putc(45); con_putc(45); con_putc(45); // " ---"
    con_putc(10);
}

// Load and run an ELF program from disk sector 2.
fn cmd_elf() -> void {
    con_putc(10);
    con_putc(76); con_putc(111); con_putc(97); con_putc(100); con_putc(105); con_putc(110); con_putc(103); // "Loading"
    con_putc(32); con_putc(69); con_putc(76); con_putc(70); con_putc(32); con_putc(102); con_putc(114); con_putc(111); con_putc(109); // " ELF from"
    con_putc(32); con_putc(115); con_putc(101); con_putc(99); con_putc(116); con_putc(111); con_putc(114); con_putc(32); con_putc(50); // " sector 2"
    con_putc(46); con_putc(46); con_putc(46);
    con_putc(10);
    // Read sector 2 into buffer at 0x20000
    var ok: i64 = ata_read_sector(2, 0x20000);
    if ok != 0 {
        con_putc(70); con_putc(97); con_putc(105); con_putc(108); con_putc(101); con_putc(100); // "Failed"
        con_putc(32); con_putc(116); con_putc(111); con_putc(32); con_putc(114); con_putc(101); con_putc(97); con_putc(100); // " to read"
        con_putc(10);
    } else {
        // Parse ELF
        var entry: i64 = elf_load(0x20000);
        if entry == 0 {
            con_putc(78); con_putc(111); con_putc(116); con_putc(32); con_putc(97); con_putc(110); con_putc(32); con_putc(69); con_putc(76); con_putc(70); // "Not an ELF"
            con_putc(10);
        } else {
            con_putc(69); con_putc(110); con_putc(116); con_putc(114); con_putc(121); con_putc(58); con_putc(32); // "Entry: "
            print_hex(entry);
            con_putc(10);
            // Enter user mode with the ELF entry point
            con_putc(74); con_putc(117); con_putc(109); con_putc(112); con_putc(105); con_putc(110); con_putc(103); // "Jumping"
            con_putc(32); con_putc(116); con_putc(111); con_putc(32); con_putc(117); con_putc(115); con_putc(101); con_putc(114); // " to user"
            con_putc(32); con_putc(109); con_putc(111); con_putc(100); con_putc(101); // " mode"
            con_putc(10);
            p_enter_user_mode(entry, 0x12000);
        }
    }
}

// Load and run a user-mode program from disk sector 1.
// The user program is a flat binary loaded at 0x10000.
// User stack is at 0x12000 (grows down).
// The user program writes to VGA at 0xB8000 and calls int 0x80 to exit.
fn cmd_run() -> void {
    con_putc(10);
    // "Loading user program from sector 1..."
    con_putc(76); con_putc(111); con_putc(97); con_putc(100); con_putc(105);
    con_putc(110); con_putc(103); con_putc(32); con_putc(117); con_putc(115);
    con_putc(101); con_putc(114); con_putc(32); con_putc(112); con_putc(114);
    con_putc(111); con_putc(103); con_putc(114); con_putc(97); con_putc(109);
    con_putc(32); con_putc(102); con_putc(114); con_putc(111); con_putc(109);
    con_putc(32); con_putc(115); con_putc(101); con_putc(99); con_putc(116);
    con_putc(111); con_putc(114); con_putc(32); con_putc(49); con_putc(46); con_putc(46); con_putc(46);
    con_putc(10);

    // Load user program from disk sector 1 to address 0x10000
    var result: i64 = ata_read_sector(1, 0x10000);
    if result != 0 {
        // "Failed to load user program"
        con_putc(70); con_putc(97); con_putc(105); con_putc(108); con_putc(101);
        con_putc(100); con_putc(32); con_putc(116); con_putc(111); con_putc(32);
        con_putc(108); con_putc(111); con_putc(97); con_putc(100); con_putc(32);
        con_putc(117); con_putc(115); con_putc(101); con_putc(114); con_putc(32);
        con_putc(112); con_putc(114); con_putc(111); con_putc(103); con_putc(114);
        con_putc(97); con_putc(109);
        con_putc(10);
        return;
    }

    // "Entering ring 3 (user mode)..."
    con_putc(69); con_putc(110); con_putc(116); con_putc(101); con_putc(114);
    con_putc(105); con_putc(110); con_putc(103); con_putc(32); con_putc(114);
    con_putc(105); con_putc(110); con_putc(103); con_putc(32); con_putc(51);
    con_putc(32); con_putc(40); con_putc(117); con_putc(115); con_putc(101);
    con_putc(114); con_putc(32); con_putc(109); con_putc(111); con_putc(100);
    con_putc(101); con_putc(41); con_putc(46); con_putc(46); con_putc(46);
    con_putc(10);

    // Enter user mode: entry at 0x10000, stack at 0x12000
    // This does iret to ring 3 and never returns.
    // When the user calls int 0x80, the syscall handler returns to
    // user_program_done() in the kernel.
    p_enter_user_mode(0x10000, 0x12000);

    // This code is never reached — p_enter_user_mode does iret
}

// ─── Main ────────────────────────────────────────────────────────────────

pub fn main() -> void {
    p_serial_init();
    vga_clear();

    // Initialize scancode buffer (head=0, tail=0)
    p_mem_write8(SCANCODE_HEAD, 0);
    p_mem_write8(SCANCODE_TAIL, 0);
    // Initialize keyboard state (shift=0, caps=0)
    p_mem_write8(KBD_SHIFT, 0);
    p_mem_write8(KBD_CAPS, 0);
    // Initialize timer ticks
    p_mem_write8(TIMER_TICKS, 0);
    // Initialize heap
    heap_init();
    // Initialize scheduler
    sched_init();
    // Initialize FAT32 filesystem
    fat32_init();
    // Load initrd ramdisk from disk sector 10
    initrd_load();
    // Scan PCI bus
    pci_scan();
    // Initialize ACPI
    acpi_init();
    // Initialize PS/2 mouse
    mouse_init();
    // Initialize process table
    proc_init();
    // Initialize network stack
    net_init();
    // Initialize framebuffer
    fb_init();

    // Banner: "Fides OS v0.1"
    con_putc(70); con_putc(105); con_putc(100); con_putc(101); con_putc(115);
    con_putc(32); con_putc(79); con_putc(83); con_putc(32); con_putc(118);
    con_putc(48); con_putc(46); con_putc(49);
    con_putc(10); con_putc(10);

    cmd_help();
    con_putc(10);

    // Auto-test: list files
    cmd_ls();
    // Auto-test: run user program with syscalls
    // (auto-test of all OS features runs in user_program_done after exit)
    cmd_run();

    // Shell loop
    while true {
        // Print prompt "> "
        con_putc(62); con_putc(32);

        input_clear();
        var input_len: i64 = 0;
        var reading: i64 = 1;

        while reading == 1 {
            var sc: i64 = kbd_read_scancode();
            var c: i64 = scancode_to_ascii(sc);

            if c == -1 { continue; }

            if c == 10 {
                con_putc(10);
                reading = 0;
            } else if c == 8 {
                if input_len > 0 {
                    input_len = input_len - 1;
                    input_write(input_len, 0);
                    con_putc(8);
                }
            } else if input_len < INPUT_MAX {
                input_write(input_len, c);
                input_len = input_len + 1;
                con_putc(c);
            }
        }

        // Process command
        if input_len == 0 {
            // Empty line
        } else if input_matches(104, 101, 108, 112, 0, 4, input_len) == 1 {
            // "help"
            cmd_help();
        } else if input_matches(99, 108, 101, 97, 114, 5, input_len) == 1 {
            // "clear"
            cmd_clear();
        } else if input_matches8(101, 99, 104, 111, 0, 0, 0, 0, 4, input_len) == 1 {
            // "echo <text>"
            cmd_echo(input_len);
        } else if input_matches8(109, 101, 109, 0, 0, 0, 0, 0, 3, input_len) == 1 {
            // "mem"
            cmd_mem();
        } else if input_matches8(105, 110, 102, 111, 0, 0, 0, 0, 4, input_len) == 1 {
            // "info"
            cmd_info();
        } else if input_matches8(116, 105, 109, 101, 0, 0, 0, 0, 4, input_len) == 1 {
            // "time"
            cmd_time();
        } else if input_matches8(100, 97, 116, 101, 0, 0, 0, 0, 4, input_len) == 1 {
            // "date"
            cmd_date();
        } else if input_matches8(114, 101, 98, 111, 111, 116, 0, 0, 6, input_len) == 1 {
            // "reboot"
            cmd_reboot();
        } else if input_matches8(112, 111, 119, 101, 114, 111, 102, 102, 8, input_len) == 1 {
            // "poweroff"
            cmd_poweroff();
        } else if input_matches8(109, 97, 108, 108, 111, 99, 0, 0, 6, input_len) == 1 {
            // "malloc"
            cmd_malloc();
        } else if input_matches8(100, 105, 115, 107, 0, 0, 0, 0, 4, input_len) == 1 {
            // "disk"
            cmd_disk();
        } else if input_matches8(114, 117, 110, 0, 0, 0, 0, 0, 3, input_len) == 1 {
            // "run"
            cmd_run();
        } else if input_matches8(101, 108, 102, 0, 0, 0, 0, 0, 3, input_len) == 1 {
            // "elf" — load ELF from sector 2 and run
            cmd_elf();
        } else if input_matches8(116, 105, 99, 107, 115, 0, 0, 0, 5, input_len) == 1 {
            // "ticks"
            con_putc(10);
            con_putc(84); con_putc(105); con_putc(99); con_putc(107); con_putc(115); // "Ticks"
            con_putc(58); con_putc(32);
            print_dec(timer_get_ticks());
            con_putc(10);
        } else if input_matches(112, 115, 0, 0, 0, 2, input_len) == 1 {
            // "ps" — show process table
            cmd_ps();
        } else if input_matches(108, 115, 0, 0, 0, 2, input_len) == 1 {
            // "ls" — list files
            cmd_ls();
        } else if input_matches(99, 97, 116, 0, 0, 3, input_len) == 1 {
            // "cat" — read file (needs filename after space)
            // Find the filename after "cat "
            var fname_start: i64 = 4;
            while fname_start < input_len {
                if input_get(fname_start) != 32 { break; }
                fname_start = fname_start + 1;
            }
            if fname_start < input_len {
                cmd_cat(INPUT_BUF_ADDR + fname_start, input_len - fname_start);
            } else {
                con_putc(63); con_putc(10);
            }
        } else if input_matches(104, 97, 108, 116, 0, 4, input_len) == 1 {
            // "halt"
            cmd_halt();
        } else if input_matches8(105, 108, 115, 0, 0, 0, 0, 0, 3, input_len) == 1 {
            // "ils" — list initrd files
            cmd_initrd_ls();
        } else if input_matches8(105, 99, 97, 116, 0, 0, 0, 0, 4, input_len) == 1 {
            // "icat" — read file from initrd
            var fname_start: i64 = 5;
            while fname_start < input_len {
                if input_get(fname_start) != 32 { break; }
                fname_start = fname_start + 1;
            }
            if fname_start < input_len {
                cmd_initrd_cat(INPUT_BUF_ADDR + fname_start, input_len - fname_start);
            } else {
                con_putc(63); con_putc(10);
            }
        } else if input_matches8(112, 99, 105, 0, 0, 0, 0, 0, 3, input_len) == 1 {
            // "pci" — list PCI devices
            cmd_pci();
        } else if input_matches8(97, 99, 112, 105, 0, 0, 0, 0, 4, input_len) == 1 {
            // "acpi" — show ACPI info
            cmd_acpi();
        } else if input_matches8(118, 109, 0, 0, 0, 0, 0, 0, 2, input_len) == 1 {
            // "vm" — test VM mapping
            cmd_vm();
        } else if input_matches8(109, 111, 117, 115, 101, 0, 0, 0, 5, input_len) == 1 {
            // "mouse" — show mouse state
            cmd_mouse();
        } else if input_matches8(97, 112, 105, 99, 0, 0, 0, 0, 4, input_len) == 1 {
            // "apic" — init/show APIC
            cmd_apic();
        } else if input_matches8(104, 101, 97, 112, 0, 0, 0, 0, 4, input_len) == 1 {
            // "heap" — show heap info
            con_putc(10);
            con_putc(110); con_putc(101); con_putc(120); con_putc(116); con_putc(58); con_putc(32); // "next: "
            print_hex(heap_next);
            con_putc(10);
        } else if input_matches8(102, 114, 101, 101, 0, 0, 0, 0, 4, input_len) == 1 {
            // "free" — test heap free
            con_putc(10);
            var p1: i64 = heap_alloc(64);
            var p2: i64 = heap_alloc(128);
            heap_free(p1);
            heap_free(p2);
            con_putc(79); con_putc(75); // "OK"
            con_putc(10);
        } else if input_matches8(110, 101, 116, 0, 0, 0, 0, 0, 3, input_len) == 1 {
            // "net" — init/show network
            cmd_net();
        } else if input_matches8(102, 98, 0, 0, 0, 0, 0, 0, 2, input_len) == 1 {
            // "fb" — show framebuffer info
            cmd_fb();
        } else if input_matches8(115, 109, 112, 0, 0, 0, 0, 0, 3, input_len) == 1 {
            // "smp" — boot SMP
            cmd_smp();
        } else if input_matches8(100, 109, 97, 0, 0, 0, 0, 0, 3, input_len) == 1 {
            // "dma" — show DMA info
            cmd_dma();
        } else if input_matches8(112, 105, 110, 103, 0, 0, 0, 0, 4, input_len) == 1 {
            // "ping" — send ICMP echo (stub)
            cmd_ping(0x0A000202);  // ping 10.0.2.2
        } else {
            // Unknown
            con_putc(63); con_putc(10);
        }
    }
}
