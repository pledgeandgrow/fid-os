fn cmd_clear() -> void {
    vga_clear();
}

fn cmd_reboot() -> void {
    p_outb(0x64, 0xFE);
    while true { p_hlt(); }
}

fn cmd_halt() -> void {
    con_putc(10);
    con_putc(83); con_putc(121); con_putc(115); con_putc(116); con_putc(101); con_putc(109);
    con_putc(32); con_putc(104); con_putc(97); con_putc(108); con_putc(116); con_putc(101); con_putc(100); con_putc(46);
    con_putc(10);
    p_cli();
    while true { p_hlt(); }
}

fn cmd_echo(input_len: i64) -> void {
    con_putc(32);
    var i: i64 = 5;  // skip "echo "
    while i < input_len {
        con_putc(input_get(i));
        i = i + 1;
    }
    con_putc(10);
}

// ─── ELF Loader ─────────────────────────────────────────────────────────
// Simplified ELF64 loader for bare-metal mode.
// Parses ELF header, validates magic, loads PT_LOAD segments, returns entry.

const ELF_MAGIC0: i64 = 0x7F;
const ELF_MAGIC1: i64 = 0x45;  // 'E'
const ELF_MAGIC2: i64 = 0x4C;  // 'L'
const ELF_MAGIC3: i64 = 0x46;  // 'F'
const ELF_CLASS_64: i64 = 2;
const ELF_MACHINE_X86_64: i64 = 62;
const PT_LOAD: i64 = 1;

// Read a little-endian u16 from a memory buffer
fn elf_read_u16(buf: i64, offset: i64) -> i64 {
    var b0: i64 = p_mem_read8(buf + offset);
    var b1: i64 = p_mem_read8(buf + offset + 1);
    return b0 | (b1 << 8);
}

// Read a little-endian u32 from a memory buffer
fn elf_read_u32(buf: i64, offset: i64) -> i64 {
    var b0: i64 = p_mem_read8(buf + offset);
    var b1: i64 = p_mem_read8(buf + offset + 1);
    var b2: i64 = p_mem_read8(buf + offset + 2);
    var b3: i64 = p_mem_read8(buf + offset + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// Read a little-endian u64 from a memory buffer
fn elf_read_u64(buf: i64, offset: i64) -> i64 {
    var lo: i64 = elf_read_u32(buf, offset);
    var hi: i64 = elf_read_u32(buf, offset + 4);
    return lo | (hi << 32);
}

// Check if a buffer contains a valid ELF64 header
fn elf_is_valid(buf: i64) -> i64 {
    if p_mem_read8(buf + 0) != ELF_MAGIC0 { return 0; }
    if p_mem_read8(buf + 1) != ELF_MAGIC1 { return 0; }
    if p_mem_read8(buf + 2) != ELF_MAGIC2 { return 0; }
    if p_mem_read8(buf + 3) != ELF_MAGIC3 { return 0; }
    if p_mem_read8(buf + 4) != ELF_CLASS_64 { return 0; }
    var machine: i64 = elf_read_u16(buf, 18);
    if machine != ELF_MACHINE_X86_64 { return 0; }
    return 1;
}

// Load an ELF64 binary from a memory buffer. Returns entry point or 0 on error.
fn elf_load(buf: i64) -> i64 {
    if elf_is_valid(buf) == 0 { return 0; }

    // Parse ELF header
    var entry: i64 = elf_read_u64(buf, 24);
    var phoff: i64 = elf_read_u64(buf, 32);
    var phentsize: i64 = elf_read_u16(buf, 54);
    var phnum: i64 = elf_read_u16(buf, 56);

    // Load all PT_LOAD segments
    var i: i64 = 0;
    while i < phnum {
        var phdr_offset: i64 = phoff + i * phentsize;
        var ptype: i64 = elf_read_u32(buf, phdr_offset);
        if ptype == PT_LOAD {
            var p_offset: i64 = elf_read_u64(buf, phdr_offset + 8);
            var p_vaddr: i64 = elf_read_u64(buf, phdr_offset + 16);
            var p_filesz: i64 = elf_read_u64(buf, phdr_offset + 32);
            var p_memsz: i64 = elf_read_u64(buf, phdr_offset + 40);

            // Copy file contents to virtual address
            var j: i64 = 0;
            while j < p_filesz {
                var byte: i64 = p_mem_read8(buf + p_offset + j);
                p_mem_write8(p_vaddr + j, byte);
                j = j + 1;
            }
            // Zero out BSS (memsz - filesz)
            var k: i64 = p_filesz;
            while k < p_memsz {
                p_mem_write8(p_vaddr + k, 0);
                k = k + 1;
            }
        }
        i = i + 1;
    }

    return entry;
}

// ─── Memory Management ──────────────────────────────────────────────────
// Simple page-frame allocator with free list.
// Heap starts at 0x300000. We use a bitmap at 0x310000 to track allocated
// 4KB pages. Free list uses the page itself to store the next free pointer.

const HEAP_START: i64 = 0x300000;
const HEAP_BITMAP: i64 = 0x310000;
const HEAP_MAX_PAGES: i64 = 256;  // 256 pages × 4KB = 1MB heap
const PAGE_SIZE: i64 = 4096;

// Initialize the heap: zero the bitmap, mark all pages free.
fn heap_init() -> void {
    var i: i64 = 0;
    while i < HEAP_MAX_PAGES {
        p_mem_write8(HEAP_BITMAP + i, 0);  // 0 = free
        i = i + 1;
    }
}

// Allocate a 4KB-aligned page. Returns physical address or 0 if out of memory.
fn page_alloc() -> i64 {
    var i: i64 = 0;
    while i < HEAP_MAX_PAGES {
        if p_mem_read8(HEAP_BITMAP + i) == 0 {
            p_mem_write8(HEAP_BITMAP + i, 1);  // mark allocated
            return HEAP_START + i * PAGE_SIZE;
        }
        i = i + 1;
    }
    return 0;  // out of memory
}

// Free a previously allocated page.
fn page_free(addr: i64) -> void {
    if addr < HEAP_START { return; }
    var idx: i64 = (addr - HEAP_START) / PAGE_SIZE;
    if idx >= HEAP_MAX_PAGES { return; }
    p_mem_write8(HEAP_BITMAP + idx, 0);  // mark free
}

// Allocate `size` bytes, rounded up to a page. Returns address or 0.
fn kmalloc(size: i64) -> i64 {
    if size <= 0 { return 0; }
    return page_alloc();  // simple: one page per allocation
}

// Free a previously allocated block.
fn kfree(addr: i64) -> void {
    page_free(addr);
}

// ─── Process Scheduler ─────────────────────────────────────────────────
// Simple round-robin scheduler with up to 8 processes.
// Process table at 0x320000 (below heap bitmap at 0x310000).
// Each process entry is 64 bytes:
//   [0]  state    (0=free, 1=ready, 2=running, 3=blocked)
//   [8]  rsp      (saved stack pointer)
//   [16] rbp      (saved base pointer)
//   [24] cr3      (page table for this process)
//   [32] entry    (entry point address)
//   [40] pid      (process ID)
//   [48] ticks    (CPU ticks used)

const SCHED_TABLE: i64 = 0x320000;
const SCHED_MAX_PROCS: i64 = 8;
const SCHED_ENTRY_SIZE: i64 = 64;
const PROC_FREE: i64 = 0;
const PROC_READY: i64 = 1;
const PROC_RUNNING: i64 = 2;
const PROC_BLOCKED: i64 = 3;

var sched_current: i64 = -1;  // current process index
var sched_ticks: i64 = 0;     // ticks in current quantum

// Initialize the scheduler — mark all process slots as free.
fn sched_init() -> void {
    var i: i64 = 0;
    while i < SCHED_MAX_PROCS {
        p_mem_write8(SCHED_TABLE + i * SCHED_ENTRY_SIZE, PROC_FREE);
        i = i + 1;
    }
    sched_current = -1;
    sched_ticks = 0;
}

// Create a new process. Returns PID or -1 if table is full.
fn sched_create(entry: i64, cr3: i64) -> i64 {
    var i: i64 = 0;
    while i < SCHED_MAX_PROCS {
        var base: i64 = SCHED_TABLE + i * SCHED_ENTRY_SIZE;
        if p_mem_read8(base) == PROC_FREE {
            p_mem_write8(base, PROC_READY);
            p_mem_write8(base + 8, 0);   // rsp (will be set on first run)
            p_mem_write8(base + 16, 0);  // rbp
            p_mem_write8(base + 24, cr3);
            p_mem_write8(base + 32, entry);
            p_mem_write8(base + 40, i + 1);  // pid = i+1
            p_mem_write8(base + 48, 0);  // ticks
            return i + 1;
        }
        i = i + 1;
    }
    return -1;
}

// Get the number of active (non-free) processes.
fn sched_count() -> i64 {
    var count: i64 = 0;
    var i: i64 = 0;
    while i < SCHED_MAX_PROCS {
        if p_mem_read8(SCHED_TABLE + i * SCHED_ENTRY_SIZE) != PROC_FREE {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// Find the next ready process after `current`.
fn sched_next_ready(current: i64) -> i64 {
    var i: i64 = current + 1;
    while i < SCHED_MAX_PROCS {
        if p_mem_read8(SCHED_TABLE + i * SCHED_ENTRY_SIZE) == PROC_READY {
            return i;
        }
        i = i + 1;
    }
    i = 0;
    while i <= current {
        if p_mem_read8(SCHED_TABLE + i * SCHED_ENTRY_SIZE) == PROC_READY {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Print process table status.
fn cmd_ps() -> void {
    con_putc(10);
    con_putc(80); con_putc(73); con_putc(68); con_putc(32); con_putc(83); con_putc(116); con_putc(97); con_putc(116); con_putc(101); con_putc(32); con_putc(69); con_putc(110); con_putc(116); con_putc(114); con_putc(121); // "PID State Entry"
    con_putc(10);
    var i: i64 = 0;
    while i < SCHED_MAX_PROCS {
        var base: i64 = SCHED_TABLE + i * SCHED_ENTRY_SIZE;
        var state: i64 = p_mem_read8(base);
        if state != PROC_FREE {
            var pid: i64 = p_mem_read8(base + 40);
            var entry: i64 = p_mem_read8(base + 32);
            print_dec(pid);
            con_putc(32);
            if state == PROC_READY { con_putc(82); con_putc(101); con_putc(97); con_putc(100); con_putc(121); } // "Ready"
            else if state == PROC_RUNNING { con_putc(82); con_putc(117); con_putc(110); } // "Run"
            else if state == PROC_BLOCKED { con_putc(66); con_putc(108); con_putc(111); con_putc(99); con_putc(107); } // "Block"
            con_putc(32);
            print_hex(entry);
            con_putc(10);
        }
        i = i + 1;
    }
}

fn cmd_mem() -> void {
    con_putc(10);
    // "Memory: kernel at 0x100000"
    con_putc(77); con_putc(101); con_putc(109); con_putc(111); con_putc(114); con_putc(121);
    con_putc(58); con_putc(32);
