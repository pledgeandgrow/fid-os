fn cmd_clear() -> void {
    vga_clear();
}

fn cmd_reboot() -> void {
    p_outb(0x64, 0xFE);
    while true { p_hlt(); }
}

fn cmd_halt() -> void {
    con_putc(10);
    con_putc(83); con_putc(121); con_putc(115); con_putc(116); con_putc(101); con_putc(109);
    con_putc(32); con_putc(104); con_putc(97); con_putc(108); con_putc(116); con_putc(101); con_putc(100); con_putc(46);
    con_putc(10);
    p_cli();
    while true { p_hlt(); }
}

fn cmd_echo(input_len: i64) -> void {
    con_putc(32);
    var i: i64 = 5;  // skip "echo "
    while i < input_len {
        con_putc(input_get(i));
        i = i + 1;
    }
    con_putc(10);
}

fn cmd_mem() -> void {
    con_putc(10);
    // "Memory: kernel at 0x100000"
    con_putc(77); con_putc(101); con_putc(109); con_putc(111); con_putc(114); con_putc(121);
    con_putc(58); con_putc(32);
    // Print kernel load address
    con_putc(107); con_putc(101); con_putc(114); con_putc(110); con_putc(101); con_putc(108);
    con_putc(32); con_putc(97); con_putc(116); con_putc(32);
    print_hex(0x100000);
    con_putc(10);
    // "VGA buffer at 0xB8000"
    con_putc(86); con_putc(71); con_putc(65); con_putc(32);
    con_putc(98); con_putc(117); con_putc(102); con_putc(102); con_putc(101); con_putc(114);
    con_putc(32); con_putc(97); con_putc(116); con_putc(32);
    print_hex(0xB8000);
    con_putc(10);
    // "Stack at 0x90000"
    con_putc(83); con_putc(116); con_putc(97); con_putc(99); con_putc(107);
    con_putc(32); con_putc(97); con_putc(116); con_putc(32);
    print_hex(0x90000);
    con_putc(10);
    // "Free heap at 0x300000"
    con_putc(70); con_putc(114); con_putc(101); con_putc(101);
    con_putc(32); con_putc(104); con_putc(101); con_putc(97); con_putc(112);
    con_putc(32); con_putc(97); con_putc(116); con_putc(32);
    print_hex(HEAP_START);
    con_putc(10);
    // "Timer ticks: N"
    con_putc(84); con_putc(105); con_putc(109); con_putc(101); con_putc(114);
    con_putc(32); con_putc(116); con_putc(105); con_putc(99); con_putc(107); con_putc(115);
    con_putc(58); con_putc(32);
    print_dec(timer_get_ticks());
    con_putc(10);
}

