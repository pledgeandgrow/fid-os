// kernel/shell.fd — Fides OS main kernel + shell
//
// Boots via GRUB/Multiboot2, writes to VGA text mode (0xB8000),
// reads keyboard input via interrupts, and runs a shell.
// All subsystems are in separate modules imported via `use`.

module shell;

use vga;
use serial;
use console;
use isr;
use keyboard;
use kalloc;
use sched;
use ata;
use vfs;
use initrd;
use pci;
use acpi;
use vm;
use mouse;
use apic;
use elf;
use syscall;
use net;
use framebuffer;
use dma;
use audio;
use graphics;
use gamepad;
use gpio;
use button;
use arm_boot;
use gameloop;
use shell_script;

// ─── Shell Commands ─────────────────────────────────────────────────────

