// kernel/vm.fd — Virtual memory mapping API
// Kernel PML4 at 0x70000, PDPT at 0x71000
// vm_map maps a virtual address to a physical address in kernel page tables.

module vm;

use console;

pub fn vm_map(vaddr: i64, paddr: i64, flags: i64) -> i64 {
    // PML4 index = bits 39-47
    var pml4_idx: i64 = (vaddr >> 39) & 0x1FF;
    // PDPT index = bits 30-38
    var pdpt_idx: i64 = (vaddr >> 30) & 0x1FF;
    // PD index = bits 21-29
    var pd_idx: i64 = (vaddr >> 21) & 0x1FF;

    // Get PML4 entry
    var pml4_entry: i64 = p_mem_read64(0x70000 + pml4_idx * 8);
    var pdpt_addr: i64 = pml4_entry & 0xFFFFFFFFFFFFF000;  // mask flags
    if pdpt_addr == 0 {
        // Allocate a new PDPT
        pdpt_addr = 0x74000;  // Use fixed address for new PDPT
        var i: i64 = 0;
        while i < 4096 {
            p_mem_write8(pdpt_addr + i, 0);
            i = i + 1;
        }
        p_mem_write64(0x70000 + pml4_idx * 8, pdpt_addr | 0x3);
    }

    // Get PDPT entry — check if it's a 1GB huge page (PS bit = 0x80)
    var pdpt_entry: i64 = p_mem_read64(pdpt_addr + pdpt_idx * 8);
    if (pdpt_entry & 0x80) != 0 {
        // It's a 1GB huge page — need to split into a PD with 512 2MB entries
        // Use a fixed address in the heap area for the new PD
        var pd_addr: i64 = 0x310000 + pdpt_idx * 0x1000;
        var phys_base: i64 = pdpt_entry & 0xFFFFFFFFFFE00000;  // 1GB aligned physical
        var i: i64 = 0;
        while i < 512 {
            // Each 2MB entry: present | writable | huge | (user if original had it)
            var entry_flags: i64 = 0x83;
            if (pdpt_entry & 0x04) != 0 { entry_flags = entry_flags | 0x04; }  // user bit
            p_mem_write64(pd_addr + i * 8, (phys_base + i * 0x200000) | entry_flags);
            i = i + 1;
        }
        // Replace PDPT entry: clear PS bit, point to new PD
        var pdpt_flags: i64 = pdpt_entry & 0x7;  // keep present/writable/user
        p_mem_write64(pdpt_addr + pdpt_idx * 8, pd_addr | pdpt_flags);
        pdpt_entry = p_mem_read64(pdpt_addr + pdpt_idx * 8);
    }

    var pd_addr: i64 = pdpt_entry & 0xFFFFFFFFFFFFF000;
    if pd_addr == 0 {
        pd_addr = 0x310000 + pdpt_idx * 0x1000;
        var i: i64 = 0;
        while i < 4096 {
            p_mem_write8(pd_addr + i, 0);
            i = i + 1;
        }
        p_mem_write64(pdpt_addr + pdpt_idx * 8, pd_addr | 0x3);
    }

    // Set PD entry as 2MB page (PS bit = 0x80)
    // Present | Writable | PS | flags
    var pd_flags: i64 = 0x83 | (flags & 0x7F);
    p_mem_write64(pd_addr + pd_idx * 8, (paddr & 0xFFFFFFFFFFE00000) | pd_flags);

    // Flush TLB for this address
    p_invlpg(vaddr);
    return 0;
}

pub fn vm_unmap(vaddr: i64) -> i64 {
    var pml4_idx: i64 = (vaddr >> 39) & 0x1FF;
    var pdpt_idx: i64 = (vaddr >> 30) & 0x1FF;
    var pd_idx: i64 = (vaddr >> 21) & 0x1FF;

    var pml4_entry: i64 = p_mem_read64(0x70000 + pml4_idx * 8);
    var pdpt_addr: i64 = pml4_entry & 0xFFFFFFFFFFFFF000;
    if pdpt_addr == 0 { return -1; }

    var pdpt_entry: i64 = p_mem_read64(pdpt_addr + pdpt_idx * 8);
    var pd_addr: i64 = pdpt_entry & 0xFFFFFFFFFFFFF000;
    if pd_addr == 0 { return -1; }

    // Clear the PD entry
    p_mem_write64(pd_addr + pd_idx * 8, 0);
    p_invlpg(vaddr);
    return 0;
}

pub fn cmd_vm() -> void {
    con_putc(10);
    // "VM: verify mapping 0x800000"
    con_putc(86); con_putc(77); con_putc(58); con_putc(32);
    con_putc(118); con_putc(101); con_putc(114); con_putc(105); con_putc(102); con_putc(121);
    con_putc(10);
    // Test read/write to an already-mapped address (first 1GB is identity-mapped)
    p_mem_write64(0x800000, 0xDEADBEEF);
    var val: i64 = p_mem_read64(0x800000);
    con_putc(79); con_putc(75); con_putc(32); // "OK "
    print_hex(val);
    con_putc(10);
    // Show CR3 (page table base)
    con_putc(67); con_putc(82); con_putc(51); con_putc(58); con_putc(32); // "CR3: "
    print_hex(p_cr3_read());
    con_putc(10);
}

// ─── Phase 3: Per-process address spaces ─────────────────────────────────
// Each process gets its own PML4. Kernel mappings (identity-mapped first
// 4GB) are copied into every new PML4 so kernel code remains accessible.
// User pages are mapped per-process. CR3 is switched on context switch.
//
// Page table page pool: 0x800000 - 0x8FFFFF (1MB = 256 page tables)
// Per-process PML4 directory: 0x200000 (64 processes × 16 bytes)
//   [0] pml4_addr: i64 — physical address of the process's PML4
//   [8] used: i64 — 1 if in use

pub const PROC_PML4_DIR: i64 = 0x200000;
pub const PT_POOL_BASE: i64 = 0x810000;  // page table page pool
pub const PT_POOL_END: i64 = 0x8FFFFF;
pub var pt_pool_next: i64 = 0x810000;

// Initialize the per-process PML4 directory
pub fn vm_proc_init() -> void {
    var i: i64 = 0;
    while i < 64 * 16 {
        p_mem_write8(PROC_PML4_DIR + i, 0);
        i = i + 1;
    }
    pt_pool_next = PT_POOL_BASE;
    // Process 1 (kernel) uses the existing PML4 at 0x70000
    p_mem_write64(PROC_PML4_DIR, 0x70000);  // pml4_addr
    p_mem_write64(PROC_PML4_DIR + 8, 1);    // used
}

// Allocate a 4KB page table page from the pool
fn pt_alloc() -> i64 {
    if pt_pool_next >= PT_POOL_END { return 0; }
    var addr: i64 = pt_pool_next;
    pt_pool_next = pt_pool_next + 0x1000;
    // Zero the page
    var i: i64 = 0;
    while i < 4096 {
        p_mem_write8(addr + i, 0);
        i = i + 1;
    }
    return addr;
}

// Create a new address space for a process.
// Copies kernel mappings (PML4 entries 0-255 = lower 512GB, identity-mapped)
// from the kernel PML4 into a new PML4.
// Returns the PML4 physical address, or 0 on failure.
pub fn vm_create_address_space(proc_slot: i64) -> i64 {
    // Allocate a new PML4
    var new_pml4: i64 = pt_alloc();
    if new_pml4 == 0 { return 0; }

    // Copy kernel mappings: first 256 PML4 entries (lower 512GB)
    // These are identity-mapped and shared by all processes
    var i: i64 = 0;
    while i < 256 {
        var entry: i64 = p_mem_read64(0x70000 + i * 8);
        p_mem_write64(new_pml4 + i * 8, entry);
        i = i + 1;
    }

    // Record in the per-process PML4 directory
    p_mem_write64(PROC_PML4_DIR + proc_slot * 16, new_pml4);
    p_mem_write64(PROC_PML4_DIR + proc_slot * 16 + 8, 1);

    return new_pml4;
}

// Switch to a process's address space by loading CR3.
// Returns the previous CR3 value.
pub fn vm_switch_address_space(pml4_addr: i64) -> i64 {
    var old_cr3: i64 = p_cr3_read();
    p_cr3_write(pml4_addr);
    return old_cr3;
}

// Get the PML4 address for a process slot
pub fn vm_get_pml4(proc_slot: i64) -> i64 {
    return p_mem_read64(PROC_PML4_DIR + proc_slot * 16);
}

// Map a user page in a specific process's PML4.
// This is like vm_map but operates on a non-kernel PML4.
pub fn vm_map_user(pml4: i64, vaddr: i64, paddr: i64, flags: i64) -> i64 {
    var pml4_idx: i64 = (vaddr >> 39) & 0x1FF;
    var pdpt_idx: i64 = (vaddr >> 30) & 0x1FF;
    var pd_idx: i64 = (vaddr >> 21) & 0x1FF;

    // Get PML4 entry
    var pml4_entry: i64 = p_mem_read64(pml4 + pml4_idx * 8);
    var pdpt_addr: i64 = pml4_entry & 0xFFFFFFFFFFFFF000;
    if pdpt_addr == 0 {
        // Allocate a new PDPT
        pdpt_addr = pt_alloc();
        if pdpt_addr == 0 { return -1; }
        p_mem_write64(pml4 + pml4_idx * 8, pdpt_addr | 0x7);  // present | writable | user
    }

    // Get PDPT entry
    var pdpt_entry: i64 = p_mem_read64(pdpt_addr + pdpt_idx * 8);
    var pd_addr: i64 = pdpt_entry & 0xFFFFFFFFFFFFF000;
    if pd_addr == 0 {
        pd_addr = pt_alloc();
        if pd_addr == 0 { return -1; }
        p_mem_write64(pdpt_addr + pdpt_idx * 8, pd_addr | 0x7);  // present | writable | user
    }

    // Set PD entry as 2MB page (PS bit = 0x80)
    var pd_flags: i64 = 0x87 | (flags & 0x7F);  // present | writable | huge | user
    p_mem_write64(pd_addr + pd_idx * 8, (paddr & 0xFFFFFFFFFFE00000) | pd_flags);

    return 0;
}

// Destroy a process's address space (free the PML4 and user page tables).
// Does NOT free kernel-shared pages (only frees pages allocated from pool).
pub fn vm_destroy_address_space(proc_slot: i64) -> void {
    var pml4: i64 = p_mem_read64(PROC_PML4_DIR + proc_slot * 16);
    if pml4 == 0 { return; }

    // Free user PDPTs (entries 256-511 are user space)
    var i: i64 = 256;
    while i < 512 {
        var pml4_entry: i64 = p_mem_read64(pml4 + i * 8);
        var pdpt_addr: i64 = pml4_entry & 0xFFFFFFFFFFFFF000;
        if pdpt_addr >= PT_POOL_BASE {
            if pdpt_addr < PT_POOL_END {
                // Could free PDPTs and PDs here, but for simplicity
                // we just mark the slot as free. The pool is bump-allocated.
            }
        }
        i = i + 1;
    }

    // Mark the slot as free
    p_mem_write64(PROC_PML4_DIR + proc_slot * 16, 0);
    p_mem_write64(PROC_PML4_DIR + proc_slot * 16 + 8, 0);
}

// Test per-process address spaces
pub fn cmd_vm_proc() -> void {
    con_putc(10);
    // "VM Proc test:"
    con_putc(86); con_putc(77); con_putc(32);  // "VM "
    con_putc(80); con_putc(114); con_putc(111); con_putc(99);  // "Proc"
    con_putc(32);
    con_putc(116); con_putc(101); con_putc(115); con_putc(116); con_putc(58);  // "test:"
    con_putc(10);

    // Create address space for process slot 2
    var pml4_2: i64 = vm_create_address_space(2);
    // "pml4_2="
    con_putc(112); con_putc(109); con_putc(108); con_putc(52); con_putc(95); con_putc(50); con_putc(61);
    print_hex(pml4_2);
    con_putc(10);

    // Verify kernel mappings were copied (entry 0 should be non-zero)
    var entry0: i64 = p_mem_read64(pml4_2);
    // "entry0="
    con_putc(101); con_putc(110); con_putc(116); con_putc(114); con_putc(121); con_putc(48); con_putc(61);
    print_hex(entry0);
    con_putc(10);

    // Map a user page at 0x40000000 (1GB, in user space)
    var r: i64 = vm_map_user(pml4_2, 0x40000000, 0x500000, 0);
    // "map="
    con_putc(109); con_putc(97); con_putc(112); con_putc(61);
    print_dec(r);
    con_putc(10);

    // Create address space for process slot 3
    var pml4_3: i64 = vm_create_address_space(3);
    // "pml4_3="
    con_putc(112); con_putc(109); con_putc(108); con_putc(52); con_putc(95); con_putc(51); con_putc(61);
    print_hex(pml4_3);
    con_putc(10);

    // Verify they're different
    if pml4_2 != pml4_3 {
        con_putc(79); con_putc(75);  // "OK"
    } else {
        con_putc(70); con_putc(65); con_putc(73); con_putc(76);  // "FAIL"
    }
    con_putc(10);

    // Destroy address space 3
    vm_destroy_address_space(3);
    var pml4_after: i64 = vm_get_pml4(3);
    // "after_destroy="
    con_putc(97); con_putc(102); con_putc(116); con_putc(101); con_putc(114); con_putc(61);
    print_hex(pml4_after);
    con_putc(10);
}
