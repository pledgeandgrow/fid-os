// kernel/mouse.fd — PS/2 mouse input
// Mouse uses IRQ12 (vector 0x2C after PIC remap), port 0x60 data, 0x64 status.
// Mouse state at 0x6A0: [x:1, y:1, buttons:1, cycle:1, dx:1, dy:1]

module mouse;

use console;
use framebuffer;

pub const MOUSE_STATE: i64 = 0x6A0;
// Absolute cursor position at 0x6B0 (x:4, y:4)
pub const MOUSE_CURSOR_X: i64 = 0x6B0;
pub const MOUSE_CURSOR_Y: i64 = 0x6B4;

pub fn mouse_init() -> i64 {
    // Enable auxiliary device (mouse) on PS/2 controller
    // outb(0x64, 0xA8) — enable second port
    p_outb(0x64, 0xA8);

    // Read current controller config
    p_outb(0x64, 0x20);
    var config: i64 = p_inb(0x60);
    // Set bit 1 (enable IRQ12) and bit 5 (enable auxiliary clock)
    config = config | 0x02 | 0x20;
    p_outb(0x64, 0x60);
    p_outb(0x60, config);

    // Set defaults on mouse
    p_outb(0x64, 0xD4);  // send to mouse
    p_outb(0x60, 0xF6);  // set defaults
    var ack: i64 = p_inb(0x60);  // read ACK (0xFA)

    // Enable data reporting
    p_outb(0x64, 0xD4);
    p_outb(0x60, 0xF4);  // enable reporting
    ack = p_inb(0x60);  // read ACK

    // Initialize state
    p_mem_write8(MOUSE_STATE, 0);      // x
    p_mem_write8(MOUSE_STATE + 1, 0);  // y
    p_mem_write8(MOUSE_STATE + 2, 0);  // buttons
    p_mem_write8(MOUSE_STATE + 3, 0);  // cycle
    // Initialize cursor position (center of screen)
    p_mem_write32(MOUSE_CURSOR_X, 320);
    p_mem_write32(MOUSE_CURSOR_Y, 240);

    return 0;
}

// IRQ12 mouse handler (vector 0x2C)
@interrupt(0x2C) fn irq12_mouse_handler() -> void {
    var data: i64 = p_inb(0x60);
    var cycle: i64 = p_mem_read8(MOUSE_STATE + 3);

    if cycle == 0 {
        // Byte 1: buttons and sign bits
        p_mem_write8(MOUSE_STATE + 2, data & 0x07);  // buttons
        p_mem_write8(MOUSE_STATE + 4, (data >> 4) & 0x01);  // x sign
        p_mem_write8(MOUSE_STATE + 5, (data >> 5) & 0x01);  // y sign
        cycle = 1;
    } else if cycle == 1 {
        // Byte 2: x movement
        p_mem_write8(MOUSE_STATE, data);
        cycle = 2;
    } else {
        // Byte 3: y movement
        p_mem_write8(MOUSE_STATE + 1, data);
        // Update absolute cursor position
        var dx: i64 = p_mem_read8(MOUSE_STATE);
        var dy: i64 = p_mem_read8(MOUSE_STATE + 1);
        var x_sign: i64 = p_mem_read8(MOUSE_STATE + 4);
        var y_sign: i64 = p_mem_read8(MOUSE_STATE + 5);
        // Apply sign
        if x_sign == 1 { dx = dx - 256; }
        if y_sign == 1 { dy = dy - 256; }
        // Update cursor (y is inverted in screen coordinates)
        var cur_x: i64 = p_mem_read32(MOUSE_CURSOR_X);
        var cur_y: i64 = p_mem_read32(MOUSE_CURSOR_Y);
        cur_x = cur_x + dx;
        cur_y = cur_y - dy;  // mouse y is inverted
        // Clamp to screen bounds
        if cur_x < 0 { cur_x = 0; }
        if cur_x > 639 { cur_x = 639; }
        if cur_y < 0 { cur_y = 0; }
        if cur_y > 479 { cur_y = 479; }
        p_mem_write32(MOUSE_CURSOR_X, cur_x);
        p_mem_write32(MOUSE_CURSOR_Y, cur_y);
        cycle = 0;
    }
    p_mem_write8(MOUSE_STATE + 3, cycle);

    // Send EOI to both PICs (IRQ12 is on slave)
    p_outb(0xA0, 0x20);  // EOI to slave
    p_outb(0x20, 0x20);  // EOI to master
}

pub fn cmd_mouse() -> void {
    con_putc(10);
    // "Mouse: "
    con_putc(77); con_putc(111); con_putc(117); con_putc(115); con_putc(101); con_putc(58); con_putc(32);
    var buttons: i64 = p_mem_read8(MOUSE_STATE + 2);
    var dx: i64 = p_mem_read8(MOUSE_STATE);
    var dy: i64 = p_mem_read8(MOUSE_STATE + 1);
    con_putc(98); con_putc(58); con_putc(32); // "b: "
    print_dec(buttons);
    con_putc(32);
    con_putc(120); con_putc(58); con_putc(32); // "x: "
    print_dec(dx);
    con_putc(32);
    con_putc(121); con_putc(58); con_putc(32); // "y: "
    print_dec(dy);
    con_putc(10);
    // Print absolute cursor position
    con_putc(99); con_putc(117); con_putc(114); con_putc(115); con_putc(111); con_putc(114); // "cursor"
    con_putc(58); con_putc(32);
    print_dec(p_mem_read32(MOUSE_CURSOR_X));
    con_putc(44); // ","
    print_dec(p_mem_read32(MOUSE_CURSOR_Y));
    con_putc(10);
}

// Draw a mouse cursor on the framebuffer (simple crosshair)
pub fn mouse_draw_cursor() -> void {
    var x: i64 = p_mem_read32(MOUSE_CURSOR_X);
    var y: i64 = p_mem_read32(MOUSE_CURSOR_Y);
    // Draw a 7x7 crosshair cursor
    var i: i64 = -3;
    while i <= 3 {
        // Horizontal line
        fb_putpixel(x + i, y, 0x00FFFFFF);
        // Vertical line
        fb_putpixel(x, y + i, 0x00FFFFFF);
        i = i + 1;
    }
}

// Get cursor X position
pub fn mouse_get_x() -> i64 {
    return p_mem_read32(MOUSE_CURSOR_X);
}

// Get cursor Y position
pub fn mouse_get_y() -> i64 {
    return p_mem_read32(MOUSE_CURSOR_Y);
}

// Get mouse buttons
pub fn mouse_get_buttons() -> i64 {
    return p_mem_read8(MOUSE_STATE + 2);
}
