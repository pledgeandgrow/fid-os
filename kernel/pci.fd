// kernel/pci.fd — PCI bus enumeration
// PCI config space access via ports 0xCF8 (address) and 0xCFC (data)

module pci;

use console;

pub const PCI_ADDR: i64 = 0xCF8;
pub const PCI_DATA: i64 = 0xCFC;

pub fn pci_config_read(bus: i64, dev: i64, func: i64, offset: i64) -> i64 {
    // Enable bit 31, bus 23-16, dev 15-11, func 10-8, offset 7-2
    var addr: i64 = (1 << 31) | (bus << 16) | (dev << 11) | (func << 8) | (offset & 0xFC);
    p_outl(PCI_ADDR, addr);
    return p_inl(PCI_DATA);
}

pub fn pci_config_write(bus: i64, dev: i64, func: i64, offset: i64, val: i64) {
    var addr: i64 = (1 << 31) | (bus << 16) | (dev << 11) | (func << 8) | (offset & 0xFC);
    p_outl(PCI_ADDR, addr);
    p_outl(PCI_DATA, val);
}

pub fn pci_get_vendor(bus: i64, dev: i64, func: i64) -> i64 {
    return pci_config_read(bus, dev, func, 0) & 0xFFFF;
}

pub fn pci_get_device(bus: i64, dev: i64, func: i64) -> i64 {
    return (pci_config_read(bus, dev, func, 0) >> 16) & 0xFFFF;
}

pub fn pci_get_class(bus: i64, dev: i64, func: i64) -> i64 {
    return (pci_config_read(bus, dev, func, 8) >> 24) & 0xFF;
}

pub fn pci_get_subclass(bus: i64, dev: i64, func: i64) -> i64 {
    return (pci_config_read(bus, dev, func, 8) >> 16) & 0xFF;
}

// PCI device table at 0x150000 (up to 256 entries × 16 bytes)
pub const PCI_TABLE: i64 = 0x150000;
pub var pci_device_count: i64 = 0;

pub fn pci_scan() -> i64 {
    pci_device_count = 0;
    var bus: i64 = 0;
    while bus < 256 {
        var dev: i64 = 0;
        while dev < 32 {
            var func: i64 = 0;
            while func < 8 {
                var vendor: i64 = pci_get_vendor(bus, dev, func);
                if vendor != 0xFFFF {
                    var device: i64 = pci_get_device(bus, dev, func);
                    var class_code: i64 = pci_get_class(bus, dev, func);
                    var subclass: i64 = pci_get_subclass(bus, dev, func);
                    // Store in table: vendor, device, class, subclass
                    var idx: i64 = pci_device_count * 16;
                    p_mem_write64(PCI_TABLE + idx, vendor);
                    p_mem_write64(PCI_TABLE + idx + 8, (device << 48) | (class_code << 40) | (subclass << 32) | (bus << 16) | (dev << 8) | func);
                    pci_device_count = pci_device_count + 1;
                    if pci_device_count >= 256 { return pci_device_count; }
                }
                func = func + 1;
            }
            dev = dev + 1;
        }
        bus = bus + 1;
    }
    return pci_device_count;
}

pub fn cmd_pci() -> void {
    con_putc(10);
    // "PCI Devices:"
    con_putc(80); con_putc(67); con_putc(73); con_putc(32); con_putc(68); con_putc(101); con_putc(118); con_putc(105); con_putc(99); con_putc(101); con_putc(115); con_putc(58);
    con_putc(10);
    var i: i64 = 0;
    while i < pci_device_count {
        var idx: i64 = i * 16;
        var vendor: i64 = p_mem_read64(PCI_TABLE + idx);
        var packed_val: i64 = p_mem_read64(PCI_TABLE + idx + 8);
        var device: i64 = (packed_val >> 48) & 0xFFFF;
        var class_code: i64 = (packed_val >> 40) & 0xFF;
        var bus: i64 = (packed_val >> 16) & 0xFF;
        var dev: i64 = (packed_val >> 8) & 0xFF;
        var func: i64 = packed_val & 0xFF;
        // Print bus:dev.func vendor:device class
        print_dec(bus); con_putc(58); print_dec(dev); con_putc(46); print_dec(func);
        con_putc(32);
        con_putc(118); con_putc(101); con_putc(110); con_putc(100); con_putc(111); con_putc(114); con_putc(58); // "vendor:"
        con_putc(32);
        print_hex(vendor);
        con_putc(32);
        con_putc(100); con_putc(101); con_putc(118); con_putc(58); // "dev:"
        con_putc(32);
        print_hex(device);
        con_putc(32);
        con_putc(99); con_putc(108); con_putc(115); con_putc(58); // "cls:"
        con_putc(32);
        print_hex(class_code);
        con_putc(10);
        i = i + 1;
    }
    if pci_device_count == 0 {
        con_putc(78); con_putc(111); con_putc(110); con_putc(101); // "None"
        con_putc(10);
    }
}
