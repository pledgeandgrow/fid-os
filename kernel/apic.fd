// kernel/apic.fd — LAPIC timer and interrupt controller
// LAPIC registers are MMIO at 0xFEE00000.

module apic;

use console;

pub const LAPIC_BASE: i64 = 0xFEE00000;
pub const LAPIC_EOI:  i64 = 0xFEE000B0;
pub const LAPIC_TPR:  i64 = 0xFEE00080;
pub const LAPIC_LVT_TIMER: i64 = 0xFEE00320;
pub const LAPIC_TIMER_INIT: i64 = 0xFEE00380;
pub const LAPIC_TIMER_CURRENT: i64 = 0xFEE00390;
pub const LAPIC_TIMER_DIV: i64 = 0xFEE003E0;

// Map the LAPIC MMIO region (0xFEE00000, 2MB page) into the page tables.
// Must be called before any apic_read/apic_write.
// PCD bit (0x10) set to disable caching for MMIO.
// Uses only 32-bit memory ops to avoid PE backend 64-bit codegen issues.
pub fn lapic_map_mmio() {
    var addr: i64 = LAPIC_BASE;
    var pml4_idx: i64 = (addr >> 39) & 0x1FF;
    var pdpt_idx: i64 = (addr >> 30) & 0x1FF;
    var pd_idx: i64 = (addr >> 21) & 0x1FF;

    // Read PML4 entry (using 32-bit reads)
    var pml4_entry_lo: i64 = p_mem_read32(0x70000 + pml4_idx * 8);
    var pdpt_addr: i64 = pml4_entry_lo & 0xFFFFF000;
    if pdpt_addr == 0 {
        pdpt_addr = 0x75000;
        var i: i64 = 0;
        while i < 1024 {
            p_mem_write32(pdpt_addr + i * 4, 0);
            i = i + 1;
        }
        p_mem_write32(0x70000 + pml4_idx * 8, pdpt_addr | 0x3);
        p_mem_write32(0x70000 + pml4_idx * 8 + 4, 0);
    }

    // Read PDPT entry
    var pdpt_entry_lo: i64 = p_mem_read32(pdpt_addr + pdpt_idx * 8);
    var pd_addr: i64 = pdpt_entry_lo & 0xFFFFF000;
    if pd_addr == 0 {
        pd_addr = 0x320000 + pdpt_idx * 0x1000;
        var i: i64 = 0;
        while i < 1024 {
            p_mem_write32(pd_addr + i * 4, 0);
            i = i + 1;
        }
        p_mem_write32(pdpt_addr + pdpt_idx * 8, pd_addr | 0x3);
        p_mem_write32(pdpt_addr + pdpt_idx * 8 + 4, 0);
    }

    // Set PD entry: 2MB page, present + writable + PS + PCD = 0x93
    var page_addr: i64 = addr & 0xFFE00000;
    p_mem_write32(pd_addr + pd_idx * 8, page_addr | 0x93);
    p_mem_write32(pd_addr + pd_idx * 8 + 4, 0);
    p_invlpg(addr);
}

pub fn apic_write(reg: i64, val: i64) {
    p_mem_write32(reg, val);
}

pub fn apic_read(reg: i64) -> i64 {
    return p_mem_read32(reg);
}

pub fn apic_init() -> i64 {
    // Map LAPIC MMIO region first
    lapic_map_mmio();
    // Enable LAPIC by setting bit 8 of the Spurious Interrupt Vector Register
    // SIVR is at 0xFEE000F0
    apic_write(0xFEE000F0, 0x100 | 0xFF);  // Enable + vector 0xFF

    // Mask LVT timer for now
    apic_write(LAPIC_LVT_TIMER, 0x10000);  // masked

    // Set timer divide to 16 (0x3 = divide by 16)
    apic_write(LAPIC_TIMER_DIV, 0x3);

    // Set initial count
    apic_write(LAPIC_TIMER_INIT, 0x100000);

    return 0;
}

pub fn cmd_apic() -> void {
    con_putc(10);
    // "APIC: "
    con_putc(65); con_putc(80); con_putc(73); con_putc(67); con_putc(58); con_putc(32);
    var result: i64 = apic_init();
    if result == 0 {
        con_putc(105); con_putc(110); con_putc(105); con_putc(116); // "init"
        con_putc(32);
        con_putc(79); con_putc(75); // "OK"
    } else {
        con_putc(102); con_putc(97); con_putc(105); con_putc(108); // "fail"
    }
    con_putc(10);
    // Print timer current count
    var current: i64 = apic_read(LAPIC_TIMER_CURRENT);
    con_putc(99); con_putc(110); con_putc(116); con_putc(58); con_putc(32); // "cnt: "
    print_hex(current);
    con_putc(10);
}

// Enable LAPIC timer in periodic mode
// vector: interrupt vector (e.g., 0x20)
// count: initial count (determines frequency)
pub fn lapic_timer_enable(vector: i64, count: i64) -> void {
    // Set divide to 16
    apic_write(LAPIC_TIMER_DIV, 0x3);
    // Set initial count
    apic_write(LAPIC_TIMER_INIT, count);
    // Set LVT timer: vector, periodic mode (bit 17), unmasked
    apic_write(LAPIC_LVT_TIMER, 0x20000 | vector);
}

// Disable (mask) LAPIC timer
pub fn lapic_timer_disable() -> void {
    apic_write(LAPIC_LVT_TIMER, 0x10000);  // masked
}

// Get LAPIC timer current count
pub fn lapic_timer_count() -> i64 {
    return apic_read(LAPIC_TIMER_CURRENT);
}

// Get LAPIC ID
pub fn lapic_get_id() -> i64 {
    return apic_read(0xFEE00020) >> 24;
}
