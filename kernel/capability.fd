// kernel/capability.fd — Capability table (fractal kernel phase 1)
//
// A capability is an unforgeable handle (i64) that grants permission
// to access a resource. Instead of hardcoded addresses, modules and
// processes receive capabilities and can only access what they're given.
//
// Capability entry (32 bytes):
//   [0]  type:     i64 — resource type (CAP_TYPE_*)
//   [8]  perms:    i64 — permission bitmask (CAP_PERM_*)
//   [16] base:    i64 — base address / start sector / resource ID
//   [24] size:    i64 — size of resource (bytes, sectors, or 0)
//
// Table: 128 capabilities × 32 bytes = 4 KB at 0x1E0000

module capability;

use console;
use keyboard;
use framebuffer;
use pci;

// ─── Capability table ────────────────────────────────────────────────────
pub const CAP_TABLE: i64 = 0x1E0000;
pub const CAP_MAX: i64 = 128;
pub const CAP_ENTRY_SIZE: i64 = 32;

// ─── Resource types ───────────────────────────────────────────────────────
pub const CAP_TYPE_NONE: i64 = 0;
pub const CAP_TYPE_MMIO: i64 = 1;      // memory-mapped I/O region
pub const CAP_TYPE_MEMORY: i64 = 2;    // RAM region
pub const CAP_TYPE_DISK: i64 = 3;      // disk sectors
pub const CAP_TYPE_NETWORK: i64 = 4;   // network interface
pub const CAP_TYPE_CONSOLE: i64 = 5;   // console / VGA output
pub const CAP_TYPE_KEYBOARD: i64 = 6;  // keyboard input
pub const CAP_TYPE_MESSAGE: i64 = 7;   // message endpoint
pub const CAP_TYPE_IRQ: i64 = 8;       // interrupt line

// ─── Permission bits ─────────────────────────────────────────────────────
pub const CAP_PERM_READ: i64 = 1;      // read from resource
pub const CAP_PERM_WRITE: i64 = 2;     // write to resource
pub const CAP_PERM_EXEC: i64 = 4;      // execute (for memory)
pub const CAP_PERM_SEND: i64 = 8;       // send messages
pub const CAP_PERM_RECV: i64 = 16;      // receive messages
pub const CAP_PERM_GRANT: i64 = 32;     // can grant child capabilities

// ─── Initialize the capability table ──────────────────────────────────────

pub fn capability_init() -> void {
    var i: i64 = 0;
    while i < CAP_MAX * CAP_ENTRY_SIZE {
        p_mem_write8(CAP_TABLE + i, 0);
        i = i + 1;
    }
}

// ─── Create a capability ─────────────────────────────────────────────────
// Returns capability handle (index + 1) or 0 if table is full.

pub fn capability_create(cap_type: i64, perms: i64, base: i64, size: i64) -> i64 {
    var i: i64 = 0;
    while i < CAP_MAX {
        var entry: i64 = CAP_TABLE + i * CAP_ENTRY_SIZE;
        if p_mem_read64(entry) == CAP_TYPE_NONE {
            p_mem_write64(entry, cap_type);
            p_mem_write64(entry + 8, perms);
            p_mem_write64(entry + 16, base);
            p_mem_write64(entry + 24, size);
            return i + 1;  // handle = index + 1 (0 = invalid)
        }
        i = i + 1;
    }
    return 0;  // table full
}

// ─── Check if a capability has a permission ──────────────────────────────
// Returns 1 if granted, 0 if denied or invalid.

pub fn capability_check(handle: i64, perm: i64) -> i64 {
    if handle <= 0 { return 0; }
    if handle > CAP_MAX { return 0; }
    var entry: i64 = CAP_TABLE + (handle - 1) * CAP_ENTRY_SIZE;
    var cap_type: i64 = p_mem_read64(entry);
    if cap_type == CAP_TYPE_NONE { return 0; }
    var perms: i64 = p_mem_read64(entry + 8);
    if (perms & perm) != 0 { return 1; }
    return 0;
}

// ─── Get capability fields ────────────────────────────────────────────────

pub fn capability_get_type(handle: i64) -> i64 {
    if handle <= 0 { return CAP_TYPE_NONE; }
    if handle > CAP_MAX { return CAP_TYPE_NONE; }
    return p_mem_read64(CAP_TABLE + (handle - 1) * CAP_ENTRY_SIZE);
}

pub fn capability_get_base(handle: i64) -> i64 {
    if handle <= 0 { return 0; }
    if handle > CAP_MAX { return 0; }
    return p_mem_read64(CAP_TABLE + (handle - 1) * CAP_ENTRY_SIZE + 16);
}

pub fn capability_get_size(handle: i64) -> i64 {
    if handle <= 0 { return 0; }
    if handle > CAP_MAX { return 0; }
    return p_mem_read64(CAP_TABLE + (handle - 1) * CAP_ENTRY_SIZE + 24);
}

pub fn capability_get_perms(handle: i64) -> i64 {
    if handle <= 0 { return 0; }
    if handle > CAP_MAX { return 0; }
    return p_mem_read64(CAP_TABLE + (handle - 1) * CAP_ENTRY_SIZE + 8);
}

// ─── Revoke a capability (clear the entry) ────────────────────────────────

pub fn capability_revoke(handle: i64) -> void {
    if handle <= 0 { return; }
    if handle > CAP_MAX { return; }
    var entry: i64 = CAP_TABLE + (handle - 1) * CAP_ENTRY_SIZE;
    p_mem_write64(entry, CAP_TYPE_NONE);
    p_mem_write64(entry + 8, 0);
    p_mem_write64(entry + 16, 0);
    p_mem_write64(entry + 24, 0);
}

// ─── Grant a child capability ─────────────────────────────────────────────
// Creates a new capability with the same type and base, but optionally
// fewer permissions and/or smaller size. The parent must have CAP_PERM_GRANT.
// Returns child handle or 0 if denied.

pub fn capability_grant(handle: i64, new_perms: i64, new_size: i64) -> i64 {
    // Check parent has grant permission
    if capability_check(handle, CAP_PERM_GRANT) == 0 { return 0; }

    var cap_type: i64 = capability_get_type(handle);
    var base: i64 = capability_get_base(handle);

    // Child permissions must be a subset of parent's
    var parent_perms: i64 = capability_get_perms(handle);
    var child_perms: i64 = new_perms & parent_perms;

    // Child size must not exceed parent's
    var parent_size: i64 = capability_get_size(handle);
    var child_size: i64 = new_size;
    if child_size > parent_size { child_size = parent_size; }
    if child_size == 0 { child_size = parent_size; }

    return capability_create(cap_type, child_perms, base, child_size);
}

// ─── Restrict a capability (create child with fewer perms) ────────────────
// Convenience: same as capability_grant but keeps the same size.

pub fn capability_restrict(handle: i64, new_perms: i64) -> i64 {
    return capability_grant(handle, new_perms, 0);
}

// ─── Debug: list all capabilities ─────────────────────────────────────────

pub fn cmd_caps() -> void {
    con_putc(10);
    // "Caps:"
    con_putc(67); con_putc(97); con_putc(112); con_putc(115); con_putc(58);
    con_putc(10);

    var i: i64 = 0;
    while i < CAP_MAX {
        var entry: i64 = CAP_TABLE + i * CAP_ENTRY_SIZE;
        var cap_type: i64 = p_mem_read64(entry);
        if cap_type != CAP_TYPE_NONE {
            var perms: i64 = p_mem_read64(entry + 8);
            var base: i64 = p_mem_read64(entry + 16);
            var size: i64 = p_mem_read64(entry + 24);

            // Print handle
            con_putc(35);  // '#'
            print_dec(i + 1);
            con_putc(32);

            // Print type name
            if cap_type == CAP_TYPE_MMIO {
                con_putc(77); con_putc(77); con_putc(73); con_putc(79);  // "MMIO"
            } else if cap_type == CAP_TYPE_MEMORY {
                con_putc(77); con_putc(101); con_putc(109);  // "Mem"
            } else if cap_type == CAP_TYPE_DISK {
                con_putc(68); con_putc(105); con_putc(115); con_putc(107);  // "Disk"
            } else if cap_type == CAP_TYPE_NETWORK {
                con_putc(78); con_putc(101); con_putc(116);  // "Net"
            } else if cap_type == CAP_TYPE_CONSOLE {
                con_putc(67); con_putc(111); con_putc(110);  // "Con"
            } else if cap_type == CAP_TYPE_KEYBOARD {
                con_putc(75); con_putc(98); con_putc(100);  // "Kbd"
            } else if cap_type == CAP_TYPE_MESSAGE {
                con_putc(77); con_putc(115); con_putc(103);  // "Msg"
            } else if cap_type == CAP_TYPE_IRQ {
                con_putc(73); con_putc(82); con_putc(81);  // "IRQ"
            }
            con_putc(32);

            // Print permissions
            if (perms & CAP_PERM_READ) != 0 { con_putc(82); }  // 'R'
            if (perms & CAP_PERM_WRITE) != 0 { con_putc(87); }  // 'W'
            if (perms & CAP_PERM_EXEC) != 0 { con_putc(88); }  // 'X'
            if (perms & CAP_PERM_SEND) != 0 { con_putc(83); }  // 'S'
            if (perms & CAP_PERM_RECV) != 0 { con_putc(82); }  // 'R' (recv)
            if (perms & CAP_PERM_GRANT) != 0 { con_putc(71); }  // 'G'
            con_putc(32);

            // Print base
            con_putc(98); con_putc(58);  // "b:"
            print_hex(base);
            con_putc(32);

            // Print size
            con_putc(115); con_putc(58);  // "s:"
            print_dec(size);
            con_putc(10);
        }
        i = i + 1;
    }
}

// ─── Capability-gated console (fractal kernel) ───────────────────────────
// Wraps con_putc / vga_clear with capability checks. A caller must present
// a CAP_TYPE_CONSOLE capability with WRITE permission to output, and
// READ permission to read the input buffer.
// Root console capability handle (created at boot in shell.fd): handle 1.

// Write a character using a console capability.
// Returns 0 on success, -1 if denied.
pub fn con_cap_putc(console_cap: i64, c: i64) -> i64 {
    if capability_get_type(console_cap) != 5 { return -1; }  // CAP_TYPE_CONSOLE
    if capability_check(console_cap, 2) == 0 { return -1; }  // CAP_PERM_WRITE
    con_putc(c);
    return 0;
}

// Write a string using a console capability.
pub fn con_cap_putn(console_cap: i64, addr: i64, len: i64) -> i64 {
    if capability_get_type(console_cap) != 5 { return -1; }
    if capability_check(console_cap, 2) == 0 { return -1; }
    con_putn(addr, len);
    return 0;
}

// Clear the screen using a console capability.
pub fn con_cap_clear(console_cap: i64) -> i64 {
    if capability_get_type(console_cap) != 5 { return -1; }
    if capability_check(console_cap, 2) == 0 { return -1; }
    vga_clear();
    return 0;
}

// Read input buffer using a console capability (READ permission).
// Returns the byte at index, or -1 if denied.
pub fn con_cap_input_get(console_cap: i64, idx: i64) -> i64 {
    if capability_get_type(console_cap) != 5 { return -1; }
    if capability_check(console_cap, 1) == 0 { return -1; }  // CAP_PERM_READ
    return input_get(idx);
}

// Print a decimal integer using a console capability.
pub fn con_cap_print_dec(console_cap: i64, n: i64) -> i64 {
    if capability_get_type(console_cap) != 5 { return -1; }
    if capability_check(console_cap, 2) == 0 { return -1; }
    print_dec(n);
    return 0;
}

// Print a hex integer using a console capability.
pub fn con_cap_print_hex(console_cap: i64, n: i64) -> i64 {
    if capability_get_type(console_cap) != 5 { return -1; }
    if capability_check(console_cap, 2) == 0 { return -1; }
    print_hex(n);
    return 0;
}

// Test the capability-gated console.
pub fn cmd_capcon() -> void {
    con_putc(10);
    // "CapCon test:"
    con_putc(67); con_putc(97); con_putc(112); con_putc(67); con_putc(111); con_putc(110);  // "CapCon"
    con_putc(32);
    con_putc(116); con_putc(101); con_putc(115); con_putc(116); con_putc(58);  // "test:"
    con_putc(10);

    // Root console cap is handle 1 (created at boot)
    var root_cap: i64 = 1;

    // Verify it exists
    if capability_get_type(root_cap) != 5 {
        con_putc(78); con_putc(111); con_putc(32); con_putc(99); con_putc(111); con_putc(110);  // "No con"
        con_putc(10);
        return;
    }

    // "root="
    con_putc(114); con_putc(111); con_putc(111); con_putc(116); con_putc(61);
    print_dec(root_cap);
    con_putc(32);
    con_putc(112); con_putc(101); con_putc(114); con_putc(109); con_putc(115); con_putc(61);  // "perms="
    print_dec(capability_get_perms(root_cap));
    con_putc(10);

    // Grant a write-only child (no GRANT, no READ)
    var write_only: i64 = capability_grant(root_cap, 2, 0);  // WRITE only
    // "wo="
    con_putc(119); con_putc(111); con_putc(61);
    print_dec(write_only);
    con_putc(32);
    con_putc(112); con_putc(101); con_putc(114); con_putc(109); con_putc(115); con_putc(61);
    print_dec(capability_get_perms(write_only));
    con_putc(10);

    // Write with write-only cap — should succeed (0)
    var r1: i64 = con_cap_putc(write_only, 72);  // 'H'
    con_cap_putc(write_only, 73);  // 'I'
    con_cap_putc(write_only, 10);
    // "write="
    con_putc(119); con_putc(114); con_putc(105); con_putc(116); con_putc(101); con_putc(61);
    print_dec(r1);
    con_putc(10);

    // Try to read input with write-only cap — should fail (-1)
    var r2: i64 = con_cap_input_get(write_only, 0);
    // "read="
    con_putc(114); con_putc(101); con_putc(97); con_putc(100); con_putc(61);
    print_dec(r2);
    con_putc(32);
    con_putc(40); con_putc(115); con_putc(104); con_putc(111); con_putc(117); con_putc(108); con_putc(100);  // "(should"
    con_putc(32); con_putc(98); con_putc(101); con_putc(32); con_putc(45); con_putc(49); con_putc(41);  // " be -1)"
    con_putc(10);

    // Read with root cap — should succeed
    var r3: i64 = con_cap_input_get(root_cap, 0);
    // "rootread="
    con_putc(114); con_putc(114); con_putc(61);
    print_dec(r3);
    con_putc(10);

    // Revoke the write-only cap
    capability_revoke(write_only);
    // Try to write with revoked cap — should fail (-1)
    var r4: i64 = con_cap_putc(write_only, 88);  // 'X'
    // "revoked="
    con_putc(114); con_putc(101); con_putc(118); con_putc(61);
    print_dec(r4);
    con_putc(32);
    con_putc(40); con_putc(115); con_putc(104); con_putc(111); con_putc(117); con_putc(108); con_putc(100);  // "(should"
    con_putc(32); con_putc(98); con_putc(101); con_putc(32); con_putc(45); con_putc(49); con_putc(41);
    con_putc(10);
}

// ─── Capability-gated keyboard (fractal kernel) ──────────────────────────
// Root keyboard capability handle (created at boot): handle 4
// (CAP_TYPE_KEYBOARD, perms=READ|GRANT, base=0x60, size=2)

// Read a scancode using a keyboard capability (READ permission).
// Returns the scancode, or -1 if denied.
pub fn kbd_cap_read_scancode(kbd_cap: i64) -> i64 {
    if capability_get_type(kbd_cap) != 6 { return -1; }  // CAP_TYPE_KEYBOARD
    if capability_check(kbd_cap, 1) == 0 { return -1; }  // CAP_PERM_READ
    return kbd_read_scancode();
}

// Convert scancode to ASCII using a keyboard capability.
pub fn kbd_cap_to_ascii(kbd_cap: i64, sc: i64) -> i64 {
    if capability_get_type(kbd_cap) != 6 { return -1; }
    if capability_check(kbd_cap, 1) == 0 { return -1; }
    return scancode_to_ascii(sc);
}

// Test the capability-gated keyboard.
pub fn cmd_capkbd() -> void {
    con_putc(10);
    // "CapKbd test:"
    con_putc(67); con_putc(97); con_putc(112); con_putc(75); con_putc(98); con_putc(100);  // "CapKbd"
    con_putc(32);
    con_putc(116); con_putc(101); con_putc(115); con_putc(116); con_putc(58);  // "test:"
    con_putc(10);

    // Root keyboard cap is handle 4 (created at boot)
    var root_cap: i64 = 4;
    if capability_get_type(root_cap) != 6 {
        con_putc(78); con_putc(111); con_putc(32); con_putc(107); con_putc(98); con_putc(100);  // "No kbd"
        con_putc(10);
        return;
    }

    // "root="
    con_putc(114); con_putc(111); con_putc(111); con_putc(116); con_putc(61);
    print_dec(root_cap);
    con_putc(32);
    con_putc(112); con_putc(101); con_putc(114); con_putc(109); con_putc(115); con_putc(61);
    print_dec(capability_get_perms(root_cap));
    con_putc(10);

    // Grant a read-only child (READ only, no GRANT)
    var ro_cap: i64 = capability_grant(root_cap, 1, 0);
    // "ro="
    con_putc(114); con_putc(111); con_putc(61);
    print_dec(ro_cap);
    con_putc(32);
    con_putc(112); con_putc(101); con_putc(114); con_putc(109); con_putc(115); con_putc(61);
    print_dec(capability_get_perms(ro_cap));
    con_putc(10);

    // Read scancode with read-only cap — should work (returns 0 if no key)
    var sc: i64 = kbd_cap_read_scancode(ro_cap);
    // "sc="
    con_putc(115); con_putc(99); con_putc(61);
    print_dec(sc);
    con_putc(10);

    // Revoke and test denial
    capability_revoke(ro_cap);
    var sc2: i64 = kbd_cap_read_scancode(ro_cap);
    // "revoked="
    con_putc(114); con_putc(101); con_putc(118); con_putc(61);
    print_dec(sc2);
    con_putc(32);
    con_putc(40); con_putc(115); con_putc(104); con_putc(111); con_putc(117); con_putc(108); con_putc(100);
    con_putc(32); con_putc(98); con_putc(101); con_putc(32); con_putc(45); con_putc(49); con_putc(41);
    con_putc(10);
}

// ─── Capability-gated framebuffer (fractal kernel) ───────────────────────
// Uses CAP_TYPE_MMIO (1) or CAP_TYPE_MEMORY (2) for framebuffer access.
// The framebuffer is memory-mapped, so we use the memory capability.
// Root memory cap handle (created at boot): handle 5
// (CAP_TYPE_MEMORY, perms=READ|WRITE|GRANT, base=0x300000, size=0x100000)
// The framebuffer itself is at a different address (from multiboot2 info),
// so we create a separate FB capability at boot.

// Draw a pixel using a memory capability (WRITE permission).
pub fn fb_cap_putpixel(fb_cap: i64, x: i64, y: i64, color: i64) -> i64 {
    // Accept MMIO or MEMORY type
    var cap_type: i64 = capability_get_type(fb_cap);
    if cap_type != 1 {
        if cap_type != 2 { return -1; }
    }
    if capability_check(fb_cap, 2) == 0 { return -1; }  // CAP_PERM_WRITE
    fb_putpixel(x, y, color);
    return 0;
}

// Fill a rectangle using a memory capability.
pub fn fb_cap_fillrect(fb_cap: i64, x: i64, y: i64, w: i64, h: i64, color: i64) -> i64 {
    var cap_type: i64 = capability_get_type(fb_cap);
    if cap_type != 1 {
        if cap_type != 2 { return -1; }
    }
    if capability_check(fb_cap, 2) == 0 { return -1; }
    fb_fillrect(x, y, w, h, color);
    return 0;
}

// Clear the framebuffer using a memory capability.
pub fn fb_cap_clear(fb_cap: i64) -> i64 {
    var cap_type: i64 = capability_get_type(fb_cap);
    if cap_type != 1 {
        if cap_type != 2 { return -1; }
    }
    if capability_check(fb_cap, 2) == 0 { return -1; }
    fb_clear_screen();
    return 0;
}

// Test the capability-gated framebuffer.
pub fn cmd_capfb() -> void {
    con_putc(10);
    // "CapFB test:"
    con_putc(67); con_putc(97); con_putc(112); con_putc(70); con_putc(66);  // "CapFB"
    con_putc(32);
    con_putc(116); con_putc(101); con_putc(115); con_putc(116); con_putc(58);
    con_putc(10);

    // Use root memory cap (handle 5) for framebuffer access
    var root_cap: i64 = 5;
    if capability_get_type(root_cap) == 0 {
        con_putc(78); con_putc(111); con_putc(32); con_putc(109); con_putc(101); con_putc(109);  // "No mem"
        con_putc(10);
        return;
    }

    // "root="
    con_putc(114); con_putc(111); con_putc(111); con_putc(116); con_putc(61);
    print_dec(root_cap);
    con_putc(32);
    con_putc(116); con_putc(121); con_putc(112); con_putc(101); con_putc(61);
    print_dec(capability_get_type(root_cap));
    con_putc(32);
    con_putc(112); con_putc(101); con_putc(114); con_putc(109); con_putc(115); con_putc(61);
    print_dec(capability_get_perms(root_cap));
    con_putc(10);

    // Grant a write-only child (WRITE only, no READ, no GRANT)
    var wo_cap: i64 = capability_grant(root_cap, 2, 0);
    // "wo="
    con_putc(119); con_putc(111); con_putc(61);
    print_dec(wo_cap);
    con_putc(10);

    // Draw a pixel with write-only cap — should succeed (0)
    var r1: i64 = fb_cap_putpixel(wo_cap, 10, 10, 0xFF0000);
    // "pixel="
    con_putc(112); con_putc(105); con_putc(120); con_putc(101); con_putc(108); con_putc(61);
    print_dec(r1);
    con_putc(10);

    // Fill a rect with write-only cap — should succeed
    var r2: i64 = fb_cap_fillrect(wo_cap, 20, 20, 50, 30, 0x00FF00);
    // "rect="
    con_putc(114); con_putc(101); con_putc(99); con_putc(116); con_putc(61);
    print_dec(r2);
    con_putc(10);

    // Revoke and test denial
    capability_revoke(wo_cap);
    var r3: i64 = fb_cap_putpixel(wo_cap, 10, 10, 0xFF0000);
    // "revoked="
    con_putc(114); con_putc(101); con_putc(118); con_putc(61);
    print_dec(r3);
    con_putc(32);
    con_putc(40); con_putc(115); con_putc(104); con_putc(111); con_putc(117); con_putc(108); con_putc(100);
    con_putc(32); con_putc(98); con_putc(101); con_putc(32); con_putc(45); con_putc(49); con_putc(41);
    con_putc(10);
}

// ─── Capability-gated RTC/timer (fractal kernel) ─────────────────────────
// Uses CAP_TYPE_MMIO (1) for RTC port access (ports 0x70-0x71).
// We create a separate RTC capability at boot.

// Read RTC time using a capability (READ permission).
// Writes HH:MM:SS to the console. Returns 0 on success, -1 if denied.
pub fn rtc_cap_read_time(rtc_cap: i64) -> i64 {
    if capability_get_type(rtc_cap) != 1 { return -1; }  // CAP_TYPE_MMIO
    if capability_check(rtc_cap, 1) == 0 { return -1; }  // CAP_PERM_READ
    // Read hours
    p_outb(0x70, 0x84);
    var hours: i64 = p_inb(0x71);
    p_outb(0x70, 0x82);
    var minutes: i64 = p_inb(0x71);
    p_outb(0x70, 0x80);
    var seconds: i64 = p_inb(0x71);
    // BCD to binary
    hours = (hours >> 4) * 10 + (hours & 0x0F);
    minutes = (minutes >> 4) * 10 + (minutes & 0x0F);
    seconds = (seconds >> 4) * 10 + (seconds & 0x0F);
    // Print
    if hours < 10 { con_putc(48); }
    print_dec(hours);
    con_putc(58);
    if minutes < 10 { con_putc(48); }
    print_dec(minutes);
    con_putc(58);
    if seconds < 10 { con_putc(48); }
    print_dec(seconds);
    return 0;
}

// Test the capability-gated RTC.
pub fn cmd_caprtc() -> void {
    con_putc(10);
    // "CapRTC test:"
    con_putc(67); con_putc(97); con_putc(112); con_putc(82); con_putc(84); con_putc(67);  // "CapRTC"
    con_putc(32);
    con_putc(116); con_putc(101); con_putc(115); con_putc(116); con_putc(58);
    con_putc(10);

    // Create an RTC capability (MMIO type, ports 0x70-0x71)
    var rtc_cap: i64 = capability_create(1, 1 | 2, 0x70, 2);  // READ | WRITE
    if rtc_cap == 0 {
        con_putc(69); con_putc(114); con_putc(114);  // "Err"
        con_putc(10);
        return;
    }

    // "cap="
    con_putc(99); con_putc(97); con_putc(112); con_putc(61);
    print_dec(rtc_cap);
    con_putc(32);
    con_putc(116); con_putc(121); con_putc(112); con_putc(101); con_putc(61);
    print_dec(capability_get_type(rtc_cap));
    con_putc(10);

    // Read time with the cap — should succeed
    con_putc(116); con_putc(105); con_putc(109); con_putc(101); con_putc(61);  // "time="
    var r1: i64 = rtc_cap_read_time(rtc_cap);
    con_putc(10);
    // "r="
    con_putc(114); con_putc(61);
    print_dec(r1);
    con_putc(10);

    // Grant a read-only child
    var ro_cap: i64 = capability_grant(rtc_cap, 1, 0);  // READ only
    // "ro="
    con_putc(114); con_putc(111); con_putc(61);
    print_dec(ro_cap);
    con_putc(32);
    con_putc(112); con_putc(101); con_putc(114); con_putc(109); con_putc(115); con_putc(61);
    print_dec(capability_get_perms(ro_cap));
    con_putc(10);

    // Read time with read-only cap — should succeed
    con_putc(116); con_putc(105); con_putc(109); con_putc(101); con_putc(61);
    var r2: i64 = rtc_cap_read_time(ro_cap);
    con_putc(10);

    // Revoke and test denial
    capability_revoke(ro_cap);
    var r3: i64 = rtc_cap_read_time(ro_cap);
    // "revoked="
    con_putc(114); con_putc(101); con_putc(118); con_putc(61);
    print_dec(r3);
    con_putc(32);
    con_putc(40); con_putc(115); con_putc(104); con_putc(111); con_putc(117); con_putc(108); con_putc(100);
    con_putc(32); con_putc(98); con_putc(101); con_putc(32); con_putc(45); con_putc(49); con_putc(41);
    con_putc(10);

    // Cleanup
    capability_revoke(rtc_cap);
}

// ─── Capability-gated PCI (fractal kernel) ──────────────────────────────
// Uses CAP_TYPE_MMIO (1) for PCI config access (ports 0xCF8-0xCFF).

// Scan PCI bus using a capability (READ permission).
pub fn pci_cap_scan(pci_cap: i64) -> i64 {
    if capability_get_type(pci_cap) != 1 { return -1; }  // CAP_TYPE_MMIO
    if capability_check(pci_cap, 1) == 0 { return -1; }  // CAP_PERM_READ
    return pci_scan();
}

// Read PCI config using a capability.
pub fn pci_cap_config_read(pci_cap: i64, bus: i64, dev: i64, func: i64, offset: i64) -> i64 {
    if capability_get_type(pci_cap) != 1 { return -1; }
    if capability_check(pci_cap, 1) == 0 { return -1; }
    return pci_config_read(bus, dev, func, offset);
}

// Test the capability-gated PCI.
pub fn cmd_cappci() -> void {
    con_putc(10);
    // "CapPCI test:"
    con_putc(67); con_putc(97); con_putc(112); con_putc(80); con_putc(67); con_putc(73);  // "CapPCI"
    con_putc(32);
    con_putc(116); con_putc(101); con_putc(115); con_putc(116); con_putc(58);
    con_putc(10);

    // Create a PCI capability (MMIO type, ports 0xCF8-0xCFF)
    var pci_cap: i64 = capability_create(1, 1 | 2, 0xCF8, 8);  // READ | WRITE
    if pci_cap == 0 {
        con_putc(69); con_putc(114); con_putc(114);
        con_putc(10);
        return;
    }

    // "cap="
    con_putc(99); con_putc(97); con_putc(112); con_putc(61);
    print_dec(pci_cap);
    con_putc(10);

    // Scan with the cap — should succeed
    var r1: i64 = pci_cap_scan(pci_cap);
    // "scan="
    con_putc(115); con_putc(99); con_putc(97); con_putc(110); con_putc(61);
    print_dec(r1);
    con_putc(10);

    // Grant a read-only child
    var ro_cap: i64 = capability_grant(pci_cap, 1, 0);
    // "ro="
    con_putc(114); con_putc(111); con_putc(61);
    print_dec(ro_cap);
    con_putc(10);

    // Scan with read-only cap — should succeed
    var r2: i64 = pci_cap_scan(ro_cap);
    // "ro_scan="
    con_putc(114); con_putc(111); con_putc(95); con_putc(115); con_putc(99); con_putc(97); con_putc(110); con_putc(61);
    print_dec(r2);
    con_putc(10);

    // Revoke and test denial
    capability_revoke(ro_cap);
    var r3: i64 = pci_cap_scan(ro_cap);
    // "revoked="
    con_putc(114); con_putc(101); con_putc(118); con_putc(61);
    print_dec(r3);
    con_putc(32);
    con_putc(40); con_putc(115); con_putc(104); con_putc(111); con_putc(117); con_putc(108); con_putc(100);
    con_putc(32); con_putc(98); con_putc(101); con_putc(32); con_putc(45); con_putc(49); con_putc(41);
    con_putc(10);

    // Cleanup
    capability_revoke(pci_cap);
}
