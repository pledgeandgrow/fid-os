// kernel/ata.fd — ATA/IDE disk driver (PIO mode, LBA28)
// Primary ATA controller at 0x1F0-0x1F7.

module ata;

// Read one 512-byte sector from the primary ATA disk via PIO.
// buf must be at least 512 bytes. Returns 0 on success, -1 on error.
pub fn ata_read_sector(lba: i64, buf: i64) -> i64 {
    // Wait for BSY to clear
    var timeout: i64 = 100000;
    while timeout > 0 {
        var status: i64 = p_inb(0x1F7);
        if (status & 0x80) == 0 { break; }
        timeout = timeout - 1;
    }
    if timeout == 0 { return -1; }

    // Select drive (LBA mode, drive 0)
    p_outb(0x1F6, 0xE0 | ((lba >> 24) & 0x0F));
    // Set sector count = 1
    p_outb(0x1F2, 1);
    // Set LBA low/mid/high
    p_outb(0x1F3, lba & 0xFF);
    p_outb(0x1F4, (lba >> 8) & 0xFF);
    p_outb(0x1F5, (lba >> 16) & 0xFF);
    // Send READ SECTORS command (0x20)
    p_outb(0x1F7, 0x20);

    // Wait for DRQ (data ready)
    timeout = 100000;
    while timeout > 0 {
        var status: i64 = p_inb(0x1F7);
        if (status & 0x08) != 0 { break; }
        if (status & 0x01) != 0 { return -1; }  // error
        timeout = timeout - 1;
    }
    if timeout == 0 { return -1; }

    // Read 256 16-bit words (512 bytes)
    var i: i64 = 0;
    while i < 256 {
        var word: i64 = p_inw(0x1F0);
        p_mem_write8(buf + i * 2, word & 0xFF);
        p_mem_write8(buf + i * 2 + 1, (word >> 8) & 0xFF);
        i = i + 1;
    }
    return 0;
}

// Write one 512-byte sector to the primary ATA disk via PIO.
pub fn ata_write_sector(lba: i64, buf: i64) -> i64 {
    var timeout: i64 = 100000;
    while timeout > 0 {
        var status: i64 = p_inb(0x1F7);
        if (status & 0x80) == 0 { break; }
        timeout = timeout - 1;
    }
    if timeout == 0 { return -1; }

    p_outb(0x1F6, 0xE0 | ((lba >> 24) & 0x0F));
    p_outb(0x1F2, 1);
    p_outb(0x1F3, lba & 0xFF);
    p_outb(0x1F4, (lba >> 8) & 0xFF);
    p_outb(0x1F5, (lba >> 16) & 0xFF);
    p_outb(0x1F7, 0x30);  // WRITE SECTORS

    timeout = 100000;
    while timeout > 0 {
        var status: i64 = p_inb(0x1F7);
        if (status & 0x08) != 0 { break; }
        if (status & 0x01) != 0 { return -1; }
        timeout = timeout - 1;
    }
    if timeout == 0 { return -1; }

    var i: i64 = 0;
    while i < 256 {
        var lo: i64 = p_mem_read8(buf + i * 2);
        var hi: i64 = p_mem_read8(buf + i * 2 + 1);
        p_outw(0x1F0, lo | (hi << 8));
        i = i + 1;
    }
    // Flush cache
    p_outb(0x1F7, 0xE7);
    return 0;
}

// ─── Disk Block Cache (simple 8-sector LRU cache) ────────────────────────
// Cache at 0x350000: 8 entries × (8 + 512) bytes
// Each entry: lba(8), valid(1), padding(7), data(512)
pub const DISK_CACHE_ADDR: i64 = 0x350000;
pub const DISK_CACHE_MAX: i64 = 8;
pub const DISK_CACHE_ENTRY: i64 = 520;  // 8 + 512

pub fn disk_cache_init() -> void {
    var i: i64 = 0;
    while i < DISK_CACHE_MAX {
        p_mem_write8(DISK_CACHE_ADDR + i * DISK_CACHE_ENTRY + 8, 0);  // invalid
        i = i + 1;
    }
}

// Read a sector with cache
pub fn ata_read_sector_cached(lba: i64, buf: i64) -> i64 {
    // Check cache first
    var i: i64 = 0;
    while i < DISK_CACHE_MAX {
        var valid: i64 = p_mem_read8(DISK_CACHE_ADDR + i * DISK_CACHE_ENTRY + 8);
        if valid == 1 {
            var cached_lba: i64 = p_mem_read32(DISK_CACHE_ADDR + i * DISK_CACHE_ENTRY) | (p_mem_read32(DISK_CACHE_ADDR + i * DISK_CACHE_ENTRY + 4) << 32);
            if cached_lba == lba {
                // Cache hit — copy data
                var j: i64 = 0;
                while j < 512 {
                    p_mem_write8(buf + j, p_mem_read8(DISK_CACHE_ADDR + i * DISK_CACHE_ENTRY + 9 + j));
                    j = j + 1;
                }
                return 0;
            }
        }
        i = i + 1;
    }
    // Cache miss — read from disk
    var result: i64 = ata_read_sector(lba, buf);
    if result != 0 { return result; }
    // Store in cache (use slot 0 as LRU replacement — simplified)
    p_mem_write32(DISK_CACHE_ADDR, lba & 0xFFFFFFFF);
    p_mem_write32(DISK_CACHE_ADDR + 4, (lba >> 32) & 0xFFFFFFFF);
    p_mem_write8(DISK_CACHE_ADDR + 8, 1);
    var j: i64 = 0;
    while j < 512 {
        p_mem_write8(DISK_CACHE_ADDR + 9 + j, p_mem_read8(buf + j));
        j = j + 1;
    }
    return 0;
}
