// kernel/kalloc.fd — Kernel memory management
// Page-frame allocator with bitmap + heap allocator with free list.

module kalloc;

pub const HEAP_START: i64 = 0x300000;
pub const HEAP_END:   i64 = 0x400000;  // 1MB heap
pub const HEAP_BITMAP: i64 = 0x310000;
pub const HEAP_MAX_PAGES: i64 = 256;  // 256 pages × 4KB = 1MB heap
pub const PAGE_SIZE: i64 = 4096;

pub var heap_next: i64 = 0x300000;
pub var heap_free_list: i64 = 0;  // head of free list (0 = empty)

// Initialize the heap
pub fn heap_init() {
    heap_next = HEAP_START;
    heap_free_list = 0;
}

// Allocate a 4KB-aligned page. Returns physical address or 0 if out of memory.
pub fn page_alloc() -> i64 {
    var i: i64 = 0;
    while i < HEAP_MAX_PAGES {
        if p_mem_read8(HEAP_BITMAP + i) == 0 {
            p_mem_write8(HEAP_BITMAP + i, 1);  // mark allocated
            return HEAP_START + i * PAGE_SIZE;
        }
        i = i + 1;
    }
    return 0;  // out of memory
}

// Free a previously allocated page.
pub fn page_free(addr: i64) -> void {
    if addr < HEAP_START { return; }
    var idx: i64 = (addr - HEAP_START) / PAGE_SIZE;
    if idx >= HEAP_MAX_PAGES { return; }
    p_mem_write8(HEAP_BITMAP + idx, 0);  // mark free
}

// Allocate `size` bytes, rounded up to a page. Returns address or 0.
pub fn kmalloc(size: i64) -> i64 {
    if size <= 0 { return 0; }
    return page_alloc();  // simple: one page per allocation
}

// Free a previously allocated block.
pub fn kfree(addr: i64) -> void {
    page_free(addr);
}

// ─── Heap with Free List ────────────────────────────────────────────────
// Each allocation: [size:8][data...]
// Free list: singly linked, address stored in first 8 bytes of freed block.

pub fn heap_alloc(size: i64) -> i64 {
    // Try free list first (first-fit)
    var prev: i64 = 0;
    var cur: i64 = heap_free_list;
    while cur != 0 {
        var block_size: i64 = p_mem_read64(cur);  // size includes header
        if block_size >= size + 8 {
            // Found a fit — remove from free list
            var next_free: i64 = p_mem_read64(cur + 8);
            if prev == 0 {
                heap_free_list = next_free;
            } else {
                p_mem_write64(prev + 8, next_free);
            }
            return cur + 8;  // return data pointer (past size header)
        }
        prev = cur;
        cur = p_mem_read64(cur + 8);
    }
    // Bump allocate
    if heap_next + size + 8 > HEAP_END { return 0; }
    p_mem_write64(heap_next, size + 8);  // store block size
    var ptr: i64 = heap_next + 8;
    heap_next = heap_next + size + 8;
    // Align to 8 bytes
    while heap_next % 8 != 0 { heap_next = heap_next + 1; }
    return ptr;
}

pub fn heap_free(ptr: i64) {
    if ptr == 0 { return; }
    var block_start: i64 = ptr - 8;
    // Add to free list head
    p_mem_write64(block_start + 8, heap_free_list);
    heap_free_list = block_start;
}
