// kernel/syscall.fd — Syscall dispatch + user-mode program loading
// Handles int 0x80 syscalls from ring 3 user programs.

module syscall;

use console;
use keyboard;
use initrd;
use ata;
use vm;

// Syscall numbers
pub const SYS_EXIT: i64 = 0;
pub const SYS_WRITE: i64 = 1;
pub const SYS_READ: i64 = 2;
pub const SYS_OPEN: i64 = 5;
pub const SYS_CLOSE: i64 = 6;
pub const SYS_GETPID: i64 = 3;
pub const SYS_YIELD: i64 = 4;

// File descriptor table at 0x190000 (16 entries × 32 bytes)
// Each entry: in_use(4), initrd_idx(4), offset(8), size(8), reserved(8)
pub const FD_TABLE: i64 = 0x190000;
pub const FD_MAX: i64 = 16;
pub const FD_ENTRY_SIZE: i64 = 32;

pub fn fd_init() -> void {
    var i: i64 = 0;
    while i < FD_MAX {
        p_mem_write32(FD_TABLE + i * FD_ENTRY_SIZE, 0);
        i = i + 1;
    }
}

pub fn sys_open(path: i64, path_len: i64, flags: i64) -> i64 {
    // Find file in initrd
    var idx: i64 = initrd_find(path, path_len);
    if idx < 0 { return -1; }
    var size: i64 = initrd_get_size(idx);
    // Find a free FD slot
    var i: i64 = 0;
    while i < FD_MAX {
        var in_use: i64 = p_mem_read32(FD_TABLE + i * FD_ENTRY_SIZE);
        if in_use == 0 {
            p_mem_write32(FD_TABLE + i * FD_ENTRY_SIZE, 1);
            p_mem_write32(FD_TABLE + i * FD_ENTRY_SIZE + 4, idx);
            p_mem_write32(FD_TABLE + i * FD_ENTRY_SIZE + 8, 0);  // offset
            p_mem_write32(FD_TABLE + i * FD_ENTRY_SIZE + 12, 0);
            p_mem_write32(FD_TABLE + i * FD_ENTRY_SIZE + 16, size);  // size
            p_mem_write32(FD_TABLE + i * FD_ENTRY_SIZE + 20, 0);
            return i;
        }
        i = i + 1;
    }
    return -1;  // no free FDs
}

pub fn sys_close(fd: i64) -> i64 {
    if fd < 0 || fd >= FD_MAX { return -1; }
    p_mem_write32(FD_TABLE + fd * FD_ENTRY_SIZE, 0);
    return 0;
}

pub fn sys_read_fd(fd: i64, buf: i64, len: i64) -> i64 {
    // Read from a file descriptor (for SYS_READ with fd)
    if fd < 0 || fd >= FD_MAX { return -1; }
    var in_use: i64 = p_mem_read32(FD_TABLE + fd * FD_ENTRY_SIZE);
    if in_use == 0 { return -1; }
    var idx: i64 = p_mem_read32(FD_TABLE + fd * FD_ENTRY_SIZE + 4);
    var offset: i64 = p_mem_read32(FD_TABLE + fd * FD_ENTRY_SIZE + 8);
    var size: i64 = p_mem_read32(FD_TABLE + fd * FD_ENTRY_SIZE + 16);
    var doff: i64 = initrd_get_data_offset(idx);
    var i: i64 = 0;
    while i < len && offset < size {
        p_mem_write8(buf + i, p_mem_read8(INITRD_BUF + doff + offset));
        offset = offset + 1;
        i = i + 1;
    }
    p_mem_write32(FD_TABLE + fd * FD_ENTRY_SIZE + 8, offset);
    return i;
}

// Syscall dispatch — called by the assembly syscall handler.
// Args: syscall_num (RCX), arg1 (RDX), arg2 (R8), arg3 (R9)
// Returns 0 to continue user mode, non-zero to exit to kernel.
pub fn syscall_dispatch(syscall_num: i64, arg1: i64, arg2: i64, arg3: i64) -> i64 {
    // Syscall numbers:
    //   0 = sys_exit(exit_code)  — returns to kernel
    //   1 = sys_write(buf_ptr, len) — writes to VGA/serial, returns bytes written
    //   2 = sys_read(buf_ptr, len) — reads from keyboard (stub, returns 0)
    //   3 = sys_getpid() — returns PID
    //   4 = sys_yield() — yields CPU (stub, returns 0)

    if syscall_num == 0 {
        // sys_exit: print exit code, return to kernel
        con_putc(10);
        con_putc(69); con_putc(120); con_putc(105); con_putc(116); con_putc(40); // "Exit("
        print_hex(arg1);
        con_putc(41); con_putc(10); // ")"
        return 0; // return value doesn't matter; handler checks syscall_num==0
    }

    if syscall_num == 1 {
        // sys_write(buf_ptr, len): write string to VGA/serial
        var i: i64 = 0;
        while i < arg2 {
            con_putc(p_mem_read8(arg1 + i));
            i = i + 1;
        }
        return arg2; // return bytes written
    }

    if syscall_num == 2 {
        // sys_read(buf_ptr, len): read from keyboard buffer into user buffer
        // Reads one character at a time (blocking until a key is available)
        // Returns the number of bytes actually read (1 if a key was read, 0 on error)
        if arg2 <= 0 { return 0; }
        // Read one scancode from the keyboard buffer (blocks until key pressed)
        var sc: i64 = kbd_read_scancode();
        var ch: i64 = scancode_to_ascii(sc);
        if ch < 0 { return 0; }
        // Write the character to the user buffer
        p_mem_write8(arg1, ch);
        return 1;
    }

    if syscall_num == 3 {
        // sys_getpid: return PID (always 1 for now)
        return 1;
    }

    if syscall_num == 4 {
        // sys_yield: stub — no scheduler yet
        return 0;
    }

    if syscall_num == 5 {
        // sys_open(path, path_len, flags)
        return sys_open(arg1, arg2, arg3);
    }

    if syscall_num == 6 {
        // sys_close(fd)
        return sys_close(arg1);
    }

    if syscall_num == 9 {
        // sys_mmap(addr, length, prot, flags, fd, offset)
        return sys_mmap(arg1, arg2, arg3, 0, 0, 0);
    }

    if syscall_num == 12 {
        // sys_brk(new_brk)
        return sys_brk(arg1);
    }

    if syscall_num == 39 {
        // sys_getpid
        return current_pid;
    }

    if syscall_num == 57 {
        // sys_fork
        return sys_fork();
    }

    if syscall_num == 59 {
        // sys_exec(path, path_len)
        return sys_exec(arg1, arg2);
    }

    if syscall_num == 61 {
        // sys_wait(pid)
        return sys_wait(arg1);
    }

    if syscall_num == 62 {
        // sys_kill(pid, sig)
        return sys_kill(arg1, arg2);
    }

    if syscall_num == 134 {
        // sys_sigaction(sig, handler)
        return sys_sigaction(arg1, arg2);
    }

    if syscall_num == 200 {
        // sys_pipe
        return sys_pipe();
    }

    if syscall_num == 201 {
        // sys_shmget(key, size, flags)
        return sys_shmget(arg1, arg2, arg3);
    }

    // Unknown syscall — print debug and continue
    con_putc(10);
    con_putc(83); con_putc(58); // "S:"
    print_hex(syscall_num);
    con_putc(32);
    con_putc(82); con_putc(58); // "R:"
    print_hex(arg1);
    con_putc(32);
    con_putc(80); con_putc(58); // "P:"
    print_hex(arg2);
    con_putc(32);
    con_putc(65); con_putc(58); // "A:"
    print_hex(arg3);
    con_putc(10);
    return 0;
}

// ─── Extended Syscalls ──────────────────────────────────────────────────

// User heap state at 0x6B0: [brk_current:8]
pub const USER_BRK: i64 = 0x6B0;
pub const USER_HEAP_START: i64 = 0x13000;  // user heap starts above user stack

// Process table at 0x160000 (up to 64 processes × 32 bytes)
// Entry layout: [pid:8][state:8][entry:8][pml4:8]
pub const PROC_TABLE: i64 = 0x160000;
pub const MAX_PROCS: i64 = 64;
pub const PROC_ENTRY_SIZE: i64 = 32;
pub const PROC_STATE_FREE: i64 = 0;
pub const PROC_STATE_RUNNING: i64 = 1;
pub const PROC_STATE_READY: i64 = 2;
pub const PROC_STATE_BLOCKED: i64 = 3;
pub const PROC_STATE_ZOMBIE: i64 = 4;
pub var current_pid: i64 = 1;
pub var next_pid: i64 = 2;

// Signal handler table at 0x170000 (64 signals × 8 bytes per process)
pub const SIGNAL_TABLE: i64 = 0x170000;

// Pipe buffer at 0x180000 (up to 16 pipes × 4096 bytes)
pub const PIPE_TABLE: i64 = 0x180000;
pub const MAX_PIPES: i64 = 16;
pub const PIPE_SIZE: i64 = 4096;

pub fn proc_init() {
    current_pid = 1;
    next_pid = 2;
    // Initialize process 1 (kernel shell)
    p_mem_write64(PROC_TABLE, 1);        // pid
    p_mem_write64(PROC_TABLE + 8, 1);    // state = running
    p_mem_write64(PROC_TABLE + 16, 0x10000); // entry
    p_mem_write64(PROC_TABLE + 24, 0x72000); // pml4
    // Initialize user brk
    p_mem_write64(USER_BRK, USER_HEAP_START);
}

pub fn sys_brk(new_brk: i64) -> i64 {
    // G7: Set program break (user heap)
    var current_brk: i64 = p_mem_read64(USER_BRK);
    if new_brk == 0 {
        // Query current brk
        return current_brk;
    }
    if new_brk < USER_HEAP_START || new_brk > 0x1F000 {
        return current_brk;  // invalid range, return current
    }
    p_mem_write64(USER_BRK, new_brk);
    return new_brk;
}

pub fn sys_mmap(addr: i64, length: i64, prot: i64, flags: i64, fd: i64, offset: i64) -> i64 {
    // G7: Simple mmap — allocate anonymous pages in user space
    // For now, just extend the user break
    var current_brk: i64 = p_mem_read64(USER_BRK);
    if length <= 0 { return 0; }
    // Align to page boundary
    var aligned_len: i64 = (length + 0xFFF) & 0xFFFFFFFFFFFFF000;
    var result: i64 = current_brk;
    p_mem_write64(USER_BRK, current_brk + aligned_len);
    return result;
}

pub fn sys_fork() -> i64 {
    // Phase 3: Fork — create a child process with its own address space.
    // Finds a free slot, creates a new PML4, copies kernel mappings,
    // and records the child in the process table.
    var slot: i64 = -1;
    var i: i64 = 0;
    while i < MAX_PROCS {
        if p_mem_read64(PROC_TABLE + i * PROC_ENTRY_SIZE) == 0 {
            slot = i;
            i = MAX_PROCS;
        }
        i = i + 1;
    }
    if slot < 0 { return -1; }  // no free slots

    // Create a new address space for the child
    var child_pml4: i64 = vm_create_address_space(slot);
    if child_pml4 == 0 { return -1; }

    // Assign a new PID
    var child_pid: i64 = next_pid;
    next_pid = next_pid + 1;

    // Record the child process
    var base: i64 = PROC_TABLE + slot * PROC_ENTRY_SIZE;
    p_mem_write64(base, child_pid);              // pid
    p_mem_write64(base + 8, PROC_STATE_READY);   // state = ready
    // Copy entry point from parent (process 1)
    var parent_entry: i64 = p_mem_read64(PROC_TABLE + 16);
    p_mem_write64(base + 16, parent_entry);      // entry
    p_mem_write64(base + 24, child_pml4);        // pml4

    return child_pid;
}

pub fn sys_exec(path: i64, path_len: i64) -> i64 {
    // G2: Exec — replace current process with a new program
    // For now, load from initrd and jump to it
    var idx: i64 = initrd_find(path, path_len);
    if idx < 0 { return -1; }
    var size: i64 = initrd_get_size(idx);
    var doff: i64 = initrd_get_data_offset(idx);
    // Copy to 0x10000
    var i: i64 = 0;
    while i < size {
        p_mem_write8(0x10000 + i, p_mem_read8(INITRD_BUF + doff + i));
        i = i + 1;
    }
    // Enter user mode
    p_enter_user_mode(0x10000, 0x12000);
    return 0;  // never reached
}

pub fn sys_wait(pid: i64) -> i64 {
    // Phase 3: Wait — check if a child process has exited (zombie state).
    // In a real OS, this would block. For now, check immediately.
    var i: i64 = 0;
    while i < MAX_PROCS {
        var base: i64 = PROC_TABLE + i * PROC_ENTRY_SIZE;
        if p_mem_read64(base) == pid {
            var state: i64 = p_mem_read64(base + 8);
            if state == PROC_STATE_ZOMBIE {
                // Reap the zombie
                p_mem_write64(base, 0);  // clear pid
                p_mem_write64(base + 8, 0);  // clear state
                return pid;  // child exited
            }
            return 0;  // child still running
        }
        i = i + 1;
    }
    return -1;  // no such process
}

pub fn sys_kill(pid: i64, sig: i64) -> i64 {
    // Phase 3: Kill — mark a process as zombie and destroy its address space.
    // Signal 9 (SIGKILL) terminates the process.
    if sig != 9 { return 0; }  // only SIGKILL for now
    var i: i64 = 0;
    while i < MAX_PROCS {
        var base: i64 = PROC_TABLE + i * PROC_ENTRY_SIZE;
        if p_mem_read64(base) == pid {
            p_mem_write64(base + 8, PROC_STATE_ZOMBIE);
            // Destroy the address space
            vm_destroy_address_space(i);
            return 0;
        }
        i = i + 1;
    }
    return -1;  // process not found
}

pub fn sys_sigaction(sig: i64, handler: i64) -> i64 {
    // G8: Set signal handler
    if sig < 0 || sig >= 64 { return -1; }
    p_mem_write64(SIGNAL_TABLE + sig * 8, handler);
    return 0;
}

pub fn sys_pipe() -> i64 {
    // G21: Create a pipe — returns pipe id
    // Find a free pipe slot
    var i: i64 = 0;
    while i < MAX_PIPES {
        var in_use: i64 = p_mem_read8(PIPE_TABLE + i * (PIPE_SIZE + 16));
        if in_use == 0 {
            p_mem_write8(PIPE_TABLE + i * (PIPE_SIZE + 16), 1);
            // Initialize read/write offsets
            p_mem_write64(PIPE_TABLE + i * (PIPE_SIZE + 16) + 8, 0);  // read offset
            p_mem_write64(PIPE_TABLE + i * (PIPE_SIZE + 16) + 16, 0); // write offset
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn sys_shmget(key: i64, size: i64, flags: i64) -> i64 {
    // G21: Allocate shared memory — return virtual address
    // Use a fixed shared memory region at 0x200000
    var current: i64 = p_mem_read64(0x6C0);
    if current == 0 { current = 0x200000; }
    var aligned: i64 = (size + 0xFFF) & 0xFFFFFFFFFFFFF000;
    var result: i64 = current;
    p_mem_write64(0x6C0, current + aligned);
    return result;
}

// Load and run a user-mode program from disk sector 1.
// The user program is a flat binary loaded at 0x10000.
// User stack is at 0x12000 (grows down).
// The user program writes to VGA at 0xB8000 and calls int 0x80 to exit.
pub fn cmd_run() -> void {
    con_putc(10);
    // "Loading user program from sector 1..."
    con_putc(76); con_putc(111); con_putc(97); con_putc(100); con_putc(105);
    con_putc(110); con_putc(103); con_putc(32); con_putc(117); con_putc(115);
    con_putc(101); con_putc(114); con_putc(32); con_putc(112); con_putc(114);
    con_putc(111); con_putc(103); con_putc(114); con_putc(97); con_putc(109);
    con_putc(32); con_putc(102); con_putc(114); con_putc(111); con_putc(109);
    con_putc(32); con_putc(115); con_putc(101); con_putc(99); con_putc(116);
    con_putc(111); con_putc(114); con_putc(32); con_putc(49); con_putc(46); con_putc(46); con_putc(46);
    con_putc(10);

    // Load user program from disk sector 1 to address 0x10000
    var result: i64 = ata_read_sector(1, 0x10000);
    if result != 0 {
        // "Failed to load user program"
        con_putc(70); con_putc(97); con_putc(105); con_putc(108); con_putc(101);
        con_putc(100); con_putc(32); con_putc(116); con_putc(111); con_putc(32);
        con_putc(108); con_putc(111); con_putc(97); con_putc(100); con_putc(32);
        con_putc(117); con_putc(115); con_putc(101); con_putc(114); con_putc(32);
        con_putc(112); con_putc(114); con_putc(111); con_putc(103); con_putc(114);
        con_putc(97); con_putc(109);
        con_putc(10);
        return;
    }

    // "Entering ring 3 (user mode)..."
    con_putc(69); con_putc(110); con_putc(116); con_putc(101); con_putc(114);
    con_putc(105); con_putc(110); con_putc(103); con_putc(32); con_putc(114);
    con_putc(105); con_putc(110); con_putc(103); con_putc(32); con_putc(51);
    con_putc(32); con_putc(40); con_putc(117); con_putc(115); con_putc(101);
    con_putc(114); con_putc(32); con_putc(109); con_putc(111); con_putc(100);
    con_putc(101); con_putc(41); con_putc(46); con_putc(46); con_putc(46);
    con_putc(10);

    // Enter user mode: entry at 0x10000, stack at 0x12000
    // This does iret to ring 3 and never returns.
    // When the user calls int 0x80, the syscall handler returns to
    // user_program_done() in the kernel.
    p_enter_user_mode(0x10000, 0x12000);

    // This code is never reached — p_enter_user_mode does iret
}
