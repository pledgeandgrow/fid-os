// stdlib/timer.fd — Hardware timer support for x86-64 bare-metal OS development
//
// Provides structs and helper functions for:
// - PIT (8254 Programmable Interval Timer) — channel 0 configuration
// - HPET (High Precision Event Timer) — MMIO-based high-resolution timer
// - RTC (Real-Time Clock) — CMOS-backed date/time and status registers
//
// These are thin wrappers around the p_* bare-metal builtins.
// They only work in --bare or --boot mode (no OS, no stdlib).

// ─── PIT (8254 Programmable Interval Timer) ────────────────────────────────
//
// The 8254 PIT has three channels, but only channel 0 is connected to IRQ0.
// The input clock is 1193182 Hz (derived from a 14.31818 MHz crystal / 12).
// A divisor is programmed to set the output frequency: freq = PIT_FREQ / divisor.
//
// The command byte format for the control register (port 0x43):
//   bits 7-6: select channel (00=0, 01=1, 10=2, 11=read-back)
//   bits 5-4: access mode (00=latch count, 01=low byte, 10=high byte, 11=both)
//   bits 3-1: operating mode (0-5)
//   bit 0:    BCD (0=binary, 1=BCD)

// I/O ports
const PIT_BASE_PORT: i64 = 0x40;       // Channel 0 data port
const PIT_COMMAND_PORT: i64 = 0x43;    // Control register

// Input frequency (Hz) — the PIT oscillator runs at 1193182 Hz
const PIT_FREQ: i64 = 1193182;

// Operating modes (bits 3-1 of the command byte, shifted into position)
const PIT_MODE_RATE: i64 = 0x40;       // Mode 2 — rate generator (periodic interrupt)
const PIT_MODE_SQUARE: i64 = 0x36;    // Mode 3 — square wave generator
const PIT_MODE_ONESHOT: i64 = 0x30;   // Mode 0 — interrupt on terminal count

// Channel select (bits 7-6 of the command byte)
const PIT_CHANNEL0: i64 = 0x00;       // Select channel 0

// Initialize PIT channel 0 with the given divisor.
// The command byte selects channel 0, latches low+high bytes, and uses
// mode 2 (rate generator) by default — the most common mode for a periodic
// timer tick. The divisor must be in [1, 65535].
// divisor: frequency divider (output freq = PIT_FREQ / divisor)
pub fn pit_init(divisor: i64) {
    // Clamp divisor to 16-bit range (minimum 1)
    var d = divisor;
    if d < 1 {
        d = 1;
    }
    if d > 65535 {
        d = 65535;
    }
    // Command: channel 0 | access low+high | mode 2 | binary
    val cmd = PIT_CHANNEL0 | 0x30 | 0x04; // 0x34 — channel 0, lobyte/hibyte, mode 2
    p_outb(PIT_COMMAND_PORT, cmd);
    // Write low byte then high byte of the divisor to channel 0
    p_outb(PIT_BASE_PORT, d & 0xFF);
    p_outb(PIT_BASE_PORT, (d >> 8) & 0xFF);
}

// Set the PIT to generate interrupts at the given frequency (Hz).
// Computes divisor = PIT_FREQ / hz and programs channel 0.
// hz: desired interrupt frequency (e.g., 100 for a 100 Hz tick = 10 ms)
pub fn pit_set_frequency(hz: i64) {
    var div = PIT_FREQ / hz;
    if div < 1 {
        div = 1;
    }
    pit_init(div);
}

// Read the current count from PIT channel 0.
// Uses the latch-then-read technique: writing a latch command (access mode 0)
// to the control port causes the current count to be frozen so we can read
// it back as two bytes (low then high).
// Returns: current down-counter value (0-65535)
pub fn pit_read_count() -> i64 {
    // Latch channel 0 count: channel 0 | access mode 00 (latch)
    p_outb(PIT_COMMAND_PORT, PIT_CHANNEL0 | 0x00);
    val lo = p_inb(PIT_BASE_PORT);
    val hi = p_inb(PIT_BASE_PORT);
    return lo | (hi << 8);
}

// Set the operating mode of PIT channel 0.
// mode: one of PIT_MODE_RATE, PIT_MODE_SQUARE, PIT_MODE_ONESHOT
// (the mode bits should already include the channel select and access mode)
pub fn pit_set_mode(mode: i64) {
    p_outb(PIT_COMMAND_PORT, mode);
}

// ─── HPET (High Precision Event Timer) ─────────────────────────────────────
//
// The HPET is a memory-mapped timer with a main counter and up to 32
// comparators (timers). The base address is provided by ACPI (HPET table),
// defaulting to 0xFED00000 if not available. All registers are 64-bit.
//
// General capabilities register layout (64 bits):
//   bits 31:0  — counter clock period in femtoseconds
//   bit 32     — legacy replacement routing support
//   bit 33-35  — number of timers minus 1
//   bit 64+    — vendor ID, etc. (read as 64-bit)
//
// Timer N configuration register layout (64 bits):
//   bit 0  — interrupt enable
//   bit 1  — level-triggered (0=edge)
//   bit 2  — interrupt enabled (1=enabled)
//   bit 3  — periodic mode
//   bit 4  — periodic capability
//   bit 5  — 64-bit mode
//   bit 6  — value-set (write to comparator updates timer)
//   bit 7  — 32-bit mode
//   bit 8-13 — interrupt route
//   bit 14 — FSB interrupt delivery
//   bit 15 — FSB interrupt delivery capability
//   bits 32-63 — interrupt route capability bitmap

// MMIO base address (may be overridden by ACPI HPET table)
const HPET_BASE_DEFAULT: i64 = 0xFED00000;

// Register offsets (from base)
const HPET_GENERAL_CAPS: i64 = 0x00;       // General capabilities (read-only)
const HPET_GENERAL_CONFIG: i64 = 0x10;    // General configuration
const HPET_GENERAL_INT_STATUS: i64 = 0x20; // General interrupt status
const HPET_MAIN_COUNTER: i64 = 0xF0;       // Main counter value
const HPET_TIMER0_CONFIG: i64 = 0x100;    // Timer 0 configuration
const HPET_TIMER0_COMPARE: i64 = 0x108;   // Timer 0 comparator
const HPET_TIMER0_FSB_INT: i64 = 0x110;   // Timer 0 FSB interrupt route

// General configuration register bits
const HPET_ENABLE_CNF: i64 = 0x01;         // Enable main counter (bit 0)
const HPET_LEGACY_RT: i64 = 0x02;          // Legacy replacement routing (bit 1)

// Timer N configuration register bits
const HPET_TN_INT_ENB: i64 = 0x04;         // Timer interrupt enable (bit 2)
const HPET_TN_TYPE: i64 = 0x08;            // Periodic mode (bit 3)
const HPET_TN_64BIT: i64 = 0x20;           // 64-bit mode (bit 5)
const HPET_TN_VAL_SET: i64 = 0x40;         // Value-set (bit 6)
const HPET_TN_32BIT: i64 = 0x80;           // 32-bit mode (bit 7)
const HPET_TN_FSB_EN: i64 = 0x4000;        // FSB interrupt enable (bit 14)

// Get the HPET MMIO base address.
// For now, returns the default base (0xFED00000). A full ACPI HPET table
// parser would read the base from the HPET's BASE_ADDRESS field.
// Returns: physical MMIO base address of the HPET
pub fn hpet_get_base() -> i64 {
    return HPET_BASE_DEFAULT;
}

// Initialize the HPET: disable it, clear legacy replacement routing.
// This leaves the main counter stopped and ready for configuration.
// Call hpet_enable() to start the counter.
pub fn hpet_init() {
    val base = hpet_get_base();
    // Read current general config, clear ENABLE_CNF and LEGACY_RT
    val cfg = p_phys_read64(base + HPET_GENERAL_CONFIG);
    p_phys_write64(base + HPET_GENERAL_CONFIG, cfg & ~(HPET_ENABLE_CNF | HPET_LEGACY_RT));
}

// Enable the HPET main counter (start counting).
pub fn hpet_enable() {
    val base = hpet_get_base();
    val cfg = p_phys_read64(base + HPET_GENERAL_CONFIG);
    p_phys_write64(base + HPET_GENERAL_CONFIG, cfg | HPET_ENABLE_CNF);
}

// Disable the HPET main counter (stop counting).
pub fn hpet_disable() {
    val base = hpet_get_base();
    val cfg = p_phys_read64(base + HPET_GENERAL_CONFIG);
    p_phys_write64(base + HPET_GENERAL_CONFIG, cfg & ~HPET_ENABLE_CNF);
}

// Read the HPET main counter value (64-bit free-running counter).
// Returns: current main counter value
pub fn hpet_read_counter() -> i64 {
    val base = hpet_get_base();
    return p_phys_read64(base + HPET_MAIN_COUNTER);
}

// Set the timer 0 comparator value.
// When the main counter matches this value, timer 0 fires an interrupt.
// val: comparator value (in main counter ticks)
pub fn hpet_timer0_set_compare(val: i64) {
    val base = hpet_get_base();
    p_phys_write64(base + HPET_TIMER0_COMPARE, val);
}

// Enable interrupts for timer 0.
pub fn hpet_timer0_enable_interrupt() {
    val base = hpet_get_base();
    val cfg = p_phys_read64(base + HPET_TIMER0_CONFIG);
    p_phys_write64(base + HPET_TIMER0_CONFIG, cfg | HPET_TN_INT_ENB);
}

// Disable interrupts for timer 0.
pub fn hpet_timer0_disable_interrupt() {
    val base = hpet_get_base();
    val cfg = p_phys_read64(base + HPET_TIMER0_CONFIG);
    p_phys_write64(base + HPET_TIMER0_CONFIG, cfg & ~HPET_TN_INT_ENB);
}

// Configure timer 0 for periodic interrupts.
// vector: I/O APIC interrupt vector (stored in the FSB route for MSI delivery)
// period: period in femtoseconds (the HPET counter period is in the caps register;
//         to get ticks, divide period by the counter clock period from caps)
pub fn hpet_timer0_set_periodic(vector: i64, period: i64) {
    val base = hpet_get_base();
    // Read capabilities to get the counter clock period (bits 31:0)
    val caps = p_phys_read64(base + HPET_GENERAL_CAPS);
    val clk_period = caps & 0xFFFFFFFF;
    // Compute the number of ticks for the requested period
    var ticks = 0;
    if clk_period != 0 {
        ticks = period / clk_period;
    }
    if ticks < 1 {
        ticks = 1;
    }
    // Configure timer 0: 64-bit mode, periodic, value-set, interrupt enabled
    // Clear the config first, then set the desired bits
    val cfg = HPET_TN_64BIT | HPET_TN_TYPE | HPET_TN_VAL_SET | HPET_TN_INT_ENB;
    p_phys_write64(base + HPET_TIMER0_CONFIG, cfg);
    // Set the FSB interrupt route (MSI address + data)
    // The FSB route register is [63:32] = MSI address, [31:0] = MSI data
    // For simplicity, store the vector in the lower 8 bits of the data field
    val fsb = (0xFEE00000 << 32) | (vector & 0xFF);
    p_phys_write64(base + HPET_TIMER0_FSB_INT, fsb);
    // Set the comparator to the desired tick count (this arms the timer)
    p_phys_write64(base + HPET_TIMER0_COMPARE, ticks);
}

// Read the HPET general capabilities register.
// Returns: 64-bit capabilities value (bits 31:0 = counter clock period in fs,
//          bit 32 = legacy routing, bits 35:33 = num timers - 1)
pub fn hpet_read_caps() -> i64 {
    val base = hpet_get_base();
    return p_phys_read64(base + HPET_GENERAL_CAPS);
}

// ─── RTC (Real-Time Clock) ─────────────────────────────────────────────────
//
// The RTC is accessed through CMOS RAM via two I/O ports:
//   0x70 (index) — write the register number (bit 7 = NMI disable)
//   0x71 (data)  — read or write the register value
//
// Time/date registers store values in BCD (Binary-Coded Decimal) by default
// (unless status register B has the DM bit set to binary). BCD encodes each
// decimal digit in 4 bits, e.g., 0x59 = 59 (not 89).
//
// Status register A:
//   bit 7 — UIP (Update In Progress): 1 = update in progress, wait before reading
//   bits 6:4 — rate divider
//   bits 3:0 — frequency selection
//
// Status register B:
//   bit 7 — SET (stop updates)
//   bit 6 — PIE (periodic interrupt enable)
//   bit 5 — AIE (alarm interrupt enable)
//   bit 4 — UIE (update-ended interrupt enable)
//   bit 3 — SQWE (square wave enable)
//   bit 2 — DM (0=BCD, 1=binary)
//   bit 1 — 24/12 (1=24-hour mode)
//   bit 0 — DSE (daylight savings enable)

// I/O ports
const RTC_PORT_INDEX: i64 = 0x70;
const RTC_PORT_DATA: i64 = 0x71;

// Register offsets (CMOS RAM indices)
const RTC_REG_SECONDS: i64 = 0x00;
const RTC_REG_MINUTES: i64 = 0x02;
const RTC_REG_HOURS: i64 = 0x04;
const RTC_REG_DAY: i64 = 0x07;
const RTC_REG_MONTH: i64 = 0x08;
const RTC_REG_YEAR: i64 = 0x09;
const RTC_REG_STATUS_A: i64 = 0x0A;
const RTC_REG_STATUS_B: i64 = 0x0B;
const RTC_REG_STATUS_C: i64 = 0x0C;

// Status register A bit 7: Update In Progress
const RTC_UIP: i64 = 0x80;

// Read an RTC register.
// reg: CMOS register index (0x00-0x0C for time/status)
// Returns: register value (8-bit)
pub fn rtc_read(reg: i64) -> i64 {
    // Write the register index to port 0x70 (bit 7 = NMI disable for safety)
    p_outb(RTC_PORT_INDEX, reg | 0x80);
    return p_inb(RTC_PORT_DATA);
}

// Write an RTC register.
// reg: CMOS register index
// val: value to write (8-bit)
pub fn rtc_write(reg: i64, val: i64) {
    p_outb(RTC_PORT_INDEX, reg | 0x80);
    p_outb(RTC_PORT_DATA, val & 0xFF);
}

// Get the seconds field (0-59) from the RTC, converted to binary.
pub fn rtc_get_seconds() -> i64 {
    return rtc_bcd_to_binary(rtc_read(RTC_REG_SECONDS));
}

// Get the minutes field (0-59) from the RTC, converted to binary.
pub fn rtc_get_minutes() -> i64 {
    return rtc_bcd_to_binary(rtc_read(RTC_REG_MINUTES));
}

// Get the hours field (0-23) from the RTC, converted to binary.
// Note: in 12-hour BCD mode, bit 7 is the PM flag. This function handles
// the common 24-hour BCD case. For 12-hour mode, the caller should check
// status register B bit 1 and adjust accordingly.
pub fn rtc_get_hours() -> i64 {
    var h = rtc_read(RTC_REG_HOURS);
    // Check if 12-hour mode (status B bit 1 = 0 means 12-hour)
    val status_b = rtc_read(RTC_REG_STATUS_B);
    if (status_b & 0x02) == 0 {
        // 12-hour mode: bit 7 is PM flag
        var pm = (h & 0x80) != 0;
        h = h & 0x7F;
        h = rtc_bcd_to_binary(h);
        if pm {
            h = h + 12;
            // 12 PM is noon (12), not 24
            if h == 24 {
                h = 12;
            }
        } else {
            // 12 AM is midnight (0), not 12
            if h == 12 {
                h = 0;
            }
        }
        return h;
    }
    // 24-hour BCD mode
    return rtc_bcd_to_binary(h);
}

// Get the day-of-month field (1-31) from the RTC, converted to binary.
pub fn rtc_get_day() -> i64 {
    return rtc_bcd_to_binary(rtc_read(RTC_REG_DAY));
}

// Get the month field (1-12) from the RTC, converted to binary.
pub fn rtc_get_month() -> i64 {
    return rtc_bcd_to_binary(rtc_read(RTC_REG_MONTH));
}

// Get the year field from the RTC, converted to binary.
// The CMOS RTC only stores 2 digits (e.g., 0x24 for 2024). The caller
// should add the century (typically 2000 or read from CMOS 0x32).
// Returns: 2-digit year (0-99)
pub fn rtc_get_year() -> i64 {
    return rtc_bcd_to_binary(rtc_read(RTC_REG_YEAR));
}

// Check if the RTC is currently updating (UIP bit set in status register A).
// When updating, time/date registers may be in an inconsistent state.
// Returns: true if an update is in progress
pub fn rtc_is_updating() -> bool {
    val status_a = rtc_read(RTC_REG_STATUS_A);
    return (status_a & RTC_UIP) != 0;
}

// Convert a BCD-encoded value to binary.
// BCD packs two decimal digits in one byte: high nibble = tens, low = ones.
// bcd: BCD-encoded value (e.g., 0x59)
// Returns: binary value (e.g., 59)
pub fn rtc_bcd_to_binary(bcd: i64) -> i64 {
    return ((bcd >> 4) & 0x0F) * 10 + (bcd & 0x0F);
}
