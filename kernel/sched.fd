// kernel/sched.fd — Process scheduler (round-robin)
// Process table at 0x320000, up to 8 processes, 64 bytes each.

module sched;

use console;
use syscall;

pub const SCHED_TABLE: i64 = 0x320000;
pub const SCHED_MAX_PROCS: i64 = 8;
pub const SCHED_ENTRY_SIZE: i64 = 64;
pub const PROC_FREE: i64 = 0;
pub const PROC_READY: i64 = 1;
pub const PROC_RUNNING: i64 = 2;
pub const PROC_BLOCKED: i64 = 3;

// Preemptive scheduler constants (shared with isr.fd)
pub const SCHED_QUANTUM_ADDR: i64 = 0x320080;
pub const SCHED_CURRENT_ADDR: i64 = 0x320084;
pub const SCHED_RBP_TABLE: i64 = 0x320100;  // per-process saved RBP (8 bytes × 8)

// Process stacks: 0x360000 (8 processes × 8KB)
pub const SCHED_STACK_BASE: i64 = 0x360000;
pub const SCHED_STACK_SIZE: i64 = 8192;

pub var sched_current: i64 = -1;  // current process index
pub var sched_ticks: i64 = 0;     // ticks in current quantum

// Initialize the scheduler — mark all process slots as free.
pub fn sched_init() -> void {
    var i: i64 = 0;
    while i < SCHED_MAX_PROCS {
        p_mem_write8(SCHED_TABLE + i * SCHED_ENTRY_SIZE, PROC_FREE);
        i = i + 1;
    }
    sched_current = -1;
    sched_ticks = 0;
    // Initialize preemptive scheduler state
    p_mem_write8(SCHED_QUANTUM_ADDR, 0);
    p_mem_write32(SCHED_CURRENT_ADDR, 0xFFFFFFFF);
}

// Create a new process. Returns PID or -1 if table is full.
pub fn sched_create(entry: i64, cr3: i64) -> i64 {
    var i: i64 = 0;
    while i < SCHED_MAX_PROCS {
        var base: i64 = SCHED_TABLE + i * SCHED_ENTRY_SIZE;
        if p_mem_read8(base) == PROC_FREE {
            p_mem_write8(base, PROC_READY);
            p_mem_write8(base + 8, 0);   // rsp (will be set on first run)
            p_mem_write8(base + 16, 0);  // rbp
            p_mem_write8(base + 24, cr3);
            p_mem_write8(base + 32, entry);
            p_mem_write8(base + 40, i + 1);  // pid = i+1
            p_mem_write8(base + 48, 0);  // ticks
            return i + 1;
        }
        i = i + 1;
    }
    return -1;
}

// Get the number of active (non-free) processes.
pub fn sched_count() -> i64 {
    var count: i64 = 0;
    var i: i64 = 0;
    while i < SCHED_MAX_PROCS {
        if p_mem_read8(SCHED_TABLE + i * SCHED_ENTRY_SIZE) != PROC_FREE {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// Find the next ready process after `current`.
pub fn sched_next_ready(current: i64) -> i64 {
    var i: i64 = current + 1;
    while i < SCHED_MAX_PROCS {
        if p_mem_read8(SCHED_TABLE + i * SCHED_ENTRY_SIZE) == PROC_READY {
            return i;
        }
        i = i + 1;
    }
    i = 0;
    while i <= current {
        if p_mem_read8(SCHED_TABLE + i * SCHED_ENTRY_SIZE) == PROC_READY {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Print process table status.
pub fn cmd_ps() -> void {
    con_putc(10);
    con_putc(80); con_putc(73); con_putc(68); con_putc(32); con_putc(83); con_putc(116); con_putc(97); con_putc(116); con_putc(101); con_putc(32); con_putc(69); con_putc(110); con_putc(116); con_putc(114); con_putc(121); // "PID State Entry"
    con_putc(10);
    var i: i64 = 0;
    while i < SCHED_MAX_PROCS {
        var base: i64 = SCHED_TABLE + i * SCHED_ENTRY_SIZE;
        var state: i64 = p_mem_read8(base);
        if state != PROC_FREE {
            var pid: i64 = p_mem_read8(base + 40);
            var entry: i64 = p_mem_read8(base + 32);
            print_dec(pid);
            con_putc(32);
            if state == PROC_READY { con_putc(82); con_putc(101); con_putc(97); con_putc(100); con_putc(121); } // "Ready"
            else if state == PROC_RUNNING { con_putc(82); con_putc(117); con_putc(110); } // "Run"
            else if state == PROC_BLOCKED { con_putc(66); con_putc(108); con_putc(111); con_putc(99); con_putc(107); } // "Block"
            con_putc(32);
            print_hex(entry);
            con_putc(10);
        }
        i = i + 1;
    }
}

// Show preemptive scheduler status
pub fn cmd_sched() -> void {
    con_putc(10);
    con_putc(83); con_putc(99); con_putc(104); con_putc(101); con_putc(100); // "Sched"
    con_putc(58); con_putc(32);
    var current: i64 = p_mem_read32(SCHED_CURRENT_ADDR);
    var quantum: i64 = p_mem_read8(SCHED_QUANTUM_ADDR);
    con_putc(99); con_putc(117); con_putc(114); // "cur"
    con_putc(58);
    print_dec(current);
    con_putc(32);
    con_putc(113); // "q"
    con_putc(58);
    print_dec(quantum);
    con_putc(32);
    con_putc(112); con_putc(114); con_putc(111); con_putc(99); con_putc(115); // "procs"
    con_putc(58);
    print_dec(sched_count());
    con_putc(10);
}

// ─── Spinlocks (SMP-safe atomic locks) ──────────────────────────────────
// Spinlock state: 0 = unlocked, 1 = locked
// Uses p_atomic_xchg32 for test-and-set atomicity.

pub fn spinlock_init(lock_addr: i64) -> void {
    p_mem_write32(lock_addr, 0);
}

pub fn spinlock_acquire(lock_addr: i64) -> void {
    var locked: i64 = 0;
    while locked == 0 {
        // Atomically exchange 1 with the lock value; if old value was 0, we got the lock
        var old: i64 = p_atomic_xchg32(lock_addr, 1);
        if old == 0 {
            locked = 1;
        }
    }
}

pub fn spinlock_try(lock_addr: i64) -> i64 {
    var old: i64 = p_atomic_xchg32(lock_addr, 1);
    if old == 0 { return 1; }  // acquired
    return 0;  // already locked
}

pub fn spinlock_release(lock_addr: i64) -> void {
    p_mem_write32(lock_addr, 0);
}

// ─── Kernel Threads ──────────────────────────────────────────────────────
// Thread control blocks at 0x330000 (16 threads × 128 bytes)
// Each TCB: state(4), entry(8), arg(8), stack_ptr(8), stack_top(8), next(4)
pub const KTHREAD_TABLE: i64 = 0x330000;
pub const KTHREAD_MAX: i64 = 16;
pub const KTHREAD_ENTRY_SIZE: i64 = 128;
pub const KTHREAD_FREE: i64 = 0;
pub const KTHREAD_READY: i64 = 1;
pub const KTHREAD_RUNNING: i64 = 2;
pub const KTHREAD_DONE: i64 = 3;

// Thread stacks at 0x340000 (16 threads × 4096 bytes)
pub const KTHREAD_STACKS: i64 = 0x340000;
pub const KTHREAD_STACK_SIZE: i64 = 4096;

pub fn kthread_init() -> void {
    var i: i64 = 0;
    while i < KTHREAD_MAX {
        p_mem_write32(KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE, KTHREAD_FREE);
        i = i + 1;
    }
}

// Create a kernel thread. Returns thread ID or -1 if table is full.
// Sets up the thread's stack with a fake iret frame and saved registers
// so the timer handler's epilogue can context-switch to it.
pub fn kthread_create(entry: i64, arg: i64) -> i64 {
    var i: i64 = 0;
    while i < KTHREAD_MAX {
        var base: i64 = KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE;
        var state: i64 = p_mem_read32(base);
        if state == KTHREAD_FREE {
            p_mem_write32(base, KTHREAD_READY);
            p_mem_write32(base + 4, entry & 0xFFFFFFFF);
            p_mem_write32(base + 8, (entry >> 32) & 0xFFFFFFFF);
            p_mem_write32(base + 12, arg & 0xFFFFFFFF);
            p_mem_write32(base + 16, (arg >> 32) & 0xFFFFFFFF);
            // Set up stack with iret frame + saved registers
            // Stack layout (high to low):
            //   SS, RSP, RFLAGS, CS, RIP (iret frame)
            //   RAX, RBX, RCX, RDX, RSI, RDI, R8-R15 (saved regs)
            //   RBP (saved frame pointer) <- RBP points here
            var stack_top: i64 = KTHREAD_STACKS + i * KTHREAD_STACK_SIZE + KTHREAD_STACK_SIZE;
            var sp: i64 = stack_top;
            // iret frame (5 x 8 bytes = 40 bytes)
            sp = sp - 8;  p_mem_write32(sp, 0x10); p_mem_write32(sp + 4, 0);       // SS = 0x10
            sp = sp - 8;  p_mem_write32(sp, stack_top & 0xFFFFFFFF); p_mem_write32(sp + 4, (stack_top >> 32) & 0xFFFFFFFF); // RSP
            sp = sp - 8;  p_mem_write32(sp, 0x202); p_mem_write32(sp + 4, 0);     // RFLAGS = 0x202 (IF set)
            sp = sp - 8;  p_mem_write32(sp, 0x08); p_mem_write32(sp + 4, 0);      // CS = 0x08
            sp = sp - 8;  p_mem_write32(sp, entry & 0xFFFFFFFF); p_mem_write32(sp + 4, (entry >> 32) & 0xFFFFFFFF); // RIP = entry
            // Saved registers (15 x 8 bytes = 120 bytes)
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // RAX
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // RBX
            sp = sp - 8;  p_mem_write32(sp, arg & 0xFFFFFFFF); p_mem_write32(sp + 4, (arg >> 32) & 0xFFFFFFFF);  // RCX = arg
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // RDX
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // RSI
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // RDI
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // R8
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // R9
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // R10
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // R11
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // R12
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // R13
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // R14
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // R15
            // Saved RBP (the epilogue's `pop rbp` will read this)
            sp = sp - 8;  p_mem_write32(sp, 0); p_mem_write32(sp + 4, 0);  // RBP = 0
            // Save the thread's RBP (points to the saved RBP slot on the stack)
            p_mem_write32(base + 36, sp & 0xFFFFFFFF);
            p_mem_write32(base + 40, (sp >> 32) & 0xFFFFFFFF);
            // Save stack top for reference
            p_mem_write32(base + 20, stack_top & 0xFFFFFFFF);
            p_mem_write32(base + 24, (stack_top >> 32) & 0xFFFFFFFF);
            p_mem_write32(base + 28, sp & 0xFFFFFFFF);
            p_mem_write32(base + 32, (sp >> 32) & 0xFFFFFFFF);
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Yield CPU to next ready thread (cooperative scheduling).
pub fn kthread_yield() -> void {
    sched_ticks = 0;
}

// Timer tick handler for preemptive scheduling.
// Called from the shell loop when quantum expires.
// Finds next ready thread and updates scheduling state.
// Note: Real context switch requires assembly-level RBP/RSP manipulation
// which is not safe from Fides code. This is a cooperative scheduler
// that tracks scheduling state and selects the next thread.
pub fn sched_timer_tick() -> void {
    // Reset quantum
    p_mem_write8(SCHED_QUANTUM_ADDR, 0);
    // Get current thread
    var current: i64 = p_mem_read32(SCHED_CURRENT_ADDR);
    // If no current thread, find first ready thread
    if current == 0xFFFFFFFF {
        var i: i64 = 0;
        while i < KTHREAD_MAX {
            if p_mem_read32(KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE) == KTHREAD_READY {
                p_mem_write32(SCHED_CURRENT_ADDR, i);
                p_mem_write32(KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE, KTHREAD_RUNNING);
                return;
            }
            i = i + 1;
        }
        return;
    }
    // Mark current as READY
    var cur_base: i64 = KTHREAD_TABLE + current * KTHREAD_ENTRY_SIZE;
    if p_mem_read32(cur_base) == KTHREAD_RUNNING {
        p_mem_write32(cur_base, KTHREAD_READY);
    }
    // Find next ready thread (round-robin)
    var next: i64 = -1;
    var i: i64 = current + 1;
    while i < KTHREAD_MAX {
        if p_mem_read32(KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE) == KTHREAD_READY {
            next = i;
            i = KTHREAD_MAX;
        } else {
            i = i + 1;
        }
    }
    if next == -1 {
        i = 0;
        while i <= current {
            if p_mem_read32(KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE) == KTHREAD_READY {
                next = i;
                i = current + 1;
            } else {
                i = i + 1;
            }
        }
    }
    if next == -1 {
        // No ready thread — keep current
        p_mem_write32(cur_base, KTHREAD_RUNNING);
        return;
    }
    // Switch to next thread
    p_mem_write32(SCHED_CURRENT_ADDR, next);
    p_mem_write32(KTHREAD_TABLE + next * KTHREAD_ENTRY_SIZE, KTHREAD_RUNNING);
}

// Get thread state
pub fn kthread_state(tid: i64) -> i64 {
    if tid < 0 || tid >= KTHREAD_MAX { return -1; }
    return p_mem_read32(KTHREAD_TABLE + tid * KTHREAD_ENTRY_SIZE);
}

// Join: wait for thread to complete
pub fn kthread_join(tid: i64) -> i64 {
    if tid < 0 || tid >= KTHREAD_MAX { return -1; }
    while p_mem_read32(KTHREAD_TABLE + tid * KTHREAD_ENTRY_SIZE) != KTHREAD_DONE {
        kthread_yield();
    }
    return 0;
}

// Exit: mark current thread as done
pub fn kthread_exit() -> void {
    // Mark thread 0 as done (simplified)
    p_mem_write32(KTHREAD_TABLE, KTHREAD_DONE);
}

// Show thread table
pub fn cmd_threads() -> void {
    con_putc(10);
    con_putc(84); con_putc(104); con_putc(114); con_putc(101); con_putc(97); con_putc(100); con_putc(115); con_putc(58); // "Threads:"
    con_putc(10);
    var i: i64 = 0;
    while i < KTHREAD_MAX {
        var state: i64 = p_mem_read32(KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE);
        if state != KTHREAD_FREE {
            var entry: i64 = p_mem_read32(KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE + 4) | (p_mem_read32(KTHREAD_TABLE + i * KTHREAD_ENTRY_SIZE + 8) << 32);
            // "TID: N State: S Entry: 0xADDR"
            con_putc(84); con_putc(58); con_putc(32); // "T: "
            print_dec(i);
            con_putc(32);
            con_putc(83); con_putc(58); con_putc(32); // "S: "
            print_dec(state);
            con_putc(32);
            con_putc(69); con_putc(58); con_putc(32); // "E: "
            print_hex(entry);
            con_putc(10);
        }
        i = i + 1;
    }
}

// ─── Priority Scheduling ─────────────────────────────────────────────────
// Selects the next runnable process by priority (lowest nice value wins;
// ties broken by round-robin order). Operates on the process descriptors in
// syscall.fd's PROC_TABLE so the scheduler and the process table stay in
// sync. `nice` ranges -20 (highest priority) .. 19 (lowest).

// Pick the next READY process after `current` by priority. Returns its
// table index, or -1 if none is runnable.
pub fn proc_next_by_priority(current: i64) -> i64 {
    var best: i64 = -1;
    var best_prio: i64 = 0;
    var i: i64 = 0;
    while i < MAX_PROCS {
        var base: i64 = PROC_TABLE + i * PROC_ENTRY_SIZE;
        var pid: i64 = p_mem_read64(base);
        var state: i64 = p_mem_read64(base + 8);
        if pid != 0 && state == PROC_READY {
            var prio: i64 = p_mem_read64(base + 40);
            if best < 0 || prio < best_prio {
                best = i;
                best_prio = prio;
            }
        }
        i = i + 1;
    }
    return best;
}

// Set the current process's nice level. Wraps proc_set_priority for the
// currently-running process.
pub fn proc_nice(nice: i64) -> i64 {
    return proc_set_priority(current_pid, nice);
}

// Show all processes with their priorities (full process table view).
pub fn cmd_procs() -> void {
    con_putc(10);
    // "PID STATE PRIO PPID ENTRY"
    con_putc(80); con_putc(73); con_putc(68); con_putc(32); // "PID "
    con_putc(83); con_putc(84); con_putc(32); con_putc(32); // "ST  "
    con_putc(80); con_putc(82); // "PR"
    con_putc(32); con_putc(32); // "  "
    con_putc(80); con_putc(80); con_putc(73); con_putc(68); // "PPID"
    con_putc(32);
    con_putc(69); con_putc(78); con_putc(84); // "ENT"
    con_putc(10);
    var i: i64 = 0;
    while i < MAX_PROCS {
        var base: i64 = PROC_TABLE + i * PROC_ENTRY_SIZE;
        var pid: i64 = p_mem_read64(base);
        if pid != 0 {
            var state: i64 = p_mem_read64(base + 8);
            var prio: i64 = p_mem_read64(base + 40);
            var ppid: i64 = p_mem_read64(base + 32);
            var entry: i64 = p_mem_read64(base + 16);
            print_dec(pid);
            con_putc(32);
            // State label
            if state == PROC_READY { con_putc(82); con_putc(100); } // "Rd"
            else if state == PROC_RUNNING { con_putc(82); con_putc(110); } // "Rn"
            else if state == PROC_BLOCKED { con_putc(66); con_putc(108); } // "Bl"
            else if state == PROC_ZOMBIE { con_putc(90); con_putc(109); } // "Zm"
            else if state == PROC_STOPPED { con_putc(83); con_putc(112); } // "Sp"
            con_putc(32);
            print_dec(prio);
            con_putc(32);
            print_dec(ppid);
            con_putc(32);
            print_hex(entry);
            con_putc(10);
        }
        i = i + 1;
    }
}

// cmd_nice: set current process priority (nice level)
// Usage: nice <value>  (e.g. "nice 5" or "nice -10")
pub fn cmd_nice(input_len: i64) -> void {
    var val: i64 = 0;
    var neg: i64 = 0;
    var i: i64 = 5;  // skip "nice "
    while i < input_len {
        var c: i64 = input_get(i);
        var is_neg: i64 = 0;
        var is_digit: i64 = 0;
        if c == 45 { is_neg = 1; }
        if c >= 48 { if c <= 57 { is_digit = 1; } }
        if is_neg == 1 { neg = 1; }
        if is_digit == 1 { val = val * 10 + (c - 48); }
        i = i + 1;
    }
    if neg == 1 { val = 0 - val; }
    // Clamp to -20..19
    var min_val: i64 = 0 - 20;
    if val < min_val { val = min_val; }
    if val > 19 { val = 19; }
    var r: i64 = proc_nice(val);
    con_putc(10);
    if r == 0 {
        con_putc(110); con_putc(105); con_putc(99); con_putc(101); con_putc(61); // "nice="
        print_dec(val);
    } else {
        con_putc(69); con_putc(114); con_putc(114); con_putc(111); con_putc(114); // "Error"
    }
    con_putc(10);
}

// cmd_kill: kill a process by PID
// Usage: kill <pid>
pub fn cmd_kill(input_len: i64) -> void {
    var pid: i64 = 0;
    var i: i64 = 5;  // skip "kill "
    while i < input_len {
        var c: i64 = input_get(i);
        var is_digit: i64 = 0;
        if c >= 48 { if c <= 57 { is_digit = 1; } }
        if is_digit == 1 { pid = pid * 10 + (c - 48); }
        i = i + 1;
    }
    if pid <= 0 {
        con_putc(10);
        con_putc(63); con_putc(10);  // "?"
        return;
    }
    var r: i64 = sys_kill(pid, SIGKILL);
    con_putc(10);
    if r == 0 {
        con_putc(107); con_putc(105); con_putc(108); con_putc(108); con_putc(101); con_putc(100); // "killed"
        con_putc(32);
        print_dec(pid);
    } else {
        con_putc(69); con_putc(114); con_putc(114); // "Err"
    }
    con_putc(10);
}

// cmd_fork: test fork by creating a child process
pub fn cmd_fork() -> void {
    con_putc(10);
    var pid: i64 = sys_fork();
    if pid > 0 {
        con_putc(99); con_putc(104); con_putc(105); con_putc(108); con_putc(100); con_putc(61); // "child="
        print_dec(pid);
    } else if pid == 0 {
        con_putc(112); con_putc(97); con_putc(114); con_putc(101); con_putc(110); con_putc(116); // "parent"
    } else {
        con_putc(69); con_putc(114); con_putc(114); // "Err"
    }
    con_putc(10);
}
