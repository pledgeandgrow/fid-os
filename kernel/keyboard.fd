// kernel/keyboard.fd — PS/2 keyboard input (interrupt-driven)
//
// Scancode circular buffer at 0x600 (64 entries × 8 bytes = 512 bytes)
// Head/tail pointers at 0x680/0x688
// Shift state at 0x689 (0=none, 1=left or right shift)
// CapsLock state at 0x68A (0=off, 1=on)

module keyboard;

// Scancode circular buffer at 0x600 (64 entries × 8 bytes = 512 bytes)
pub const SCANCODE_BUF: i64 = 0x600;
pub const SCANCODE_HEAD: i64 = 0x680;
pub const SCANCODE_TAIL: i64 = 0x688;
pub const KBD_SHIFT: i64 = 0x689;
pub const KBD_CAPS: i64 = 0x68A;
pub const KBD_EXTENDED: i64 = 0x68B;  // 1 = next scancode is extended (0xE0 prefix)
pub const SCANCODE_SIZE: i64 = 64;

// Scancode ready flag and raw scancode storage for the interrupt handler.
// The handler is minimal (no local vars, no if blocks) due to PE backend
// limitations with interrupt handler code generation. It stores the raw
// scancode at KBD_RAW_SCANCODE and sets KBD_SCANCODE_READY.
// kbd_read_scancode() processes the raw scancode in normal context.
pub const KBD_RAW_SCANCODE: i64 = 0x6D0;
pub const KBD_SCANCODE_READY: i64 = 0x6D1;

// IRQ1 keyboard interrupt handler.
// The boot trampoline automatically wires this to IDT vector 0x21.
// NOTE: Keep this handler MINIMAL — the PE backend has limitations with
// interrupt handler code generation:
//   - No local variables (causes page faults)
//   - No `return` inside `if` blocks (causes #UD)
//   - No `p_mem_write32`/`p_mem_write64` (causes #UD)
//   - No non-zero `p_mem_write8` inside `if` blocks (causes #UD)
// The handler just stores the raw scancode and sends EOI.
// All scancode processing (shift, caps, extended, buffer) is done in
// kbd_read_scancode() which runs in the shell loop (normal context).
interrupt fn irq1_handler() -> void {
    // Read scancode and store it at KBD_RAW_SCANCODE
    // (non-zero scancode = ready, 0 = no key)
    p_mem_write8(KBD_RAW_SCANCODE, p_inb(0x60));
    // Send EOI to master PIC
    p_outb(0x20, 0x20);
}

// Read a scancode from the buffer. Returns -1 if no scancode available.
// Uses hlt to wait for interrupts (CPU sleeps until a key is pressed).
// The interrupt handler stores the raw scancode at KBD_RAW_SCANCODE and
// sets KBD_SCANCODE_READY. This function reads the raw scancode and
// returns it. Scancode processing (shift, caps, extended) is done in
// scancode_to_ascii().
//
// NOTE: No `return` inside `if` blocks — PE backend generates incorrect
// label resolutions for that pattern, causing jumps to land in the middle
// of instructions and crash with page faults.
pub fn kbd_read_scancode() -> i64 {
    var sc: i64 = 0;
    while sc == 0 {
        sc = p_mem_read8(KBD_RAW_SCANCODE);
        if sc == 0 {
            p_hlt();
        }
    }
    // Clear the scancode (0 = no key)
    p_mem_write8(KBD_RAW_SCANCODE, 0);
    return sc;
}

// Process shift/caps/extended state from a raw scancode.
// Returns -1 if the scancode is a modifier (shift, caps, extended)
// and should be consumed (not returned to the caller).
// Returns the scancode unchanged if it's a regular key.
//
// NOTE: No `return` inside `if` blocks — PE backend limitation.
pub fn kbd_process_modifiers(sc: i64) -> i64 {
    var result: i64 = sc;

    // Handle 0xE0 extended key prefix
    if sc == 0xE0 {
        p_mem_write8(KBD_EXTENDED, 1);
        result = -1;
    }

    // If extended flag is set, add 0x100 to distinguish extended keys
    var ext: i64 = p_mem_read8(KBD_EXTENDED);
    if ext == 1 {
        if sc != 0xE0 {
            p_mem_write8(KBD_EXTENDED, 0);
            result = sc + 256;
        }
    }

    // Track Shift state
    if sc == 0x2A {
        p_mem_write8(KBD_SHIFT, 1);
        result = -1;
    }
    if sc == 0x36 {
        p_mem_write8(KBD_SHIFT, 1);
        result = -1;
    }
    if sc == 0xAA {
        p_mem_write8(KBD_SHIFT, 0);
        result = -1;
    }
    if sc == 0xB6 {
        p_mem_write8(KBD_SHIFT, 0);
        result = -1;
    }

    // Toggle CapsLock on 0x3A
    if sc == 0x3A {
        var caps: i64 = p_mem_read8(KBD_CAPS);
        if caps == 0 {
            p_mem_write8(KBD_CAPS, 1);
        }
        if caps != 0 {
            p_mem_write8(KBD_CAPS, 0);
        }
        result = -1;
    }

    return result;
}

// Convert scancode to ASCII, respecting Shift and CapsLock state.
//
// NOTE: No `return` inside `if` blocks — PE backend generates incorrect
// label resolutions for that pattern, causing jumps to land in the middle
// of instructions and crash with page faults. All results are stored in
// a single `result` variable and returned at the end.
pub fn scancode_to_ascii(sc: i64) -> i64 {
    var result: i64 = -1;

    // Release codes (bit 7 set) are not characters
    if (sc & 0x80) != 0 {
        result = -1;
    }

    var shift: i64 = p_mem_read8(KBD_SHIFT);
    var caps: i64 = p_mem_read8(KBD_CAPS);

    // Special keys
    if sc == 0x1C { result = 10; }  // Enter
    if sc == 0x39 { result = 32; }  // Space
    if sc == 0x0E { result = 8;  }  // Backspace

    // Letters (a-z): apply Shift or CapsLock for uppercase
    var letter: i64 = -1;
    if sc == 0x1E { letter = 97; }  if sc == 0x30 { letter = 98; }
    if sc == 0x2E { letter = 99; }  if sc == 0x20 { letter = 100; }
    if sc == 0x12 { letter = 101; } if sc == 0x21 { letter = 102; }
    if sc == 0x22 { letter = 103; } if sc == 0x23 { letter = 104; }
    if sc == 0x17 { letter = 105; } if sc == 0x24 { letter = 106; }
    if sc == 0x25 { letter = 107; } if sc == 0x26 { letter = 108; }
    if sc == 0x32 { letter = 109; } if sc == 0x31 { letter = 110; }
    if sc == 0x18 { letter = 111; } if sc == 0x19 { letter = 112; }
    if sc == 0x10 { letter = 113; } if sc == 0x13 { letter = 114; }
    if sc == 0x1F { letter = 115; } if sc == 0x14 { letter = 116; }
    if sc == 0x16 { letter = 117; } if sc == 0x2F { letter = 118; }
    if sc == 0x11 { letter = 119; } if sc == 0x2D { letter = 120; }
    if sc == 0x15 { letter = 121; } if sc == 0x2C { letter = 122; }
    if letter != -1 {
        // Uppercase if (shift XOR caps) for letters
        var upper: i64 = 0;
        if shift != 0 { upper = 1; }
        if caps != 0 { upper = 1 - upper; }
        if upper != 0 {
            result = letter - 32; // to uppercase
        }
        if upper == 0 {
            result = letter;
        }
    }

    // Number row: shifted gives symbols
    if sc == 0x02 { if shift != 0 { result = 33; } if shift == 0 { result = 49; } }  // 1 or !
    if sc == 0x03 { if shift != 0 { result = 64; } if shift == 0 { result = 50; } }  // 2 or @
    if sc == 0x04 { if shift != 0 { result = 35; } if shift == 0 { result = 51; } }  // 3 or #
    if sc == 0x05 { if shift != 0 { result = 36; } if shift == 0 { result = 52; } }  // 4 or $
    if sc == 0x06 { if shift != 0 { result = 37; } if shift == 0 { result = 53; } }  // 5 or %
    if sc == 0x07 { if shift != 0 { result = 94; } if shift == 0 { result = 54; } }  // 6 or ^
    if sc == 0x08 { if shift != 0 { result = 38; } if shift == 0 { result = 55; } }  // 7 or &
    if sc == 0x09 { if shift != 0 { result = 42; } if shift == 0 { result = 56; } }  // 8 or *
    if sc == 0x0A { if shift != 0 { result = 40; } if shift == 0 { result = 57; } }  // 9 or (
    if sc == 0x0B { if shift != 0 { result = 41; } if shift == 0 { result = 48; } }  // 0 or )

    // Punctuation (unshifted)
    if sc == 0x0C { if shift != 0 { result = 95; } if shift == 0 { result = 45; } }  // - or _
    if sc == 0x0D { if shift != 0 { result = 43; } if shift == 0 { result = 61; } }  // = or +
    if sc == 0x33 { if shift != 0 { result = 60; } if shift == 0 { result = 44; } }  // , or <
    if sc == 0x34 { if shift != 0 { result = 62; } if shift == 0 { result = 46; } }  // . or >
    if sc == 0x35 { if shift != 0 { result = 63; } if shift == 0 { result = 47; } }  // / or ?

    // Additional keys
    if sc == 0x27 { if shift != 0 { result = 123; } if shift == 0 { result = 59; } }  // ; or {
    if sc == 0x28 { if shift != 0 { result = 125; } if shift == 0 { result = 39; } }  // ' or }
    if sc == 0x29 { if shift != 0 { result = 126; } if shift == 0 { result = 96; } }  // ` or ~
    if sc == 0x2B { if shift != 0 { result = 124; } if shift == 0 { result = 92; } }  // \ or |
    if sc == 0x1A { if shift != 0 { result = 123; } if shift == 0 { result = 91; } }  // [ or {
    if sc == 0x1B { if shift != 0 { result = 125; } if shift == 0 { result = 93; } }  // ] or }

    return result;
}
