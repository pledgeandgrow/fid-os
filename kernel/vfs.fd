// kernel/vfs.fd — FAT32 filesystem reader
// Simplified FAT32 reader. Assumes disk starts at sector 0, partition 0 is FAT32.

module vfs;

use console;
use ata;
use capability;

pub const FAT32_BUF: i64 = 0x40000;     // sector buffer for FS operations
pub const FAT_ROOT_CLUSTER: i64 = 2;    // FAT32 root dir starts at cluster 2

// FAT32 state (stored at 0x41000, each field is 4 bytes)
pub const FAT_STATE_ADDR: i64 = 0x41000;
pub const FAT_BYTES_PER_SECTOR: i64 = 0x41000;  // offset 0 (4 bytes)
pub const FAT_SECTORS_PER_CLUSTER: i64 = 0x41004; // offset 4 (4 bytes)
pub const FAT_RESERVED_SECTORS: i64 = 0x41008;  // offset 8 (4 bytes)
pub const FAT_NUM_FATS: i64 = 0x4100C;          // offset 12 (4 bytes)
pub const FAT_SECTORS_PER_FAT: i64 = 0x41010;   // offset 16 (4 bytes)
pub const FAT_FIRST_DATA_SECTOR: i64 = 0x41014; // offset 20 (4 bytes)
pub const FAT_INITIALIZED: i64 = 0x41018;       // offset 24 (1 byte)

// Initialize FAT32 by reading BPB from sector 0
pub fn fat32_init() -> i64 {
    var result: i64 = ata_read_sector(0, FAT32_BUF);
    if result != 0 { return -1; }

    // Read BPB fields (little-endian)
    var bps: i64 = p_mem_read8(FAT32_BUF + 11) | (p_mem_read8(FAT32_BUF + 12) << 8);
    var spc: i64 = p_mem_read8(FAT32_BUF + 13);
    var reserved: i64 = p_mem_read8(FAT32_BUF + 14) | (p_mem_read8(FAT32_BUF + 15) << 8);
    var num_fats: i64 = p_mem_read8(FAT32_BUF + 16);
    // sectors_per_fat32 at offset 36 (4 bytes)
    var spf: i64 = p_mem_read8(FAT32_BUF + 36) | (p_mem_read8(FAT32_BUF + 37) << 8) |
                    (p_mem_read8(FAT32_BUF + 38) << 16) | (p_mem_read8(FAT32_BUF + 39) << 24);

    p_mem_write32(FAT_BYTES_PER_SECTOR, bps);
    p_mem_write32(FAT_SECTORS_PER_CLUSTER, spc);
    p_mem_write32(FAT_RESERVED_SECTORS, reserved);
    p_mem_write32(FAT_NUM_FATS, num_fats);
    p_mem_write32(FAT_SECTORS_PER_FAT, spf);

    // first_data_sector = reserved + num_fats * sectors_per_fat
    var first_data: i64 = reserved + num_fats * spf;
    p_mem_write32(FAT_FIRST_DATA_SECTOR, first_data);
    p_mem_write8(FAT_INITIALIZED, 1);

    return 0;
}

// Convert cluster number to starting sector
pub fn fat32_cluster_to_sector(cluster: i64) -> i64 {
    var first_data: i64 = p_mem_read32(FAT_FIRST_DATA_SECTOR);
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    return (cluster - 2) * spc + first_data;
}

// Read FAT entry for a cluster (returns next cluster or 0xFFFFFFFF for end)
pub fn fat32_read_fat(cluster: i64) -> i64 {
    var bps: i64 = p_mem_read32(FAT_BYTES_PER_SECTOR);
    var reserved: i64 = p_mem_read32(FAT_RESERVED_SECTORS);
    // FAT entry offset = cluster * 4 bytes
    var fat_offset: i64 = cluster * 4;
    var fat_sector: i64 = reserved + (fat_offset / bps);
    var entry_offset: i64 = fat_offset % bps;

    var result: i64 = ata_read_sector(fat_sector, FAT32_BUF);
    if result != 0 { return 0xFFFFFFFF; }

    var entry: i64 = p_mem_read8(FAT32_BUF + entry_offset) |
                     (p_mem_read8(FAT32_BUF + entry_offset + 1) << 8) |
                     (p_mem_read8(FAT32_BUF + entry_offset + 2) << 16) |
                     (p_mem_read8(FAT32_BUF + entry_offset + 3) << 24);
    return entry & 0x0FFFFFFF;
}

// Read a cluster into a buffer
pub fn fat32_read_cluster(cluster: i64, buf: i64) -> i64 {
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    var sector: i64 = fat32_cluster_to_sector(cluster);
    var i: i64 = 0;
    while i < spc {
        var result: i64 = ata_read_sector(sector + i, buf + i * 512);
        if result != 0 { return -1; }
        i = i + 1;
    }
    return 0;
}

// Directory entry structure (32 bytes):
// [0-10] name (8.3, space-padded)
// [11]   attributes
// [12]   reserved
// [20-21] cluster high
// [26-27] cluster low
// [28-31] file size

// List files in root directory
pub fn cmd_ls() -> void {
    con_putc(10);
    if p_mem_read8(FAT_INITIALIZED) != 1 {
        con_putc(70); con_putc(83); con_putc(32); con_putc(110); con_putc(111); con_putc(116); con_putc(32); con_putc(105); con_putc(110); con_putc(105); con_putc(116); // "FS not init"
        con_putc(10);
        return;
    }

    var cluster: i64 = FAT_ROOT_CLUSTER;
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    var cluster_size: i64 = spc * 512;

    while cluster < 0x0FFFFFF8 {
        var result: i64 = fat32_read_cluster(cluster, FAT32_BUF);
        if result != 0 {
            con_putc(82); con_putc(101); con_putc(97); con_putc(100); con_putc(32); con_putc(101); con_putc(114); con_putc(114); // "Read err"
            con_putc(10);
            return;
        }

        var offset: i64 = 0;
        while offset < cluster_size {
            var first_byte: i64 = p_mem_read8(FAT32_BUF + offset);
            if first_byte == 0 { break; }  // end of directory
            if first_byte != 0xE5 {  // not deleted
                var attr: i64 = p_mem_read8(FAT32_BUF + offset + 11);
                if (attr & 0x0F) != 0x0F {  // not LFN entry
                    // Print name (8.3)
                    var i: i64 = 0;
                    while i < 11 {
                        var c: i64 = p_mem_read8(FAT32_BUF + offset + i);
                        if c != 32 { con_putc(c); }
                        if i == 7 && p_mem_read8(FAT32_BUF + offset + 8) != 32 {
                            con_putc(46);  // '.'
                        }
                        i = i + 1;
                    }
                    con_putc(32);
                    // Print size (simple, no division)
                    var size: i64 = p_mem_read8(FAT32_BUF + offset + 28) +
                                    (p_mem_read8(FAT32_BUF + offset + 29) * 256);
                    if size >= 100 {
                        con_putc(48 + size / 100);
                        con_putc(48 + (size / 10) % 10);
                        con_putc(48 + size % 10);
                    } else if size >= 10 {
                        con_putc(48 + size / 10);
                        con_putc(48 + size % 10);
                    } else {
                        con_putc(48 + size);
                    }
                    con_putc(32); con_putc(66);  // " B"
                    if (attr & 0x10) != 0 {
                        con_putc(32); con_putc(60); con_putc(68); con_putc(73); con_putc(82); con_putc(62);  // " <DIR>"
                    }
                    con_putc(10);
                }
            }
            offset = offset + 32;
        }

        cluster = fat32_read_fat(cluster);
    }
}

// Find a file in root directory by 8.3 name.
// Returns cluster number if found, 0 if not found.
// Sets file_size_out to the file size.
pub fn fat32_find_file(name_addr: i64, name_len: i64, file_size_out: i64) -> i64 {
    if p_mem_read8(FAT_INITIALIZED) != 1 { return 0; }

    var cluster: i64 = FAT_ROOT_CLUSTER;
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    var cluster_size: i64 = spc * 512;

    while cluster < 0x0FFFFFF8 {
        var result: i64 = fat32_read_cluster(cluster, FAT32_BUF);
        if result != 0 { return 0; }

        var offset: i64 = 0;
        while offset < cluster_size {
            var first_byte: i64 = p_mem_read8(FAT32_BUF + offset);
            if first_byte == 0 { return 0; }  // end of directory
            if first_byte != 0xE5 {
                var attr: i64 = p_mem_read8(FAT32_BUF + offset + 11);
                if (attr & 0x0F) != 0x0F {
                    // Convert input filename to 8.3 format at 0x41040
                    // First, fill with spaces
                    var k: i64 = 0;
                    while k < 11 {
                        p_mem_write8(0x41040 + k, 32);
                        k = k + 1;
                    }
                    // Copy name part (before '.') to positions 0-7
                    var in_idx: i64 = 0;
                    var out_idx: i64 = 0;
                    var saw_dot: i64 = 0;
                    while in_idx < name_len {
                        var c: i64 = p_mem_read8(name_addr + in_idx);
                        // Uppercase
                        if c >= 97 && c <= 122 { c = c - 32; }
                        if c == 46 {  // '.'
                            saw_dot = 1;
                            out_idx = 8;  // extension starts at position 8
                        } else {
                            if saw_dot == 0 && out_idx < 8 {
                                p_mem_write8(0x41040 + out_idx, c);
                                out_idx = out_idx + 1;
                            } else if saw_dot == 1 && out_idx < 11 {
                                p_mem_write8(0x41040 + out_idx, c);
                                out_idx = out_idx + 1;
                            }
                        }
                        in_idx = in_idx + 1;
                    }
                    // Compare 11 bytes
                    var is_match: i64 = 1;
                    var i: i64 = 0;
                    while i < 11 {
                        var disk_c: i64 = p_mem_read8(FAT32_BUF + offset + i);
                        var input_c: i64 = p_mem_read8(0x41040 + i);
                        if disk_c != input_c {
                            is_match = 0;
                            i = 11;
                        }
                        i = i + 1;
                    }
                    if is_match == 1 {
                        var clus: i64 = p_mem_read8(FAT32_BUF + offset + 26) +
                                       (p_mem_read8(FAT32_BUF + offset + 27) * 256);
                        var sz: i64 = p_mem_read8(FAT32_BUF + offset + 28) +
                                     (p_mem_read8(FAT32_BUF + offset + 29) * 256);
                        p_mem_write8(file_size_out, sz);
                        return clus;
                    }
                }
            }
            offset = offset + 32;
        }
        cluster = fat32_read_fat(cluster);
    }
    return 0;
}

// Read file contents by cluster chain into a buffer
pub fn fat32_read_file(cluster: i64, buf: i64, max_size: i64) -> i64 {
    var spc: i64 = p_mem_read32(FAT_SECTORS_PER_CLUSTER);
    var cluster_size: i64 = spc * 512;
    var total: i64 = 0;

    while cluster < 0x0FFFFFF8 && total < max_size {
        var result: i64 = fat32_read_cluster(cluster, buf + total);
        if result != 0 { return total; }
        total = total + cluster_size;
        if total > max_size { total = max_size; }
        cluster = fat32_read_fat(cluster);
    }
    return total;
}

// Cat a file from FAT32 filesystem
pub fn cmd_cat(name_addr: i64, name_len: i64) -> void {
    con_putc(10);
    if p_mem_read8(FAT_INITIALIZED) != 1 {
        con_putc(70); con_putc(83); con_putc(32); con_putc(110); con_putc(111); con_putc(116); con_putc(32); con_putc(105); con_putc(110); con_putc(105); con_putc(116);
        con_putc(10);
        return;
    }

    var file_size: i64 = 0;
    var size_addr: i64 = 0x41020;  // temp storage for file size
    var cluster: i64 = fat32_find_file(name_addr, name_len, size_addr);
    if cluster == 0 {
        con_putc(78); con_putc(111); con_putc(116); con_putc(32); con_putc(102); con_putc(111); con_putc(117); con_putc(110); con_putc(100); // "Not found"
        con_putc(10);
        return;
    }

    file_size = p_mem_read8(size_addr);
    // Direct read: bypass fat32_read_file, read sector directly
    var sector: i64 = fat32_cluster_to_sector(cluster);
    var result: i64 = ata_read_sector(sector, FAT32_BUF);
    if result != 0 {
        con_putc(82); con_putc(101); con_putc(97); con_putc(100); con_putc(32); con_putc(101); con_putc(114); con_putc(114);
        con_putc(10);
        return;
    }

    // Print file contents
    var i: i64 = 0;
    while i < file_size {
        con_putc(p_mem_read8(FAT32_BUF + i));
        i = i + 1;
    }
    con_putc(10);
}

// ─── FAT32 Write Support ─────────────────────────────────────────────────

// Write a FAT entry (32-bit value at FAT offset)
pub fn fat32_write_fat(cluster: i64, value: i64) -> i64 {
    var reserved: i64 = p_mem_read32(FAT_RESERVED_SECTORS);
    var bps: i64 = p_mem_read32(FAT_BYTES_PER_SECTOR);
    var fat_offset: i64 = cluster * 4;
    var fat_sector: i64 = reserved + (fat_offset / bps);
    var sector_offset: i64 = fat_offset % bps;
    // Read the FAT sector
    var result: i64 = ata_read_sector(fat_sector, FAT32_BUF);
    if result != 0 { return -1; }
    // Write the 32-bit FAT entry (lower 28 bits used)
    p_mem_write32(FAT32_BUF + sector_offset, value & 0x0FFFFFFF);
    // Write back the FAT sector
    result = ata_write_sector(fat_sector, FAT32_BUF);
    if result != 0 { return -1; }
    // Also update the second FAT copy
    var spf: i64 = p_mem_read32(FAT_SECTORS_PER_FAT);
    result = ata_read_sector(fat_sector + spf, FAT32_BUF);
    if result != 0 { return -1; }
    p_mem_write32(FAT32_BUF + sector_offset, value & 0x0FFFFFFF);
    result = ata_write_sector(fat_sector + spf, FAT32_BUF);
    return result;
}

// Find a free cluster in the FAT
pub fn fat32_find_free_cluster() -> i64 {
    var reserved: i64 = p_mem_read32(FAT_RESERVED_SECTORS);
    var bps: i64 = p_mem_read32(FAT_BYTES_PER_SECTOR);
    var spf: i64 = p_mem_read32(FAT_SECTORS_PER_FAT);
    var total_fat_sectors: i64 = reserved + spf;
    var sector: i64 = reserved;
    while sector < total_fat_sectors {
        var result: i64 = ata_read_sector(sector, FAT32_BUF);
        if result != 0 { return -1; }
        var i: i64 = 0;
        while i < bps {
            var entry: i64 = p_mem_read32(FAT32_BUF + i);
            if entry == 0 {
                // Found free cluster
                var cluster: i64 = ((sector - reserved) * bps + i) / 4;
                return cluster;
            }
            i = i + 4;
        }
        sector = sector + 1;
    }
    return -1;  // no free clusters
}

// Write a cluster to disk
pub fn fat32_write_cluster(cluster: i64, buf: i64) -> i64 {
    var sector: i64 = fat32_cluster_to_sector(cluster);
    return ata_write_sector(sector, buf);
}

// Create a file in the root directory with initial data
// Returns 0 on success, -1 on failure
pub fn fat32_create_file(name_addr: i64, name_len: i64, data_addr: i64, data_len: i64) -> i64 {
    if p_mem_read8(FAT_INITIALIZED) != 1 { return -1; }

    // Find a free cluster for the file data
    var data_cluster: i64 = fat32_find_free_cluster();
    if data_cluster < 2 { return -1; }

    // Mark the cluster as end-of-chain in the FAT
    fat32_write_fat(data_cluster, 0x0FFFFFFF);

    // Write data to the cluster
    // First, zero the cluster buffer
    var i: i64 = 0;
    while i < 512 {
        p_mem_write8(FAT32_BUF, 0);
        i = i + 1;
    }
    // Copy data to buffer
    i = 0;
    while i < data_len && i < 512 {
        p_mem_write8(FAT32_BUF + i, p_mem_read8(data_addr + i));
        i = i + 1;
    }
    // Write the cluster
    fat32_write_cluster(data_cluster, FAT32_BUF);

    // Find the root directory (cluster 2 for FAT32)
    var root_sector: i64 = fat32_cluster_to_sector(2);
    var result: i64 = ata_read_sector(root_sector, FAT32_BUF);
    if result != 0 { return -1; }

    // Find a free directory entry (first byte = 0x00 or 0xE5)
    var entry_offset: i64 = -1;
    i = 0;
    while i < 512 {
        var first_byte: i64 = p_mem_read8(FAT32_BUF + i);
        if first_byte == 0 || first_byte == 0xE5 {
            entry_offset = i;
            break;
        }
        i = i + 32;
    }

    if entry_offset < 0 {
        // No free entry in this sector — try next root directory sector
        root_sector = root_sector + 1;
        result = ata_read_sector(root_sector, FAT32_BUF);
        if result != 0 { return -1; }
        entry_offset = 0;
    }

    // Create the directory entry (8.3 format)
    // Fill name with spaces (0x20)
    i = 0;
    while i < 11 {
        p_mem_write8(FAT32_BUF + entry_offset + i, 0x20);
        i = i + 1;
    }
    // Copy filename (up to 8 chars, pad with spaces)
    i = 0;
    while i < name_len && i < 8 {
        var c: i64 = p_mem_read8(name_addr + i);
        // Convert to uppercase for FAT32
        if c >= 97 && c <= 122 { c = c - 32; }
        p_mem_write8(FAT32_BUF + entry_offset + i, c);
        i = i + 1;
    }
    // Set attributes (0x20 = archive)
    p_mem_write8(FAT32_BUF + entry_offset + 11, 0x20);
    // Set first cluster (lower 16 bits at offset 26, upper 16 bits at offset 20)
    p_mem_write8(FAT32_BUF + entry_offset + 26, data_cluster & 0xFF);
    p_mem_write8(FAT32_BUF + entry_offset + 27, (data_cluster >> 8) & 0xFF);
    p_mem_write8(FAT32_BUF + entry_offset + 20, (data_cluster >> 16) & 0xFF);
    p_mem_write8(FAT32_BUF + entry_offset + 21, (data_cluster >> 24) & 0xFF);
    // Set file size (32-bit at offset 28)
    p_mem_write8(FAT32_BUF + entry_offset + 28, data_len & 0xFF);
    p_mem_write8(FAT32_BUF + entry_offset + 29, (data_len >> 8) & 0xFF);
    p_mem_write8(FAT32_BUF + entry_offset + 30, (data_len >> 16) & 0xFF);
    p_mem_write8(FAT32_BUF + entry_offset + 31, (data_len >> 24) & 0xFF);

    // Write the directory sector back
    ata_write_sector(root_sector, FAT32_BUF);

    return 0;
}

// Delete a file (mark directory entry as deleted)
pub fn fat32_delete_file(name_addr: i64, name_len: i64) -> i64 {
    if p_mem_read8(FAT_INITIALIZED) != 1 { return -1; }
    var root_sector: i64 = fat32_cluster_to_sector(2);
    var result: i64 = ata_read_sector(root_sector, FAT32_BUF);
    if result != 0 { return -1; }
    var i: i64 = 0;
    while i < 512 {
        var first_byte: i64 = p_mem_read8(FAT32_BUF + i);
        if first_byte == 0 { break; }  // end of directory
        if first_byte != 0xE5 {
            // Compare name (first 8 chars, uppercase)
            var is_match: i64 = 1;
            var j: i64 = 0;
            while j < name_len && j < 8 {
                var c: i64 = p_mem_read8(name_addr + j);
                if c >= 97 && c <= 122 { c = c - 32; }
                if p_mem_read8(FAT32_BUF + i + j) != c {
                    is_match = 0;
                    break;
                }
                j = j + 1;
            }
            if is_match == 1 && name_len <= 8 {
                // Mark entry as deleted
                p_mem_write8(FAT32_BUF + i, 0xE5);
                ata_write_sector(root_sector, FAT32_BUF);
                return 0;
            }
        }
        i = i + 32;
    }
    return -1;  // not found
}

// Touch command — create an empty file
pub fn cmd_touch(name_addr: i64, name_len: i64) -> void {
    con_putc(10);
    if p_mem_read8(FAT_INITIALIZED) != 1 {
        con_putc(70); con_putc(83); con_putc(32); con_putc(110); con_putc(111); con_putc(116); con_putc(32); con_putc(105); con_putc(110); con_putc(105); con_putc(116);
        con_putc(10);
        return;
    }
    var result: i64 = fat32_create_file(name_addr, name_len, 0, 0);
    if result == 0 {
        con_putc(79); con_putc(75); con_putc(10); // "OK"
    } else {
        con_putc(70); con_putc(97); con_putc(105); con_putc(108); // "Fail"
        con_putc(10);
    }
}

// Delete command — delete a file
pub fn cmd_rm(name_addr: i64, name_len: i64) -> void {
    con_putc(10);
    if p_mem_read8(FAT_INITIALIZED) != 1 {
        con_putc(70); con_putc(83); con_putc(32); con_putc(110); con_putc(111); con_putc(116); con_putc(32); con_putc(105); con_putc(110); con_putc(105); con_putc(116);
        con_putc(10);
        return;
    }
    var result: i64 = fat32_delete_file(name_addr, name_len);
    if result == 0 {
        con_putc(79); con_putc(75); con_putc(10); // "OK"
    } else {
        con_putc(78); con_putc(111); con_putc(116); con_putc(32); con_putc(102); con_putc(111); con_putc(117); con_putc(110); con_putc(100); // "Not found"
        con_putc(10);
    }
}

// ─── Capability-gated filesystem (fractal kernel proof of concept) ───────
// These functions wrap the existing FAT32 operations with capability
// checks. A caller must present a valid DISK capability with the
// appropriate permission (READ or WRITE) to access the filesystem.
//
// This demonstrates the fractal pattern: instead of any module calling
// fat32_read_file() directly, it must first obtain a disk capability
// and pass it to these gated functions. The capability enforces that
// the caller has been explicitly granted access.
//
// Root disk capability handle (created at boot in shell.fd):
//   handle 2 = CAP_TYPE_DISK, perms=READ|WRITE|GRANT, base=0, size=65536

// Read a file using a disk capability. Returns 0 on success, -1 if
// the capability is invalid or lacks READ permission, -2 if read fails.
pub fn vfs_cap_read_file(disk_cap: i64, name_addr: i64, name_len: i64, buf: i64) -> i64 {
    // Verify the caller has a disk capability with READ permission
    if capability_get_type(disk_cap) != 3 { return -1; }  // CAP_TYPE_DISK
    if capability_check(disk_cap, 1) == 0 { return -1; }  // CAP_PERM_READ

    // Check the requested file is within the capability's sector range
    // (base sector to base + size). For now, all files are in the root
    // directory which starts at cluster 2 — we allow it if the cap
    // covers sector 0 (where the BPB lives).
    var cap_base: i64 = capability_get_base(disk_cap);
    var cap_size: i64 = capability_get_size(disk_cap);
    if cap_base > 0 { return -1; }  // must start at sector 0 for FAT32
    if cap_size < 100 { return -1; }  // too small to be useful

    // Delegate to the existing FAT32 read
    var file_size: i64 = 0;
    var cluster: i64 = fat32_find_file(name_addr, name_len, 0x41040);
    if cluster == 0 { return -2; }
    var result: i64 = fat32_read_file(cluster, buf);
    return result;
}

// Write (create) a file using a disk capability. Returns 0 on success,
// -1 if the capability is invalid or lacks WRITE permission.
pub fn vfs_cap_write_file(disk_cap: i64, name_addr: i64, name_len: i64) -> i64 {
    if capability_get_type(disk_cap) != 3 { return -1; }  // CAP_TYPE_DISK
    if capability_check(disk_cap, 2) == 0 { return -1; }  // CAP_PERM_WRITE

    var cap_base: i64 = capability_get_base(disk_cap);
    if cap_base > 0 { return -1; }

    return fat32_create_file(name_addr, name_len);
}

// List files using a disk capability. Returns 0 on success, -1 if
// the capability is invalid or lacks READ permission.
pub fn vfs_cap_list(disk_cap: i64) -> i64 {
    if capability_get_type(disk_cap) != 3 { return -1; }  // CAP_TYPE_DISK
    if capability_check(disk_cap, 1) == 0 { return -1; }  // CAP_PERM_READ

    cmd_ls();
    return 0;
}

// Test the capability-gated filesystem. Called by a new shell command.
// Demonstrates: grant a restricted disk cap, then read/list with it.
pub fn cmd_capfs() -> void {
    con_putc(10);
    // "CapFS test:"
    con_putc(67); con_putc(97); con_putc(112); con_putc(70); con_putc(83);  // "CapFS"
    con_putc(32);
    con_putc(116); con_putc(101); con_putc(115); con_putc(116); con_putc(58);  // "test:"
    con_putc(10);

    // Root disk cap is handle 2 (created at boot)
    var root_cap: i64 = 2;

    // Verify it exists
    var cap_type: i64 = capability_get_type(root_cap);
    if cap_type != 3 {
        con_putc(78); con_putc(111); con_putc(32); con_putc(100); con_putc(105); con_putc(115); con_putc(107);  // "No disk"
        con_putc(10);
        return;
    }

    // "root="
    con_putc(114); con_putc(111); con_putc(111); con_putc(116); con_putc(61);
    print_dec(root_cap);
    con_putc(32);
    con_putc(112); con_putc(101); con_putc(114); con_putc(109); con_putc(115); con_putc(61);  // "perms="
    print_dec(capability_get_perms(root_cap));
    con_putc(10);

    // Grant a read-only child capability (no WRITE, no GRANT)
    var read_only_cap: i64 = capability_grant(root_cap, 1, 0);  // READ only
    // "ro="
    con_putc(114); con_putc(111); con_putc(61);
    print_dec(read_only_cap);
    con_putc(32);
    con_putc(112); con_putc(101); con_putc(114); con_putc(109); con_putc(115); con_putc(61);  // "perms="
    print_dec(capability_get_perms(read_only_cap));
    con_putc(10);

    // Try to list with the read-only cap — should succeed
    var r1: i64 = vfs_cap_list(read_only_cap);
    // "list="
    con_putc(108); con_putc(105); con_putc(115); con_putc(116); con_putc(61);
    print_dec(r1);
    con_putc(10);

    // Try to write with the read-only cap — should fail (-1)
    var dummy_name: i64 = 0x41060;
    p_mem_write8(dummy_name, 84);  // 'T'
    p_mem_write8(dummy_name + 1, 77);  // 'M'
    p_mem_write8(dummy_name + 2, 80);  // 'P'
    p_mem_write8(dummy_name + 3, 0);
    var r2: i64 = vfs_cap_write_file(read_only_cap, dummy_name, 3);
    // "write="
    con_putc(119); con_putc(114); con_putc(105); con_putc(116); con_putc(101); con_putc(61);
    print_dec(r2);
    // " (should be -1)"
    con_putc(32); con_putc(40); con_putc(115); con_putc(104); con_putc(111); con_putc(117); con_putc(108); con_putc(100);  // " (should"
    con_putc(32); con_putc(98); con_putc(101); con_putc(32); con_putc(45); con_putc(49); con_putc(41);  // " be -1)"
    con_putc(10);

    // Try to write with the root cap — should succeed (0)
    var r3: i64 = vfs_cap_write_file(root_cap, dummy_name, 3);
    // "rootwrite="
    con_putc(114); con_putc(119); con_putc(61);
    print_dec(r3);
    con_putc(10);

    // Revoke the read-only cap
    capability_revoke(read_only_cap);
    // Try to list with revoked cap — should fail (-1)
    var r4: i64 = vfs_cap_list(read_only_cap);
    // "revoked="
    con_putc(114); con_putc(101); con_putc(118); con_putc(61);
    print_dec(r4);
    con_putc(10);
}
