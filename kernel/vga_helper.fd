// vga_helper.fd — VGA text mode helper module

module vga_helper;

const VGA_MEM: i64 = 0xB8000;
const VGA_COLS: i64 = 80;
const VGA_ROWS: i64 = 25;

var vga_col: i64 = 0;
var vga_row: i64 = 0;

pub fn vga_clear() -> void {
    var i: i64 = 0;
    while i < 2000 {
        p_mem_write8(VGA_MEM + i * 2, 32);
        p_mem_write8(VGA_MEM + i * 2 + 1, 7);
        i = i + 1;
    }
    vga_col = 0;
    vga_row = 0;
}

pub fn vga_putc(c: i64) -> void {
    if c == 10 {
        vga_col = 0;
        vga_row = vga_row + 1;
        if vga_row >= 25 { vga_row = 0; }
        return;
    }
    var off: i64 = (vga_row * 80 + vga_col) * 2;
    p_mem_write8(VGA_MEM + off, c);
    p_mem_write8(VGA_MEM + off + 1, 7);
    vga_col = vga_col + 1;
    if vga_col >= 80 {
        vga_col = 0;
        vga_row = vga_row + 1;
        if vga_row >= 25 { vga_row = 0; }
    }
}
