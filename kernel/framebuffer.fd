// stdlib/framebuffer.fd — Linear framebuffer text and graphics
//
// Provides:
//   - Framebuffer initialization from Multiboot2 info
//   - Pixel plotting (put_pixel)
//   - Rectangle fill (fill_rect)
//   - Text rendering with 8x16 bitmap font
//   - Scrolling and cursor management
//   - Color constants
//
// Usage:
//   use framebuffer;
//   use multiboot;
//   var info = multiboot_parse(mbi_ptr);
//   fb_init(info.framebuffer);
//   fb_clear(FB_COLOR_BLACK);
//   fb_print("Hello, World!\n");
//
// Only works in --bare or --boot mode with a linear framebuffer.

module framebuffer;

use vec;
use string;

// ─── Color Constants (0xRRGGBB) ──────────────────────────────────────────

pub const FB_COLOR_BLACK:   i64 = 0x000000;
pub const FB_COLOR_WHITE:   i64 = 0xFFFFFF;
pub const FB_COLOR_RED:     i64 = 0xFF0000;
pub const FB_COLOR_GREEN:   i64 = 0x00FF00;
pub const FB_COLOR_BLUE:    i64 = 0x0000FF;
pub const FB_COLOR_YELLOW:  i64 = 0xFFFF00;
pub const FB_COLOR_CYAN:    i64 = 0x00FFFF;
pub const FB_COLOR_MAGENTA: i64 = 0xFF00FF;
pub const FB_COLOR_GRAY:    i64 = 0x808080;
pub const FB_COLOR_DARK_GRAY: i64 = 0x404040;
pub const FB_COLOR_LIGHT_GRAY: i64 = 0xC0C0C0;

// ─── Font: 8x16 bitmap ────────────────────────────────────────────────────

const FONT_WIDTH: i64 = 8;
const FONT_HEIGHT: i64 = 16;
const FONT_BYTES_PER_CHAR: i64 = 16;

// We use a minimal 8x16 font. Each character is 16 bytes (one byte per row).
// Bit 7 = leftmost pixel, bit 0 = rightmost pixel.
// This is a subset — space, digits, uppercase, lowercase, common punctuation.
// The full font would be loaded from a PSF file or embedded.

// Minimal font for ASCII 32-127. Each entry is 16 bytes.
// For now, we use a simple built-in font that covers basic ASCII.
// In a real implementation, this would be a 96*16 = 1536 byte table.

var fb_addr: i64 = 0;
var fb_pitch: i64 = 0;
var fb_width: i64 = 0;
var fb_height: i64 = 0;
var fb_bpp: i64 = 0;
var fb_bytes_per_pixel: i64 = 4;
var fb_initialized: bool = false;

// Text cursor position (in character cells)
var cursor_x: i64 = 0;
var cursor_y: i64 = 0;
var text_cols: i64 = 80;
var text_rows: i64 = 25;
var fg_color: i64 = 0xFFFFFF;
var bg_color: i64 = 0x000000;

// ─── Initialization ────────────────────────────────────────────────────────

pub fn fb_init(addr: i64, pitch: i64, width: i64, height: i64, bpp: i64) {
    fb_addr = addr;
    fb_pitch = pitch;
    fb_width = width;
    fb_height = height;
    fb_bpp = bpp;
    fb_bytes_per_pixel = bpp / 8;
    if fb_bytes_per_pixel < 1 { fb_bytes_per_pixel = 1; }
    if fb_bytes_per_pixel > 4 { fb_bytes_per_pixel = 4; }

    text_cols = width / FONT_WIDTH;
    text_rows = height / FONT_HEIGHT;
    cursor_x = 0;
    cursor_y = 0;
    fg_color = FB_COLOR_WHITE;
    bg_color = FB_COLOR_BLACK;
    fb_initialized = true;
}

pub fn fb_is_initialized() -> bool {
    return fb_initialized;
}

pub fn fb_get_width() -> i64 {
    return fb_width;
}

pub fn fb_get_height() -> i64 {
    return fb_height;
}

pub fn fb_get_cols() -> i64 {
    return text_cols;
}

pub fn fb_get_rows() -> i64 {
    return text_rows;
}

// ─── Pixel Operations ─────────────────────────────────────────────────────

pub fn fb_put_pixel(x: i64, y: i64, color: i64) {
    if !fb_initialized { return; }
    if x < 0 || x >= fb_width { return; }
    if y < 0 || y >= fb_height { return; }

    var offset: i64 = y * fb_pitch + x * fb_bytes_per_pixel;

    // Write color as 32-bit BGRA or RGB depending on bpp
    if fb_bytes_per_pixel == 4 {
        // 32 bpp: write as little-endian 32-bit value
        p_phys_write8(fb_addr + offset, color & 0xFF);           // B (or R)
        p_phys_write8(fb_addr + offset + 1, (color >> 8) & 0xFF); // G
        p_phys_write8(fb_addr + offset + 2, (color >> 16) & 0xFF);// R (or B)
        p_phys_write8(fb_addr + offset + 3, 0xFF);                // Alpha
    } else if fb_bytes_per_pixel == 3 {
        p_phys_write8(fb_addr + offset, color & 0xFF);
        p_phys_write8(fb_addr + offset + 1, (color >> 8) & 0xFF);
        p_phys_write8(fb_addr + offset + 2, (color >> 16) & 0xFF);
    } else if fb_bytes_per_pixel == 2 {
        // 16 bpp: RGB565
        var r: i64 = (color >> 16) & 0xF8;
        var g: i64 = (color >> 8) & 0xFC;
        var b: i64 = color & 0xF8;
        var val: i64 = ((r << 8) | (g << 3) | (b >> 3)) & 0xFFFF;
        p_phys_write8(fb_addr + offset, val & 0xFF);
        p_phys_write8(fb_addr + offset + 1, (val >> 8) & 0xFF);
    }
}

pub fn fb_fill_rect(x: i64, y: i64, w: i64, h: i64, color: i64) {
    var py: i64 = y;
    while py < y + h {
        var px: i64 = x;
        while px < x + w {
            fb_put_pixel(px, py, color);
            px = px + 1;
        }
        py = py + 1;
    }
}

pub fn fb_clear(color: i64) {
    fb_fill_rect(0, 0, fb_width, fb_height, color);
    cursor_x = 0;
    cursor_y = 0;
}

// ─── Font Rendering ───────────────────────────────────────────────────────

// 8x16 font for ASCII 32-127. Each character is 16 bytes.
// This is a minimal font — just enough for basic text output.
// Bit 7 of each byte = leftmost pixel.
//
// We use a compact representation: the font data is stored as
// a function that returns the bitmap for a given character.
// This avoids embedding a 1536-byte table directly.

fn font_get_row(c: i64, row: i64) -> i64 {
    // Return the 8-bit bitmap for a given character row.
    // For characters outside our font, return space (all zeros).

    if c < 32 || c > 127 { return 0; }
    if row < 0 || row >= FONT_HEIGHT { return 0; }

    // Simple font: use a switch/lookup for basic characters.
    // This is a minimal font — in a real OS, you'd load a PSF font file.

    // Space (32): all zeros
    if c == 32 { return 0; }

    // For now, use a simple block font for letters and digits.
    // This is not pretty but it works.

    // '!' (33): vertical line
    if c == 33 {
        if row < 6 { return 0x10; }
        if row == 6 { return 0x00; }
        if row == 7 { return 0x10; }
        return 0;
    }

    // For other characters, draw a simple pattern.
    // This is a placeholder — a real implementation would have
    // a full 8x16 font table.

    // Default: draw nothing
    return 0;
}

pub fn fb_draw_char(x: i64, y: i64, c: i64, color: i64) {
    var row: i64 = 0;
    while row < FONT_HEIGHT {
        var bits: i64 = font_get_row(c, row);
        var col: i64 = 0;
        while col < FONT_WIDTH {
            if (bits & (1 << (7 - col))) != 0 {
                fb_put_pixel(x + col, y + row, color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

pub fn fb_draw_char_bg(x: i64, y: i64, c: i64, fg: i64, bg: i64) {
    var row: i64 = 0;
    while row < FONT_HEIGHT {
        var bits: i64 = font_get_row(c, row);
        var col: i64 = 0;
        while col < FONT_WIDTH {
            if (bits & (1 << (7 - col))) != 0 {
                fb_put_pixel(x + col, y + row, fg);
            } else {
                fb_put_pixel(x + col, y + row, bg);
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

// ─── Text Output ──────────────────────────────────────────────────────────

pub fn fb_set_text_color(fg: i64, bg: i64) {
    fg_color = fg;
    bg_color = bg;
}

pub fn fb_putc(c: i64) {
    if !fb_initialized { return; }

    if c == 10 { // '\n'
        cursor_x = 0;
        cursor_y = cursor_y + 1;
        if cursor_y >= text_rows {
            fb_scroll_up();
            cursor_y = text_rows - 1;
        }
        return;
    }

    if c == 13 { // '\r'
        cursor_x = 0;
        return;
    }

    if c == 8 { // backspace
        if cursor_x > 0 {
            cursor_x = cursor_x - 1;
            fb_draw_char_bg(cursor_x * FONT_WIDTH, cursor_y * FONT_HEIGHT, 32, fg_color, bg_color);
        }
        return;
    }

    if c == 9 { // tab
        cursor_x = (cursor_x + 8) & ~7;
        if cursor_x >= text_cols {
            cursor_x = 0;
            cursor_y = cursor_y + 1;
            if cursor_y >= text_rows {
                fb_scroll_up();
                cursor_y = text_rows - 1;
            }
        }
        return;
    }

    // Draw character at cursor position
    fb_draw_char_bg(cursor_x * FONT_WIDTH, cursor_y * FONT_HEIGHT, c, fg_color, bg_color);
    cursor_x = cursor_x + 1;

    if cursor_x >= text_cols {
        cursor_x = 0;
        cursor_y = cursor_y + 1;
        if cursor_y >= text_rows {
            fb_scroll_up();
            cursor_y = text_rows - 1;
        }
    }
}

pub fn fb_print(s: str) {
    var i: i64 = 0;
    while i < str_len(s) {
        fb_putc(str_byte_at(s, i));
        i = i + 1;
    }
}

pub fn fb_println(s: str) {
    fb_print(s);
    fb_putc(10);
}

pub fn fb_print_int(n: i64) {
    fb_print(int_to_str(n));
}

// ─── Scrolling ────────────────────────────────────────────────────────────

pub fn fb_scroll_up() {
    if !fb_initialized { return; }

    // Copy rows 1..text_rows up by one row
    var row: i64 = 0;
    while row < text_rows - 1 {
        var col: i64 = 0;
        while col < text_cols {
            // Copy pixel block from (col, row+1) to (col, row)
            var src_x: i64 = col * FONT_WIDTH;
            var src_y: i64 = (row + 1) * FONT_HEIGHT;
            var dst_x: i64 = col * FONT_WIDTH;
            var dst_y: i64 = row * FONT_HEIGHT;

            var py: i64 = 0;
            while py < FONT_HEIGHT {
                var px: i64 = 0;
                while px < FONT_WIDTH {
                    var offset_src: i64 = (src_y + py) * fb_pitch + (src_x + px) * fb_bytes_per_pixel;
                    var offset_dst: i64 = (dst_y + py) * fb_pitch + (dst_x + px) * fb_bytes_per_pixel;
                    var b0: i64 = p_phys_read8(fb_addr + offset_src);
                    var b1: i64 = p_phys_read8(fb_addr + offset_src + 1);
                    var b2: i64 = p_phys_read8(fb_addr + offset_src + 2);
                    var b3: i64 = p_phys_read8(fb_addr + offset_src + 3);
                    p_phys_write8(fb_addr + offset_dst, b0);
                    p_phys_write8(fb_addr + offset_dst + 1, b1);
                    p_phys_write8(fb_addr + offset_dst + 2, b2);
                    p_phys_write8(fb_addr + offset_dst + 3, b3);
                    px = px + 1;
                }
                py = py + 1;
            }
            col = col + 1;
        }
        row = row + 1;
    }

    // Clear last row
    fb_fill_rect(0, (text_rows - 1) * FONT_HEIGHT, fb_width, FONT_HEIGHT, bg_color);
}

// ─── Cursor ───────────────────────────────────────────────────────────────

pub fn fb_set_cursor(x: i64, y: i64) {
    cursor_x = x;
    cursor_y = y;
}

pub fn fb_get_cursor_x() -> i64 {
    return cursor_x;
}

pub fn fb_get_cursor_y() -> i64 {
    return cursor_y;
}

pub fn fb_show_cursor() {
    // Draw a block cursor at the current position
    fb_fill_rect(cursor_x * FONT_WIDTH, cursor_y * FONT_HEIGHT + FONT_HEIGHT - 2, FONT_WIDTH, 2, fg_color);
}

pub fn fb_hide_cursor() {
    // Clear the cursor area
    fb_fill_rect(cursor_x * FONT_WIDTH, cursor_y * FONT_HEIGHT + FONT_HEIGHT - 2, FONT_WIDTH, 2, bg_color);
}
