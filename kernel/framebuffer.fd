// kernel/framebuffer.fd — VBE framebuffer console with bitmap font rendering
//
// VBE framebuffer info from GRUB multiboot2 (if available).
// The framebuffer address, width, height, and bpp are stored at 0x1B0000.
// Includes an 8x16 bitmap font for text rendering on the graphical screen.
//
// The font is stored at 0x1B1000 (96 chars × 16 bytes = 1536 bytes).
// Characters 32-127 (space to ~) are supported.

module framebuffer;

use console;

pub const FB_ADDR: i64 = 0x1B0000;    // framebuffer physical address
pub const FB_WIDTH: i64 = 0x1B0008;   // width in pixels
pub const FB_HEIGHT: i64 = 0x1B0010;  // height in pixels
pub const FB_BPP: i64 = 0x1B0018;     // bits per pixel
pub const FB_PITCH: i64 = 0x1B0020;   // bytes per scanline
pub const FB_CURSOR_X: i64 = 0x1B0028;  // cursor X (8 bytes)
pub const FB_CURSOR_Y: i64 = 0x1B0030;  // cursor Y (8 bytes)
pub const FB_FONT_WIDTH: i64 = 8;       // 8x16 font
pub const FB_FONT_HEIGHT: i64 = 16;
pub const FB_FONT_ADDR: i64 = 0x1B1000;  // font data (96 chars × 16 bytes)
pub const FB_FG_COLOR: i64 = 0x00FFFFFF;  // white
pub const FB_BG_COLOR: i64 = 0x00000000;  // black

// 64-bit memory helpers using 32-bit ops (avoids PE backend codegen issues)
fn fb_read64(addr: i64) -> i64 {
    return p_mem_read32(addr) | (p_mem_read32(addr + 4) << 32);
}
fn fb_write64(addr: i64, val: i64) {
    p_mem_write32(addr, val & 0xFFFFFFFF);
    p_mem_write32(addr + 4, (val >> 32) & 0xFFFFFFFF);
}

// Multiboot2 info pointer is saved at 0x50000 by the boot trampoline
pub const MB_INFO_PTR: i64 = 0x50000;

// Read a 32-bit value from a memory address (helper for multiboot parsing)
fn mb_read32(addr: i64) -> i64 {
    return p_mem_read32(addr);
}

// Parse multiboot2 info structure to find framebuffer tag (type 8)
// and populate FB metadata at 0x1B0000.
pub fn fb_parse_multiboot2() -> i64 {
    var mbi_addr: i64 = p_mem_read32(MB_INFO_PTR);
    if mbi_addr == 0 { return -1; }

    var total_size: i64 = mb_read32(mbi_addr);
    var pos: i64 = 8;  // skip header (total_size + reserved)

    while pos < total_size {
        var tag_type: i64 = mb_read32(mbi_addr + pos);
        var tag_size: i64 = mb_read32(mbi_addr + pos + 4);

        if tag_type == 0 { break; }  // end tag

        if tag_type == 8 {
            // Framebuffer tag:
            //   u32 type, u32 size
            //   u64 framebuffer_addr (offset 8)
            //   u32 pitch (offset 16)
            //   u32 width (offset 20)
            //   u32 height (offset 24)
            //   u8 bpp (offset 28)
            //   u8 type (offset 29)
            var fb_addr_lo: i64 = mb_read32(mbi_addr + pos + 8);
            var fb_addr_hi: i64 = mb_read32(mbi_addr + pos + 12);
            var fb_pitch: i64 = mb_read32(mbi_addr + pos + 16);
            var fb_width: i64 = mb_read32(mbi_addr + pos + 20);
            var fb_height: i64 = mb_read32(mbi_addr + pos + 24);
            var fb_bpp: i64 = p_mem_read8(mbi_addr + pos + 28);

            // Store using 32-bit writes (avoid 64-bit codegen issues)
            p_mem_write32(FB_ADDR, fb_addr_lo);
            p_mem_write32(FB_ADDR + 4, fb_addr_hi);
            p_mem_write32(FB_WIDTH, fb_width);
            p_mem_write32(FB_WIDTH + 4, 0);
            p_mem_write32(FB_HEIGHT, fb_height);
            p_mem_write32(FB_HEIGHT + 4, 0);
            p_mem_write32(FB_BPP, fb_bpp);
            p_mem_write32(FB_BPP + 4, 0);
            p_mem_write32(FB_PITCH, fb_pitch);
            p_mem_write32(FB_PITCH + 4, 0);
            return 0;
        }

        // Advance to next tag (8-byte aligned)
        var aligned: i64 = (tag_size + 7) & 0xFFFFFFF8;
        pos = pos + aligned;
        if tag_size == 0 { break; }
    }
    return -1;  // no framebuffer tag found
}

// Initialize framebuffer — parse multiboot2 info for FB parameters
pub fn fb_init() -> i64 {
    // Try to parse multiboot2 framebuffer info
    var result: i64 = fb_parse_multiboot2();
    if result != 0 {
        // No framebuffer — zero out metadata
        p_mem_write32(FB_ADDR, 0);
        p_mem_write32(FB_ADDR + 4, 0);
        p_mem_write32(FB_WIDTH, 0);
        p_mem_write32(FB_WIDTH + 4, 0);
        p_mem_write32(FB_HEIGHT, 0);
        p_mem_write32(FB_HEIGHT + 4, 0);
        p_mem_write32(FB_BPP, 0);
        p_mem_write32(FB_BPP + 4, 0);
        p_mem_write32(FB_PITCH, 0);
        p_mem_write32(FB_PITCH + 4, 0);
    }
    p_mem_write32(FB_CURSOR_X, 0);
    p_mem_write32(FB_CURSOR_X + 4, 0);
    p_mem_write32(FB_CURSOR_Y, 0);
    p_mem_write32(FB_CURSOR_Y + 4, 0);
    // Initialize built-in font
    fb_init_font();
    return result;
}

// Set a single pixel on the framebuffer
pub fn fb_putpixel(x: i64, y: i64, color: i64) {
    var addr: i64 = fb_read64(FB_ADDR);
    var pitch: i64 = fb_read64(FB_PITCH);
    var bpp: i64 = fb_read64(FB_BPP);
    if addr == 0 || bpp == 0 { return; }
    var offset: i64 = y * pitch + x * (bpp / 8);
    p_mem_write32(addr + offset, color);
}

// Fill a rectangle with a solid color
pub fn fb_fillrect(x: i64, y: i64, w: i64, h: i64, color: i64) {
    var i: i64 = 0;
    while i < h {
        var j: i64 = 0;
        while j < w {
            fb_putpixel(x + j, y + i, color);
            j = j + 1;
        }
        i = i + 1;
    }
}

// Clear the framebuffer
pub fn fb_clear_screen() {
    var w: i64 = fb_read64(FB_WIDTH);
    var h: i64 = fb_read64(FB_HEIGHT);
    fb_fillrect(0, 0, w, h, FB_BG_COLOR);
    fb_write64(FB_CURSOR_X, 0);
    fb_write64(FB_CURSOR_Y, 0);
}

// Initialize the built-in 8x16 font.
// We generate a simple font programmatically for basic ASCII characters.
// Each character is 16 bytes, one byte per row, bit 7 = leftmost pixel.
// NOTE: Uses fb_set_4 (5 args) instead of fb_set_char (17 args) to avoid
// PE backend stack corruption with too many function arguments.
pub fn fb_init_font() {
    var i: i64 = 0;
    while i < 96 * 16 {
        p_mem_write8(FB_FONT_ADDR + i, 0);
        i = i + 1;
    }

    // '0' (char 48)
    fb_set_4(FB_FONT_ADDR + 16*16, 0x1C, 0x22, 0x22, 0x22);
    fb_set_4(FB_FONT_ADDR + 16*16 + 4, 0x22, 0x22, 0x22, 0x1C);
    // '1' (char 49)
    fb_set_4(FB_FONT_ADDR + 17*16, 0x08, 0x18, 0x08, 0x08);
    fb_set_4(FB_FONT_ADDR + 17*16 + 4, 0x08, 0x08, 0x08, 0x1C);
    // '2' (char 50)
    fb_set_4(FB_FONT_ADDR + 18*16, 0x1C, 0x22, 0x02, 0x04);
    fb_set_4(FB_FONT_ADDR + 18*16 + 4, 0x08, 0x10, 0x20, 0x3E);
    // '3' (char 51)
    fb_set_4(FB_FONT_ADDR + 19*16, 0x1C, 0x22, 0x02, 0x0C);
    fb_set_4(FB_FONT_ADDR + 19*16 + 4, 0x02, 0x02, 0x22, 0x1C);
    // '4' (char 52)
    fb_set_4(FB_FONT_ADDR + 20*16, 0x04, 0x0C, 0x14, 0x24);
    fb_set_4(FB_FONT_ADDR + 20*16 + 4, 0x3E, 0x04, 0x04, 0x04);
    // '5' (char 53)
    fb_set_4(FB_FONT_ADDR + 21*16, 0x3E, 0x20, 0x20, 0x3C);
    fb_set_4(FB_FONT_ADDR + 21*16 + 4, 0x02, 0x02, 0x22, 0x1C);
    // '6' (char 54)
    fb_set_4(FB_FONT_ADDR + 22*16, 0x0C, 0x10, 0x20, 0x3C);
    fb_set_4(FB_FONT_ADDR + 22*16 + 4, 0x22, 0x22, 0x22, 0x1C);
    // '7' (char 55)
    fb_set_4(FB_FONT_ADDR + 23*16, 0x3E, 0x02, 0x04, 0x08);
    fb_set_4(FB_FONT_ADDR + 23*16 + 4, 0x10, 0x10, 0x10, 0x10);
    // '8' (char 56)
    fb_set_4(FB_FONT_ADDR + 24*16, 0x1C, 0x22, 0x22, 0x1C);
    fb_set_4(FB_FONT_ADDR + 24*16 + 4, 0x22, 0x22, 0x22, 0x1C);
    // '9' (char 57)
    fb_set_4(FB_FONT_ADDR + 25*16, 0x1C, 0x22, 0x22, 0x22);
    fb_set_4(FB_FONT_ADDR + 25*16 + 4, 0x1C, 0x02, 0x04, 0x18);

    // 'A' (char 65) — index 33
    fb_set_4(FB_FONT_ADDR + 33*16, 0x1C, 0x22, 0x22, 0x22);
    fb_set_4(FB_FONT_ADDR + 33*16 + 4, 0x3E, 0x22, 0x22, 0x22);
    // 'B' (char 66)
    fb_set_4(FB_FONT_ADDR + 34*16, 0x3C, 0x22, 0x22, 0x3C);
    fb_set_4(FB_FONT_ADDR + 34*16 + 4, 0x22, 0x22, 0x22, 0x3C);
    // 'C' (char 67)
    fb_set_4(FB_FONT_ADDR + 35*16, 0x1C, 0x22, 0x20, 0x20);
    fb_set_4(FB_FONT_ADDR + 35*16 + 4, 0x20, 0x20, 0x22, 0x1C);
    // 'D' (char 68)
    fb_set_4(FB_FONT_ADDR + 36*16, 0x3C, 0x22, 0x22, 0x22);
    fb_set_4(FB_FONT_ADDR + 36*16 + 4, 0x22, 0x22, 0x22, 0x3C);
    // 'E' (char 69)
    fb_set_4(FB_FONT_ADDR + 37*16, 0x3E, 0x20, 0x20, 0x3C);
    fb_set_4(FB_FONT_ADDR + 37*16 + 4, 0x20, 0x20, 0x20, 0x3E);
    // 'F' (char 70)
    fb_set_4(FB_FONT_ADDR + 38*16, 0x3E, 0x20, 0x20, 0x3C);
    fb_set_4(FB_FONT_ADDR + 38*16 + 4, 0x20, 0x20, 0x20, 0x20);
    // 'G' (char 71)
    fb_set_4(FB_FONT_ADDR + 39*16, 0x1C, 0x22, 0x20, 0x20);
    fb_set_4(FB_FONT_ADDR + 39*16 + 4, 0x2E, 0x22, 0x22, 0x1E);
    // 'H' (char 72)
    fb_set_4(FB_FONT_ADDR + 40*16, 0x22, 0x22, 0x22, 0x3E);
    fb_set_4(FB_FONT_ADDR + 40*16 + 4, 0x22, 0x22, 0x22, 0x22);
    // 'I' (char 73)
    fb_set_4(FB_FONT_ADDR + 41*16, 0x1C, 0x08, 0x08, 0x08);
    fb_set_4(FB_FONT_ADDR + 41*16 + 4, 0x08, 0x08, 0x08, 0x1C);
    // 'J' (char 74)
    fb_set_4(FB_FONT_ADDR + 42*16, 0x0E, 0x04, 0x04, 0x04);
    fb_set_4(FB_FONT_ADDR + 42*16 + 4, 0x04, 0x24, 0x24, 0x18);
    // 'K' (char 75)
    fb_set_4(FB_FONT_ADDR + 43*16, 0x22, 0x24, 0x28, 0x30);
    fb_set_4(FB_FONT_ADDR + 43*16 + 4, 0x28, 0x24, 0x22, 0x22);
    // 'L' (char 76)
    fb_set_4(FB_FONT_ADDR + 44*16, 0x20, 0x20, 0x20, 0x20);
    fb_set_4(FB_FONT_ADDR + 44*16 + 4, 0x20, 0x20, 0x20, 0x3E);
    // 'M' (char 77)
    fb_set_4(FB_FONT_ADDR + 45*16, 0x22, 0x36, 0x2A, 0x2A);
    fb_set_4(FB_FONT_ADDR + 45*16 + 4, 0x22, 0x22, 0x22, 0x22);
    // 'N' (char 78)
    fb_set_4(FB_FONT_ADDR + 46*16, 0x22, 0x22, 0x32, 0x2A);
    fb_set_4(FB_FONT_ADDR + 46*16 + 4, 0x26, 0x22, 0x22, 0x22);
    // 'O' (char 79)
    fb_set_4(FB_FONT_ADDR + 47*16, 0x1C, 0x22, 0x22, 0x22);
    fb_set_4(FB_FONT_ADDR + 47*16 + 4, 0x22, 0x22, 0x22, 0x1C);
    // 'P' (char 80)
    fb_set_4(FB_FONT_ADDR + 48*16, 0x3C, 0x22, 0x22, 0x3C);
    fb_set_4(FB_FONT_ADDR + 48*16 + 4, 0x20, 0x20, 0x20, 0x20);
    // 'Q' (char 81)
    fb_set_4(FB_FONT_ADDR + 49*16, 0x1C, 0x22, 0x22, 0x22);
    fb_set_4(FB_FONT_ADDR + 49*16 + 4, 0x22, 0x2A, 0x24, 0x1A);
    // 'R' (char 82)
    fb_set_4(FB_FONT_ADDR + 50*16, 0x3C, 0x22, 0x22, 0x3C);
    fb_set_4(FB_FONT_ADDR + 50*16 + 4, 0x28, 0x24, 0x22, 0x22);
    // 'S' (char 83)
    fb_set_4(FB_FONT_ADDR + 51*16, 0x1C, 0x22, 0x20, 0x1C);
    fb_set_4(FB_FONT_ADDR + 51*16 + 4, 0x02, 0x02, 0x22, 0x1C);
    // 'T' (char 84)
    fb_set_4(FB_FONT_ADDR + 52*16, 0x3E, 0x08, 0x08, 0x08);
    fb_set_4(FB_FONT_ADDR + 52*16 + 4, 0x08, 0x08, 0x08, 0x08);
    // 'U' (char 85)
    fb_set_4(FB_FONT_ADDR + 53*16, 0x22, 0x22, 0x22, 0x22);
    fb_set_4(FB_FONT_ADDR + 53*16 + 4, 0x22, 0x22, 0x22, 0x1C);
    // 'V' (char 86)
    fb_set_4(FB_FONT_ADDR + 54*16, 0x22, 0x22, 0x22, 0x22);
    fb_set_4(FB_FONT_ADDR + 54*16 + 4, 0x22, 0x22, 0x14, 0x08);
    // 'W' (char 87)
    fb_set_4(FB_FONT_ADDR + 55*16, 0x22, 0x22, 0x22, 0x2A);
    fb_set_4(FB_FONT_ADDR + 55*16 + 4, 0x2A, 0x2A, 0x36, 0x22);
    // 'X' (char 88)
    fb_set_4(FB_FONT_ADDR + 56*16, 0x22, 0x22, 0x14, 0x08);
    fb_set_4(FB_FONT_ADDR + 56*16 + 4, 0x08, 0x14, 0x22, 0x22);
    // 'Y' (char 89)
    fb_set_4(FB_FONT_ADDR + 57*16, 0x22, 0x22, 0x22, 0x14);
    fb_set_4(FB_FONT_ADDR + 57*16 + 4, 0x08, 0x08, 0x08, 0x08);
    // 'Z' (char 90)
    fb_set_4(FB_FONT_ADDR + 58*16, 0x3E, 0x02, 0x04, 0x08);
    fb_set_4(FB_FONT_ADDR + 58*16 + 4, 0x10, 0x20, 0x20, 0x3E);

    // ':' (char 58) — index 26
    fb_set_4(FB_FONT_ADDR + 26*16, 0, 0, 0x18, 0x18);
    fb_set_4(FB_FONT_ADDR + 26*16 + 4, 0, 0, 0x18, 0x18);
    // '.' (char 46) — index 14
    fb_set_4(FB_FONT_ADDR + 14*16, 0, 0, 0, 0);
    fb_set_4(FB_FONT_ADDR + 14*16 + 4, 0, 0, 0x18, 0x18);
    // ',' (char 44) — index 12
    fb_set_4(FB_FONT_ADDR + 12*16, 0, 0, 0, 0);
    fb_set_4(FB_FONT_ADDR + 12*16 + 4, 0, 0x18, 0x18, 0x10);
    // '-' (char 45) — index 13
    fb_set_4(FB_FONT_ADDR + 13*16, 0, 0, 0, 0);
    fb_set_4(FB_FONT_ADDR + 13*16 + 4, 0x3E, 0, 0, 0);
    // '/' (char 47) — index 15
    fb_set_4(FB_FONT_ADDR + 15*16, 0x02, 0x04, 0x08, 0x10);
    fb_set_4(FB_FONT_ADDR + 15*16 + 4, 0x20, 0x10, 0x08, 0x04);
    // '!' (char 33) — index 1
    fb_set_4(FB_FONT_ADDR + 1*16, 0x08, 0x08, 0x08, 0x08);
    fb_set_4(FB_FONT_ADDR + 1*16 + 4, 0x08, 0x08, 0, 0x08);
    // '?' (char 63) — index 31
    fb_set_4(FB_FONT_ADDR + 31*16, 0x1C, 0x22, 0x02, 0x04);
    fb_set_4(FB_FONT_ADDR + 31*16 + 4, 0x08, 0x08, 0, 0x08);
    // '<' (char 60) — index 28
    fb_set_4(FB_FONT_ADDR + 28*16, 0x04, 0x08, 0x10, 0x20);
    fb_set_4(FB_FONT_ADDR + 28*16 + 4, 0x10, 0x08, 0x04, 0);
    // '>' (char 62) — index 30
    fb_set_4(FB_FONT_ADDR + 30*16, 0x20, 0x10, 0x08, 0x04);
    fb_set_4(FB_FONT_ADDR + 30*16 + 4, 0x08, 0x10, 0x20, 0);
    // '(' (char 40) — index 8
    fb_set_4(FB_FONT_ADDR + 8*16, 0x08, 0x10, 0x10, 0x10);
    fb_set_4(FB_FONT_ADDR + 8*16 + 4, 0x10, 0x10, 0x10, 0x08);
    // ')' (char 41) — index 9
    fb_set_4(FB_FONT_ADDR + 9*16, 0x10, 0x08, 0x08, 0x08);
    fb_set_4(FB_FONT_ADDR + 9*16 + 4, 0x08, 0x08, 0x08, 0x10);
    // '+' (char 43) — index 11
    fb_set_4(FB_FONT_ADDR + 11*16, 0, 0, 0x08, 0x08);
    fb_set_4(FB_FONT_ADDR + 11*16 + 4, 0x3E, 0x08, 0x08, 0);
    // '=' (char 61) — index 29
    fb_set_4(FB_FONT_ADDR + 29*16, 0, 0, 0, 0x3E);
    fb_set_4(FB_FONT_ADDR + 29*16 + 4, 0, 0, 0x3E, 0);
    // '*' (char 42) — index 10
    fb_set_4(FB_FONT_ADDR + 10*16, 0, 0, 0x22, 0x14);
    fb_set_4(FB_FONT_ADDR + 10*16 + 4, 0x3E, 0x14, 0x22, 0);
    // '#' (char 35) — index 3
    fb_set_4(FB_FONT_ADDR + 3*16, 0x14, 0x14, 0x3E, 0x14);
    fb_set_4(FB_FONT_ADDR + 3*16 + 4, 0x3E, 0x14, 0x14, 0);
    // '@' (char 64) — index 32
    fb_set_4(FB_FONT_ADDR + 32*16, 0x1C, 0x22, 0x2A, 0x2A);
    fb_set_4(FB_FONT_ADDR + 32*16 + 4, 0x2A, 0x20, 0x22, 0x1C);
    // '_' (char 95) — index 63
    fb_set_4(FB_FONT_ADDR + 63*16, 0, 0, 0, 0);
    fb_set_4(FB_FONT_ADDR + 63*16 + 4, 0, 0, 0x3E, 0);

    // Lowercase letters (copy from uppercase)
    var c: i64 = 97;
    while c <= 122 {
        var dst: i64 = FB_FONT_ADDR + (c - 32) * 16;
        var upper: i64 = FB_FONT_ADDR + (c - 97 + 65 - 32) * 16;
        var k: i64 = 0;
        while k < 16 {
            p_mem_write8(dst + k, p_mem_read8(upper + k));
            k = k + 1;
        }
        c = c + 1;
    }
}

// Write 4 bytes to font data at offset (5 args — safe for PE backend)
fn fb_set_4(off: i64, r0: i64, r1: i64, r2: i64, r3: i64) {
    p_mem_write8(off, r0);
    p_mem_write8(off + 1, r1);
    p_mem_write8(off + 2, r2);
    p_mem_write8(off + 3, r3);
}

// Render a single character at pixel position (x, y)
pub fn fb_draw_char(x: i64, y: i64, c: i64, fg: i64, bg: i64) {
    if c < 32 || c > 127 { c = 32; }
    var font_off: i64 = FB_FONT_ADDR + (c - 32) * 16;
    var row: i64 = 0;
    while row < 16 {
        var bits: i64 = p_mem_read8(font_off + row);
        var col: i64 = 0;
        while col < 8 {
            var pixel_color: i64 = bg;
            if (bits & (0x80 >> col)) != 0 {
                pixel_color = fg;
            }
            fb_putpixel(x + col, y + row, pixel_color);
            col = col + 1;
        }
        row = row + 1;
    }
}

// Scroll the framebuffer up by one text line (16 pixels)
pub fn fb_scroll() {
    var addr: i64 = fb_read64(FB_ADDR);
    var pitch: i64 = fb_read64(FB_PITCH);
    var w: i64 = fb_read64(FB_WIDTH);
    var h: i64 = fb_read64(FB_HEIGHT);
    if addr == 0 || w == 0 || h == 0 { return; }
    var bpp: i64 = fb_read64(FB_BPP);
    var bytes_per_pixel: i64 = bpp / 8;

    // Copy pixels from y+16 to y
    var y: i64 = 0;
    while y < h - 16 {
        var x: i64 = 0;
        while x < w {
            var src_off: i64 = (y + 16) * pitch + x * bytes_per_pixel;
            var dst_off: i64 = y * pitch + x * bytes_per_pixel;
            var pixel: i64 = p_mem_read32(addr + src_off);
            p_mem_write32(addr + dst_off, pixel);
            x = x + 1;
        }
        y = y + 1;
    }
    // Clear bottom 16 rows
    fb_fillrect(0, h - 16, w, 16, FB_BG_COLOR);
}

// Print a character to the framebuffer console
pub fn fb_putc(c: i64) {
    var addr: i64 = fb_read64(FB_ADDR);
    if addr == 0 { return; }
    var w: i64 = fb_read64(FB_WIDTH);
    var h: i64 = fb_read64(FB_HEIGHT);
    var cx: i64 = fb_read64(FB_CURSOR_X);
    var cy: i64 = fb_read64(FB_CURSOR_Y);

    if c == 10 {  // newline
        cx = 0;
        cy = cy + FB_FONT_HEIGHT;
        if cy + FB_FONT_HEIGHT > h {
            fb_scroll();
            cy = h - FB_FONT_HEIGHT;
        }
        fb_write64(FB_CURSOR_X, cx);
        fb_write64(FB_CURSOR_Y, cy);
        return;
    }

    fb_draw_char(cx, cy, c, FB_FG_COLOR, FB_BG_COLOR);
    cx = cx + FB_FONT_WIDTH;
    if cx + FB_FONT_WIDTH > w {
        cx = 0;
        cy = cy + FB_FONT_HEIGHT;
        if cy + FB_FONT_HEIGHT > h {
            fb_scroll();
            cy = h - FB_FONT_HEIGHT;
        }
    }
    fb_write64(FB_CURSOR_X, cx);
    fb_write64(FB_CURSOR_Y, cy);
}

// Print a string from a memory buffer to the framebuffer
pub fn fb_print(buf: i64, len: i64) {
    var i: i64 = 0;
    while i < len {
        fb_putc(p_mem_read8(buf + i));
        i = i + 1;
    }
}

// Clear the framebuffer console
pub fn fb_clear() {
    fb_clear_screen();
}

// Set framebuffer info (called from multiboot2 parsing if available)
pub fn fb_set_info(addr: i64, width: i64, height: i64, bpp: i64, pitch: i64) {
    fb_write64(FB_ADDR, addr);
    fb_write64(FB_WIDTH, width);
    fb_write64(FB_HEIGHT, height);
    fb_write64(FB_BPP, bpp);
    fb_write64(FB_PITCH, pitch);
    fb_write64(FB_CURSOR_X, 0);
    fb_write64(FB_CURSOR_Y, 0);
}

// Framebuffer info command
pub fn cmd_fb() -> void {
    con_putc(10);
    // "FB: "
    con_putc(70); con_putc(66); con_putc(58); con_putc(32);
    var addr: i64 = fb_read64(FB_ADDR);
    if addr == 0 {
        con_putc(78); con_putc(111); con_putc(110); con_putc(101); // "None"
    } else {
        con_putc(97); con_putc(100); con_putc(100); con_putc(114); con_putc(58); // "addr:"
        con_putc(32);
        print_hex(addr);
        con_putc(32);
        con_putc(119); con_putc(120); con_putc(104); // "wxh"
        con_putc(58);
        con_putc(32);
        print_dec(fb_read64(FB_WIDTH));
        con_putc(120);
        print_dec(fb_read64(FB_HEIGHT));
        con_putc(32);
        con_putc(98); con_putc(112); con_putc(112); con_putc(58); // "bpp:"
        con_putc(32);
        print_dec(fb_read64(FB_BPP));
    }
    con_putc(10);
}
